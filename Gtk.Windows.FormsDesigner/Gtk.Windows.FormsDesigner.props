<Project>
	<!-- Relative to this file, so the same copy works from build\ (a direct reference) and from
	     buildTransitive\ (a reference inherited from Gtk.Windows.Forms.Base). -->
	<UsingTask TaskName="Gtk.Windows.FormsDesigner.GtkWindowsForms"
	           AssemblyFile="$(MSBuildThisFileDirectory)..\lib\netstandard2.0\Gtk.Windows.FormsDesigner.dll" />
</Project>
