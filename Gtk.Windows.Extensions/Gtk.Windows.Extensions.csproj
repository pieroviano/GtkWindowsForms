<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.props" Condition="Exists('$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.props')" />
    <PropertyGroup>
        <DocumentationFile>$(MSBuildProjectDirectory)\$(MSBuildProjectName).xml</DocumentationFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <TargetFramework>netstandard2.0</TargetFramework>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <RepositoryUrl>https://bitbucket.org/piero-viano/net4x.gtk.windows.forms</RepositoryUrl>
        <PackAsTool>False</PackAsTool>
        <SignAssembly>true</SignAssembly>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- 'enable', like the sibling libraries: 'annotations' published nullable annotations to
             consumers without null-checking the source that produces them. -->
        <Nullable>enable</Nullable>
        <Authors>Piero Viano</Authors>
        <Company>Piero Viano</Company>
        <Copyright>Copyright (c) Piero Viano. All right reserved.</Copyright>
        <Title>Extensions to the Gtk.Windows.Forms API that real WinForms does not have</Title>
        <Description>Companion package of Gtk.Windows.Forms. Additions to the System.Windows.Forms surface that are deliberately not part of the real WinForms API, kept out of the core library so it stays a faithful compatibility layer. Ships AutoClosingMessageBox, a message box that dismisses itself after a timeout - install it with AutoClosingMessageBox.Install(timeout). Also the place to add your own extension classes over the Forms library.</Description>
        <PackageProjectUrl>https://bitbucket.org/piero-viano/net4x.gtk.windows.forms</PackageProjectUrl>
        <!-- Same licence file the other packages ship: the one the vendored upstream submodule
             carries. Declaring none let Net4x.NuGetUtility's Apache-2.0 default decide by accident. -->
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <RootNamespace />
        <PackageOutputPath>$(SolutionDir)Packages/</PackageOutputPath>
        <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
        <AssemblyOriginatorKeyFile>..\GtkForms.snk</AssemblyOriginatorKeyFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <NoWarn>$(NoWarn);NU5118</NoWarn>
        <PackageId>Gtk.Windows.Extensions</PackageId>
        <!-- Additions to the System.Windows.Forms surface that are not part of the real WinForms API
             (e.g. AutoClosingMessageBox). Every developer can add further extension classes here. -->
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="Resources\**" />
        <Compile Remove="System.Windows.Forms\**" />
        <EmbeddedResource Remove="Resources\**" />
        <EmbeddedResource Remove="System.Windows.Forms\**" />
        <None Remove="Resources\**" />
        <None Remove="System.Windows.Forms\**" />
    </ItemGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Gtk.Windows.Forms.Tests, </_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Net4x.NuGetUtility" Version="$(NuGetUtilityVersion)" PrivateAssets="All" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Gtk.Windows.Forms\Gtk.Windows.Forms.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="README.md" Link="README.md" Pack="true" PackagePath="\README.md" />
        <None Include="..\gtksystem-windows-forms\Source\licenses\LICENSE.txt" Pack="true" PackagePath="\" />
    </ItemGroup>
    <Import Project="$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.targets" Condition="Exists('$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.targets')" />
</Project>