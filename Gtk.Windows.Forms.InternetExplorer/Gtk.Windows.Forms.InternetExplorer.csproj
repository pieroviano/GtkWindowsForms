<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <DocumentationFile>$(MSBuildProjectDirectory)\$(MSBuildProjectName).xml</DocumentationFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <!--
          Not netstandard2.0, unlike the base library: hosting the Internet Explorer WebBrowser ActiveX
          control is COM interop that only exists on Windows. net462 covers .NET Framework consumers and
          net8.0-windows covers modern ones.
        -->
        <TargetFrameworks>net462;net8.0-windows</TargetFrameworks>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <RepositoryUrl>https://bitbucket.org/piero-viano/net4x.gtk.windows.forms</RepositoryUrl>
        <PackAsTool>False</PackAsTool>
        <SignAssembly>true</SignAssembly>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Authors>Piero Viano</Authors>
        <Company>Piero Viano</Company>
        <Copyright>Copyright (c) Piero Viano. All right reserved.</Copyright>
        <Title>Internet Explorer (Trident) backend for the Gtk.Windows.Forms WebBrowser control</Title>
        <Description>Companion package of Gtk.Windows.Forms. Gives System.Windows.Forms.WebBrowser the legacy Internet Explorer (Trident) engine on Windows by hosting the SHDocVw WebBrowser ActiveX control. It registers below the WebView2 backend, so WebView2 is still preferred when installed and this is the fallback before WebKitGTK. Referencing the package is the whole opt-in - a module initializer registers the backend. Note the airspace limitation: GTK 4 gives only toplevel windows an HWND, so the browser is a child window painted above all GTK content in that window and is not clipped by overlapping widgets, popovers or menus. Internet Explorer is end of life; use this only for legacy intranet content that requires Trident.</Description>
        <PackageProjectUrl>https://pieroviano.github.io/GtkWindowsForms/</PackageProjectUrl>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <RootNamespace />
        <PackageOutputPath>$(SolutionDir)Packages/</PackageOutputPath>
        <AssemblyOriginatorKeyFile>..\GtkForms.snk</AssemblyOriginatorKeyFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <NoWarn>$(NoWarn);NU5118;CS8002;CA2255</NoWarn>
        <PackageId>Gtk.Windows.Forms.InternetExplorer</PackageId>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Gtk.Windows.Forms.InternetExplorer.Tests, </_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Net4x.CleanCache" Version="1.0.0" PrivateAssets="All" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
        <!-- 'dynamic' late binding of IWebBrowser2 needs the C# runtime binder; on .NET Framework it is a
             separate framework assembly, not referenced by default. Modern targets carry it in the runtime. -->
        <Reference Include="Microsoft.CSharp" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Gtk.Windows.Forms\Gtk.Windows.Forms.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="README.md" Link="README.md" Pack="true" PackagePath="\README.md" />
        <None Include="..\gtksystem-windows-forms\Source\licenses\LICENSE.txt" Pack="true" PackagePath="\" />
        <None Include="..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
