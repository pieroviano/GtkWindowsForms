        <DocumentationFile>$(MSBuildProjectDirectory)\$(MSBuildProjectName).xml</DocumentationFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TargetFrameworks>netstandard2.0</TargetFrameworks>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Authors>Piero Viano</Authors>
        <Company>Piero Viano</Company>
        <Copyright>Copyright (c) Piero Viano. All right reserved.</Copyright>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <PackageProjectUrl>https://bitbucket.org/piero-viano/net4x.gtk.windows.forms</PackageProjectUrl>
        <PackageReleaseNotes>C# interface cross-platform development component gtk-windows-forms</PackageReleaseNotes>
        <Title>GTK cross-platform winform interface component, compiled once, can run on windows, linux, macos platforms</Title>
        <Description>
      It is a cross-platform interface component developed based on GTK components and compatible with the native C# control winform interface.
      Use this component GtkSystem.Drawing to compile once and run across platforms windows/linux/macos.
      Update platform:
      https://pieroviano@bitbucket.org/piero-viano/net4x.gtk.windows.forms.git

      Based on GTKSystem.Windows.Forms:
      https://www.gtkapp.com；
      https://gitee.com/easywebfactory/gtksystem-windows-forms；
      https://github.com/easywebfactory/gtksystem-windows-forms；
    </Description>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://bitbucket.org/piero-viano/net4x.gtk.windows.forms</RepositoryUrl>
        <PackAsTool>False</PackAsTool>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <SignAssembly>true</SignAssembly>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace />
        <PackageOutputPath>$(SolutionDir)Packages/</PackageOutputPath>
        <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
        <AssemblyOriginatorKeyFile>..\GtkForms.snk</AssemblyOriginatorKeyFile>
        <NoWarn>$(NoWarn);CS0067;CS0169;CS0419;CS0436;CS0162;CS0168;CS0414;CS0612;CS0618;CS0649;CS1574;CS3021;CS8002</NoWarn>
    </PropertyGroup>
    <ItemGroup>
