    </ItemGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Gtk.Windows.Forms.Tests, </_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Gtk.Windows.Extensions, </_Parameter1>
        </AssemblyAttribute>
        <!-- The Windows WebView2 backend is a companion package because Microsoft.Web.WebView2 ships no
             netstandard2.0 assets and would otherwise land on every Linux and macOS consumer. It is
             still a backend of this library, so it needs the same DOM bridge script, JavaScript quoting
             and JSON reader the WebKitGTK backend uses. Duplicating the injected script into a second
             package would be two copies to keep in step, which is worse than this grant. -->
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Gtk.Windows.Forms.WebView2, </_Parameter1>
        </AssemblyAttribute>
        <!-- The Internet Explorer (Trident) backend is a companion package for the same reason as the
             WebView2 one: its COM hosting is Windows-only and would otherwise burden every Linux and macOS
             consumer. It drives the same injected DOM bridge script, so it needs the same internal
             JavaScript quoting and JSON reader rather than a second copy to keep in step. -->
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Gtk.Windows.Forms.InternetExplorer, </_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
