<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS0067;CS0169;CS0419;CS0536;NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Drawing" />
    <Using Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gtk.Windows.FormsDesigner is NOT listed here: a PackageReference declared in a package's
         build props is invisible to a consumer's restore, and when a restore does pick it up it
         collides with the nuspec dependency (NU1504). It reaches a consumer as a dependency of
         this package, with its Build assets flowing, so its design-time targets are imported. -->
    <PackageReference Include="Gtk.Resources.Extensions" Version="1.4.2464.*" PrivateAssets="all" />
    <PackageReference Include="Gtk.Windows.FormsDesigner" Version="1.4.2464.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Condition="'$(ExcludeResources)'==''"
             Include="$(MSBuildThisFileDirectory)../content/System.ComponentModel.cs"
             Link="System.ComponentModel.cs" />
    <Compile Condition="'$(ExcludeResources)'==''"
             Include="$(MSBuildThisFileDirectory)../content/System.Resources.ResourceManager.cs"
             Link="System.Resources.ResourceManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="**\*.resx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
    </EmbeddedResource>

    <Content Include="Resources\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\Resources\</PackagePath>
    </Content>
  </ItemGroup>
</Project>