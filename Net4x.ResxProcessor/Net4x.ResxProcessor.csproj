<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<DocumentationFile>$(MSBuildProjectDirectory)\$(MSBuildProjectName).xml</DocumentationFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>..\GtkForms.snk</AssemblyOriginatorKeyFile>
		<Version>$(VersionPrefix).$(VersionSuffix)</Version>
	</PropertyGroup>
	<ItemGroup>
		<None Include="$(MSBuildProjectName).xml" Pack="true" PackagePath="\Documentation.xml" />
	</ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Net4x.ResxProcessor.Tests, </_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
