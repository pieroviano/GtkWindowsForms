<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DocumentationFile>$(MSBuildProjectDirectory)\System.Resources.Extensions.xml</DocumentationFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <AssemblyName>System.Resources.Extensions</AssemblyName>
    <!-- Displacement sentinel. MSBuild's conflict resolution keeps the HIGHEST AssemblyVersion for a
         given simple name, so with the package version (1.3.24.x) this assembly lost to Microsoft's
         System.Resources.Extensions (4.0.0.0) and every consuming app got Microsoft's copy - the
         displacement this project exists for silently did not happen. 99.0.0.0 is deliberately far
         above anything Microsoft is likely to ship, and only the assembly identity is affected: the
         NuGet package still versions as $(VersionPrefix).$(VersionSuffix) above. -->
    <AssemblyVersion>99.0.0.0</AssemblyVersion>
    <FileVersion>99.0.0.0</FileVersion>
    <!-- The project "Gtk.Resources.Extensions" generates an **intentionally empty** assembly whose `AssemblyName`
         *is* `System.Resources.Extensions`, so that it displaces Microsoft's assembly of that name in an
         application's output folder. It carries no code and is not meant to: the working implementation lives
         in the Forms library under `GTKSystem/Resources/Extensions/`, in namespace
         `GtkSystem.Resources.Extensions`, so nothing needs the displaced types. The sample apps reference the
         project for that reason. (See README.md, which ships in the package, for the consumer-facing version.
         Note that displacement only takes effect if this assembly wins MSBuild's conflict resolution against
         the `System.Resources.Extensions` NuGet package) -->
    <PackageId>Gtk.Resources.Extensions</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Piero Viano</Authors>
    <Company>Piero Viano</Company>
    <Copyright>Copyright (c) Piero Viano. All right reserved.</Copyright>
    <!-- Without this the SDK reads $(VersionSuffix) as a prerelease label and packs 1.3.24-26204. -->
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <Title>Empty System.Resources.Extensions that displaces Microsoft's for Gtk.Windows.Forms</Title>
    <Description>Companion package of Gtk.Windows.Forms. Ships an intentionally empty assembly named System.Resources.Extensions so that it displaces Microsoft's BinaryFormatter-based assembly of that name in an application's output folder; the ResX reader Gtk.Windows.Forms actually uses lives in that library, under GtkSystem.Resources.Extensions. See README.md.</Description>
    <PackageProjectUrl>https://bitbucket.org/piero-viano/net4x.gtk.windows.forms</PackageProjectUrl>
    <RepositoryUrl>https://bitbucket.org/piero-viano/net4x.gtk.windows.forms</RepositoryUrl>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackAsTool>False</PackAsTool>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>$(SolutionDir)Packages/</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\gtksystem-windows-forms\Source\licenses\LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>