<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<NoWarn>CA1416;IDE0055</NoWarn>
	</PropertyGroup>

	<!-- 'build\' holds the generated BASE/THEIRS trees this tool produces at runtime. It sits inside the
	     project folder so the conflict pause can print short, stable paths - but it must never be fed to
	     the SDK's default globs, or the tool fails to compile against its own output. -->
	<ItemGroup>
		<Compile Remove="build\**;build-selfcheck\**" />
		<None Remove="build\**;build-selfcheck\**" />
		<EmbeddedResource Remove="build\**;build-selfcheck\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Align.Common\Align.Common.csproj" />
		<ProjectReference Include="..\Prepare.Common\Prepare.Common.csproj" />
		<ProjectReference Include="..\XmlDocSync\XmlDocSync.csproj" />
		<!-- For TransformPipeline.RunTransform (shared transform f). PrepareProjects is an Exe; referenced for its types. -->
		<ProjectReference Include="..\PrepareProjects\PrepareProjects.csproj" />
	</ItemGroup>

</Project>
