<Project>
	<Target Name="BeforeCompile" BeforeTargets="Build">
		<Message Text="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)" Importance="high" />
		<GtkWindowsForms ObjPath="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)" 
		                 FileName="$(MSBuildProjectName)" TargetFramework="$(TargetFramework)" 
		                 TargetFrameworkVersion="$(TargetFrameworkVersion)" />
	</Target>
</Project>
