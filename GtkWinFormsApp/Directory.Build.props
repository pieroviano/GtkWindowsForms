<Project>
	<!-- Upstream added this file; without chaining to the repo root, MSBuild stops walking up here and
	     Directory.Nuget.Props (which defines GtkSharpLatestVersion and the package pins) is never
	     imported - the GtkSharp PackageReference then resolves to the invalid version '.*'. -->
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
	<PropertyGroup>
		<BaseIntermediateOutputPath>obj\$(MSBuildProjectName)</BaseIntermediateOutputPath>
		<IntermediateOutputPath>$(BaseIntermediateOutputPath)\$(TargetFramework)</IntermediateOutputPath>
	</PropertyGroup>
	<ItemGroup Condition="('$(ImplicitUsings)' == 'true' or '$(ImplicitUsings)' == 'enable')">
		<Using Include="System" />
		<Using Include="System.Collections.Generic" />
		<Using Include="System.Drawing" />
		<Using Include="System.IO" />
		<Using Include="System.Linq" />
		<Using Include="System.Threading" />
		<Using Include="System.Threading.Tasks" />
		<Using Include="System.Windows.Forms" />
	</ItemGroup>
</Project>
