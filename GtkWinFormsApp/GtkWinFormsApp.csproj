  <ItemGroup>
    <EmbeddedResource Update="**\*.resx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Resources\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Gtk.Windows.Forms\Content\System.ComponentModel.cs" Link="System.ComponentModel.cs" />
    <Compile Include="..\Gtk.Windows.Forms\Content\System.Resources.ResourceManager.cs" Link="System.Resources.ResourceManager.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gtk.Windows.Forms\Gtk.Windows.Forms.csproj" />
    <ProjectReference Include="..\Gtk.Resources.Extensions\Gtk.Resources.Extensions.csproj" />
    <!-- Build-order only: the PrepareBuild target below execs ResxProcessor.exe, so ResxProcessor
         must build first. Not referenced at runtime (ReferenceOutputAssembly/Private false). -->
    <ProjectReference Include="..\ResxProcessor\ResxProcessor.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <Target Name="PrepareBuild" BeforeTargets="BeforeBuild">
    <!-- BeforeBuild runs before project references are built, so ensure the ResxProcessor tool
         exists (no-op when the solution already built it first via the ProjectReference above).
         Invoked as 'dotnet <dll>' with forward slashes so it runs on Windows, Linux and macOS
         (the net8.0 apphost is ResxProcessor.exe on Windows but has no extension elsewhere). -->
    <Exec Command="dotnet run --no-build --project &quot;$(MSBuildThisFileDirectory)../ResxProcessor/ResxProcessor.csproj&quot; &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>
  <ItemGroup>
    <Compile Update="Properties\GtkWinFormsAppResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>GtkWinFormsAppResources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\GtkWinFormsAppResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>GtkWinFormsAppResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\GtkWinFormsAppResources.zh-Hans.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <DependentUpon>GtkWinFormsAppResources.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\TestData1.en.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\TestData1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
