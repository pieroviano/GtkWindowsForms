[setup]
/* Whether to follow the system theme by default */
AutoTheme=true
/* Whether to apply the built-in styles */
UseDefaultStyle=true
/* Specify the theme; effective when AutoTheme=false */
DefaultThemeName=Windows-10
/* Whether to use a custom theme; corresponds to [custom theme] */
UseCustomTheme=false
/* Whether to use a custom style; corresponds to [custom style] */
UseCustomStyle=true

[custom theme]
/* Custom theme name */
Name=Windows-10
/* Folder containing the theme files; GTK_DATA_PREFIX=/mnt/d/GTK/GTKSystemWindowsForms-All/Samples/GTKWinFormsApp/bin/Debug/net8.0/theme */
ThemeFolder=theme
/* Theme CSS reference file path (relative) */
ThemeCssPath=theme/windows10.css

[custom style]
/* Freely defined style file */
StylePath=style.css
