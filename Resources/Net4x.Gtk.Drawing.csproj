<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.props" Condition="Exists('$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.props')" />
	<PropertyGroup>
		<DocumentationFile>$(MSBuildProjectDirectory)\$(MSBuildProjectName).xml</DocumentationFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TargetFramework>netstandard2.0</TargetFramework>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Authors>Piero Viano</Authors>
		<Company>Piero Viano</Company>
		<Copyright>Copyright (c) Piero Viano. All right reserved.</Copyright>
		<Version>$(VersionPrefix).$(VersionSuffix)</Version>
		<PackageProjectUrl>https://bitbucket.org/piero-viano/net4x.gtk.windows.forms</PackageProjectUrl>
		<PackageReleaseNotes>C# interface cross-platform development component gtk-windows-forms</PackageReleaseNotes>
		<Title>GTK cross-platform drawing interface component, compiled once, can run on windows, linux, macos platforms</Title>
		<Description>
			It is a cross-platform interface component developed based on GTK components and compatible with the native C# control winform interface.
			Use this component GtkSystem.Drawing to compile once and run across platforms windows/linux/macos.
			Update platform:
			https://pieroviano@bitbucket.org/piero-viano/net4x.gtk.windows.forms.git

			Based on GTKSystem.Windows.Forms:
			https://www.gtkapp.com；
			https://gitee.com/easywebfactory/gtksystem-windows-forms；
			https://github.com/easywebfactory/gtksystem-windows-forms；
		</Description>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://bitbucket.org/piero-viano/net4x.gtk.windows.forms</RepositoryUrl>
		<PackAsTool>False</PackAsTool>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<SignAssembly>true</SignAssembly>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>annotations</Nullable>
		<RootNamespace />
		<PackageOutputPath>$(SolutionDir)Packages/</PackageOutputPath>
		<EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
		<AssemblyOriginatorKeyFile>..\GtkForms.snk</AssemblyOriginatorKeyFile>
		<NoWarn>$(NoWarn);CS0067;CS0169;CS0419;CS0436;CS0414;CS3021;CS8002</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="..\Net4x.Gtk.Windows.Forms\System\Diagnostics\CodeAnalysis\NotNullWhenAttribute.cs" Link="System\Diagnostics\CodeAnalysis\NotNullWhenAttribute.cs" />
	</ItemGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Net4x.Gtk.Windows.Forms, </_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	<ItemGroup>
		<None Include="$(MSBuildProjectName).xml" Pack="true" PackagePath="\Documentation.xml" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Brutal.Dev.StrongNameSigner" Version="3.6.4" />
		<PackageReference Include="System.Memory" Version="4.6.0" />
		<PackageReference Include="GtkSharp" Version="$(GtkSharpLatestVersion)" />
		<PackageReference Include="System.Resources.Extensions" Version="$(Net4xGtkWindowsFormsVersion).*" />
		<PackageReference Include="Net4x.NuGetUtility" Version="$(NuGetUtilityVersion)" PrivateAssets="All" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\gtksystem-windows-forms\Source\licenses\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<Import Project="$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.targets" Condition="Exists('$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.targets')" />
</Project>