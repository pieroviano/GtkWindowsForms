<Project>
	<Target Name="PrepareBuild" BeforeTargets="BeforeBuild">
		<Message Importance="High" Text='&quot;$(MSBuildThisFileDirectory)..\tools\Net4x.XUnit.Copy.exe&quot; $(TargetFramework) &quot;$(TargetDir)&quot; &quot;$(MSBuildProjectFullPath)&quot;' />
		<Exec Command='&quot;$(MSBuildThisFileDirectory)..\tools\Net4x.ResxProcessor.exe&quot; &quot;$(MSBuildProjectDirectory)&quot;' />	
	</Target>
</Project>