diff --git a/Net4x.Gtk.Windows.Forms.Tests/System/Windows/Forms/DesignTimeHelpersFunctionalTests.cs b/Net4x.Gtk.Windows.Forms.Tests/System/Windows/Forms/DesignTimeHelpersFunctionalTests.cs
