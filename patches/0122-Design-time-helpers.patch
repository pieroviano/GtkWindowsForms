+++ b/Net4x.Gtk.Windows.Forms.Tests/System/Windows/Forms/DesignTimeHelpersFunctionalTests.cs
@@ -0,0 +1,59 @@
+using System.ComponentModel;
+using System.ComponentModel.Design.Serialization;
+using System.Windows.Forms;
+
+namespace Net4x.Gtk.Windows.Forms.Tests.System.Windows.Forms;
+
+/// <summary>
+/// Tests for the three remaining minor helpers that were the last non-non-goal gaps:
+/// <see cref="DataGridViewColumnDesignTimeVisibleAttribute"/>, <see cref="DataGridViewCellStyleConverter"/>
+/// and <see cref="ToolStripDropDownItemAccessibleObject"/>. They do not break ordinary application code but
+/// close the type surface a designer or custom column/converter reference needs.
+/// </summary>
+[Collection("NonParallelCollection")]
+public class DesignTimeHelpersFunctionalTests
+{
+    static DesignTimeHelpersFunctionalTests()
+    {
+        using var _ = new Form();
+    }
+
+    [Fact]
+    public void ColumnDesignTimeVisibleAttribute_HasTheStandardInstances()
+    {
+        Assert.True(DataGridViewColumnDesignTimeVisibleAttribute.Yes.Visible);
+        Assert.False(DataGridViewColumnDesignTimeVisibleAttribute.No.Visible);
+        Assert.Same(DataGridViewColumnDesignTimeVisibleAttribute.Yes, DataGridViewColumnDesignTimeVisibleAttribute.Default);
+
+        Assert.False(new DataGridViewColumnDesignTimeVisibleAttribute(false).Visible);
+        Assert.True(new DataGridViewColumnDesignTimeVisibleAttribute().Visible);
+        Assert.Equal(DataGridViewColumnDesignTimeVisibleAttribute.No, new DataGridViewColumnDesignTimeVisibleAttribute(false));
+        Assert.True(DataGridViewColumnDesignTimeVisibleAttribute.Yes.IsDefaultAttribute());
+    }
+
+    [Fact]
+    public void CellStyleConverter_IsATypeConverter_AdvertisingInstanceDescriptor()
+    {
+        var converter = new DataGridViewCellStyleConverter();
+
+        Assert.IsAssignableFrom<TypeConverter>(converter);
+        Assert.True(converter.CanConvertTo(null, typeof(InstanceDescriptor)));
+    }
+
+    [Fact]
+    public void DropDownItemAccessibleObject_ExposesTheOwnersRoleAndName()
+    {
+        using var owner = new ToolStripDropDownButton("Menu");
+        var accessible = new ToolStripDropDownItemAccessibleObject(owner);
+
+        Assert.IsAssignableFrom<AccessibleObject>(accessible);
+        Assert.Equal(AccessibleRole.MenuItem, accessible.Role);
+        Assert.Equal("Menu", accessible.Name);
+    }
+
+    [Fact]
+    public void DropDownItemAccessibleObject_NullOwner_Throws()
+    {
+        Assert.Throws<ArgumentNullException>(() => new ToolStripDropDownItemAccessibleObject(null!));
+    }
+}
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/DataGridViewBase/DataGridViewCellStyleConverter.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/DataGridViewBase/DataGridViewCellStyleConverter.cs
new file mode 100644
index 00000000..3577662b
--- /dev/null
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/DataGridViewBase/DataGridViewCellStyleConverter.cs
@@ -0,0 +1,39 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+using System.ComponentModel;
+using System.ComponentModel.Design.Serialization;
+using System.Globalization;
+
+namespace System.Windows.Forms;
+
+/// <summary>
+/// Converts <see cref="DataGridViewCellStyle" /> objects for the designer. It was absent, so a
+/// <c>[TypeConverter(typeof(DataGridViewCellStyleConverter))]</c> annotation did not compile. The
+/// conversion surface is inherited from <see cref="TypeConverter" />; the designer-serialization
+/// (<see cref="InstanceDescriptor" />) path is advertised but produces no descriptor on this layer.
+/// </summary>
+public class DataGridViewCellStyleConverter : TypeConverter
+{
+    /// <summary>Initializes a new instance of the <see cref="DataGridViewCellStyleConverter" /> class.</summary>
+    public DataGridViewCellStyleConverter()
+    {
+    }
+
+    /// <inheritdoc />
+    public override bool CanConvertTo(ITypeDescriptorContext? context, Type? destinationType) =>
+        destinationType == typeof(InstanceDescriptor) || base.CanConvertTo(context, destinationType);
+
+    /// <inheritdoc />
+    public override object? ConvertTo(ITypeDescriptorContext? context, CultureInfo? culture, object? value, Type destinationType)
+    {
+        if (destinationType == null)
+        {
+            throw new ArgumentNullException(nameof(destinationType));
+        }
+
+        // Designer serialization to an InstanceDescriptor has no representation on this layer; other
+        // conversions (notably to string) defer to the base converter.
+        return base.ConvertTo(context, culture, value, destinationType);
+    }
+}
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/DataGridViewBase/DataGridViewColumnDesignTimeVisibleAttribute.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/DataGridViewBase/DataGridViewColumnDesignTimeVisibleAttribute.cs
new file mode 100644
index 00000000..ac829fda
--- /dev/null
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/DataGridViewBase/DataGridViewColumnDesignTimeVisibleAttribute.cs
@@ -0,0 +1,46 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+namespace System.Windows.Forms;
+
+/// <summary>
+/// Specifies whether a data-grid-view column type is visible in the designer's column collection editor.
+/// It was absent, so a custom column type annotated with it did not compile.
+/// </summary>
+[AttributeUsage(AttributeTargets.Class)]
+public sealed class DataGridViewColumnDesignTimeVisibleAttribute : Attribute
+{
+    /// <summary>Represents a column type that is visible at design time.</summary>
+    public static readonly DataGridViewColumnDesignTimeVisibleAttribute Yes = new(true);
+
+    /// <summary>Represents a column type that is not visible at design time.</summary>
+    public static readonly DataGridViewColumnDesignTimeVisibleAttribute No = new(false);
+
+    /// <summary>Represents the default value, <see cref="Yes" />.</summary>
+    public static readonly DataGridViewColumnDesignTimeVisibleAttribute Default = Yes;
+
+    /// <summary>Initializes a new instance that is visible at design time.</summary>
+    public DataGridViewColumnDesignTimeVisibleAttribute() : this(true)
+    {
+    }
+
+    /// <summary>Initializes a new instance with the given visibility.</summary>
+    /// <param name="visible">Whether the column type is visible at design time.</param>
+    public DataGridViewColumnDesignTimeVisibleAttribute(bool visible)
+    {
+        Visible = visible;
+    }
+
+    /// <summary>Gets a value indicating whether the column type is visible at design time.</summary>
+    public bool Visible { get; }
+
+    /// <inheritdoc />
+    public override bool Equals(object? obj) =>
+        obj is DataGridViewColumnDesignTimeVisibleAttribute other && other.Visible == Visible;
+
+    /// <inheritdoc />
+    public override int GetHashCode() => Visible.GetHashCode();
+
+    /// <inheritdoc />
+    public override bool IsDefaultAttribute() => Visible == Default.Visible;
+}
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripDropDownItemAccessibleObject.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripDropDownItemAccessibleObject.cs
new file mode 100644
index 00000000..3865df59
--- /dev/null
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripDropDownItemAccessibleObject.cs
@@ -0,0 +1,33 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+namespace System.Windows.Forms;
+
+/// <summary>
+/// The accessibility object for a <see cref="ToolStripDropDownItem" /> (a menu item that owns a
+/// drop-down). It was absent, so code referencing the type by name did not compile. WinForms derives it
+/// from <c>ToolStripItem.ToolStripItemAccessibleObject</c>, which the shim does not project; here it
+/// derives directly from <see cref="AccessibleObject" /> and exposes the owning item's accessible role and
+/// text.
+/// </summary>
+public class ToolStripDropDownItemAccessibleObject : AccessibleObject
+{
+    private readonly ToolStripDropDownItem _ownerItem;
+
+    /// <summary>Initializes a new instance for the given owning item.</summary>
+    /// <param name="item">The drop-down item this accessible object represents.</param>
+    public ToolStripDropDownItemAccessibleObject(ToolStripDropDownItem item)
+    {
+        _ownerItem = item ?? throw new ArgumentNullException(nameof(item));
+    }
+
+    /// <summary>Gets the accessible role — a menu item that opens a sub-menu.</summary>
+    public override AccessibleRole Role => AccessibleRole.MenuItem;
+
+    /// <summary>Gets the accessible name — the owning item's text.</summary>
+    public override string? Name
+    {
+        get => _ownerItem.Text;
+        set => base.Name = value;
+    }
+}
