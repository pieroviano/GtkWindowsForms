From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Subject: [PATCH] Gtk4: cascade submenus to the right, like Gtk3 did

Opening a menu item that owns a submenu rendered wrongly compared with the Gtk3
build: the submenu dropped downwards on top of the menu it came from, hiding the
entries below its parent (in the sample, "b Menu"'s submenu covered the
separator and "c Menu"), and the item showed neither the "opens a submenu"
arrow nor its icon.

Gtk3 needed none of this: GtkMenuItem.Submenu placed cascading menus and the
theme drew the arrow. Gtk4 removed the menu widgets, so a drop-down is a
GtkPopover this shim positions itself - and every popover was being created at
PositionType.Bottom.

- StripMenuItem places its drop-down by role: Bottom for a menu-bar entry,
  Right with its top edge level with the item for a submenu parent. The choice
  is re-applied whenever the role becomes known, because the Designer routinely
  fills DropDownItems before adding the item to the MenuStrip.
- A submenu parent draws a trailing arrow; a menu-bar entry never does.
- Menu rows now span the width of the menu they sit in. A popover anchors to
  the widget it is attached to, so a caption-width row pushed the submenu back
  over its own menu; it also means the whole row highlights on hover, as in
  Gtk3.
- ToolStripMenuItem.SetIconImage no longer requires the widget to be realized.
  The Designer assigns Image during InitializeComponent, long before anything is
  on screen, so the icon was being dropped - which is why "b Menu" showed no
  image. Realization still refines the scale against the allocated height.

Verified by driving the real sample: the parent menu stays fully visible with
the submenu cascading beside it, level with its parent row.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
diff --git a/Gtk.Windows.Forms.Tests/System/Windows/Forms/StripMenuItemRenderingTests.cs b/Gtk.Windows.Forms.Tests/System/Windows/Forms/StripMenuItemRenderingTests.cs
index 624b8bc3..2d031d6f 100644
--- a/Gtk.Windows.Forms.Tests/System/Windows/Forms/StripMenuItemRenderingTests.cs
+++ b/Gtk.Windows.Forms.Tests/System/Windows/Forms/StripMenuItemRenderingTests.cs
@@ -186,7 +186,11 @@ public class StripMenuItemRenderingTests
     {
         // Regression: a Gtk.Popover holds a single Child, and the old code did popover.Child = item for each
         // add, so only the last drop-down entry survived. Items now go into a vertical box - all appear.
+        // The item is put on a MenuStrip because the left-spill assertion below is about a menu-bar entry's
+        // drop-down; a submenu parent is placed by a different rule (see the cascade tests).
+        var menu = new MenuStrip();
         var top = new ToolStripMenuItem("File");
+        menu.Items.Add(top);
         top.DropDownItems.Add(new ToolStripMenuItem("New"));
         top.DropDownItems.Add(new ToolStripMenuItem("Open"));
         top.DropDownItems.Add(new ToolStripMenuItem("Save"));
@@ -207,6 +211,167 @@ public class StripMenuItemRenderingTests
         Assert.Equal(Gtk.Align.Start, top.self.DropDownAlign);
     }
 
+    [Fact]
+    public void MenuItemImage_AppearsWithoutWaitingForRealization()
+    {
+        // Regression: SetIconImage was gated on self.IsRealized, but the Designer assigns Image during
+        // InitializeComponent - long before anything is on screen - so the icon was dropped on the floor.
+        // In the sample this left "b Menu" with no image where Gtk3 shows one.
+        var item = new ToolStripMenuItem("b Menu") { Image = new gtk::System.Drawing.Bitmap(8, 8) { Pixbuf = NewPixbuf() } };
+
+        Assert.NotNull(item.self.Image);
+
+        var content = (Gtk.Box)item.checkButton.Child;
+        var icon = ChildrenOf(content).OfType<Gtk.Image>().First();
+        Assert.True(icon.Visible, "the icon must be visible as soon as Image is assigned");
+    }
+
+    [Fact]
+    public void ClearingMenuItemImage_HidesTheIcon()
+    {
+        var item = new ToolStripMenuItem("b Menu") { Image = new gtk::System.Drawing.Bitmap(8, 8) { Pixbuf = NewPixbuf() } };
+
+        item.Image = null;
+
+        var content = (Gtk.Box)item.checkButton.Child;
+        var icon = ChildrenOf(content).OfType<Gtk.Image>().First();
+        Assert.False(icon.Visible, "clearing Image must clear the icon, not leave the old one on screen");
+    }
+
+    [Fact]
+    public void MenuBarItem_DropsItsMenuDownwards()
+    {
+        var menu = new MenuStrip();
+        var top = new ToolStripMenuItem("Menu 2");
+        menu.Items.Add(top);
+        top.DropDownItems.Add(new ToolStripMenuItem("a Menu"));
+
+        Assert.Equal(Gtk.PositionType.Bottom, top.self.DropDownPosition);
+    }
+
+    [Fact]
+    public void SubmenuParent_CascadesToTheRight_NotOverItsOwnMenu()
+    {
+        // Regression: every drop-down popover was created at PositionType.Bottom, so a submenu opened
+        // downwards on top of the menu it came from - hiding the entries below its parent (in the sample,
+        // "b Menu"'s submenu covered the separator and "c Menu"). Gtk3 got this right because
+        // GtkMenuItem.Submenu placed cascading menus itself; Gtk4 has no menu widgets, so we place them.
+        var menu = new MenuStrip();
+        var top = new ToolStripMenuItem("Menu 2");
+        menu.Items.Add(top);
+
+        var parent = new ToolStripMenuItem("b Menu");
+        top.DropDownItems.Add(parent);
+        parent.DropDownItems.Add(new ToolStripMenuItem("bb Menu"));
+        parent.DropDownItems.Add(new ToolStripMenuItem("bb Menu 2"));
+
+        Assert.Equal(Gtk.PositionType.Right, parent.self.DropDownPosition);
+        // Top edge level with the parent item, rather than centred on it.
+        Assert.Equal(Gtk.Align.Start, parent.self.DropDownValign);
+    }
+
+    [Fact]
+    public void SubmenuParent_ShowsAnArrow_AndMenuBarItemDoesNot()
+    {
+        var menu = new MenuStrip();
+        var top = new ToolStripMenuItem("Menu 2");
+        menu.Items.Add(top);
+
+        var parent = new ToolStripMenuItem("b Menu");
+        top.DropDownItems.Add(parent);
+        parent.DropDownItems.Add(new ToolStripMenuItem("bb Menu"));
+
+        Assert.True(parent.self.ShowsSubmenuArrow, "a submenu parent must indicate that it opens a submenu");
+        Assert.False(top.self.ShowsSubmenuArrow, "a menu-bar entry never shows a submenu arrow");
+    }
+
+    [Fact]
+    public void LeafItem_ShowsNoSubmenuArrow()
+    {
+        var top = new ToolStripMenuItem("File");
+        var leaf = new ToolStripMenuItem("New");
+        top.DropDownItems.Add(leaf);
+
+        Assert.False(leaf.self.ShowsSubmenuArrow);
+    }
+
+    [Fact]
+    public void SubmenuPlacement_SurvivesItemsBeingFilledBeforeTheBarIsBuilt()
+    {
+        // The Designer routinely populates DropDownItems before adding the item to the MenuStrip, so the
+        // placement cannot be decided once at popover-construction time.
+        var top = new ToolStripMenuItem("Menu 2");
+        top.DropDownItems.Add(new ToolStripMenuItem("a Menu"));
+
+        var menu = new MenuStrip();
+        menu.Items.Add(top);
+
+        Assert.Equal(Gtk.PositionType.Bottom, top.self.DropDownPosition);
+        Assert.False(top.self.ShowsSubmenuArrow);
+    }
+
+    [Fact]
+    public void DropDownRows_SpanTheMenuWidth_UnlikeMenuBarEntries()
+    {
+        // A menu row must fill the menu, both so the whole row highlights on hover and so a submenu opened
+        // to the right starts at the menu's edge: a popover anchors to the widget it is attached to, so a
+        // caption-width button pushed the submenu back over the menu it came from. A menu-bar entry keeps
+        // hugging its caption, otherwise the bar's entries spread out across it.
+        var menu = new MenuStrip();
+        var top = new ToolStripMenuItem("Menu 2");
+        menu.Items.Add(top);
+
+        var row = new ToolStripMenuItem("a Menu");
+        top.DropDownItems.Add(row);
+
+        Assert.Equal(Gtk.Align.Fill, row.self.checkButton.Halign);
+        Assert.True(row.self.checkButton.Hexpand);
+        Assert.Equal(Gtk.Align.Start, top.self.checkButton.Halign);
+    }
+
+    [Fact]
+    public void ContextMenuRows_AlsoSpanTheMenuWidth()
+    {
+        var context = new ContextMenuStrip();
+        var row = new ToolStripMenuItem("Cut");
+        context.Items.Add(row);
+
+        Assert.Equal(Gtk.Align.Fill, row.self.checkButton.Halign);
+    }
+
+    [Fact]
+    public void ContextMenuSubmenu_AlsoCascadesToTheRight()
+    {
+        // A context menu has no menu bar, so every one of its items that owns a drop-down is a submenu
+        // parent and must cascade sideways.
+        var context = new ContextMenuStrip();
+        var parent = new ToolStripMenuItem("More");
+        context.Items.Add(parent);
+        parent.DropDownItems.Add(new ToolStripMenuItem("Deeper"));
+
+        Assert.Equal(Gtk.PositionType.Right, parent.self.DropDownPosition);
+        Assert.True(parent.self.ShowsSubmenuArrow);
+    }
+
+    [Fact]
+    public void SubmenuArrow_StaysTrailing_WhenTextImageRelationChanges()
+    {
+        // SetTextImageRelation rebuilds the content row; the arrow must end up last whatever the order of
+        // icon and caption, or it would appear in the middle of the item.
+        var top = new ToolStripMenuItem("Menu 2");
+        var parent = new ToolStripMenuItem("b Menu");
+        top.DropDownItems.Add(parent);
+        parent.DropDownItems.Add(new ToolStripMenuItem("bb Menu"));
+
+        parent.TextImageRelation = TextImageRelation.TextBeforeImage;
+
+        var content = (Gtk.Box)parent.checkButton.Child;
+        var children = ChildrenOf(content);
+
+        Assert.Same(parent.self.SubmenuArrowWidget, children[^1]);
+        Assert.True(parent.self.ShowsSubmenuArrow);
+    }
+
     [Fact]
     public void ClickingItemWithDropDown_OpensIt_WithoutRaisingLeafClick()
     {
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs b/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs
index 0dbfd891..d90ff287 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs
@@ -599,6 +599,9 @@ public sealed partial class Application
    for ordinary menu items only while unchecked (keeping the checkmark that a Checked item must show). */
 .MenuItemButton:not(:checked) check{min-width:0;min-height:0;-gtk-icon-size:0;margin:0;padding:0;border-width:0;background:none;box-shadow:none;opacity:0;}
 .MenuBarItem check{min-width:0;min-height:0;-gtk-icon-size:0;margin:0;padding:0;border-width:0;background:none;box-shadow:none;opacity:0;}
+/* The 'opens a submenu' arrow. Gtk3 got this from GtkMenuItem's theming; Gtk4 has no menu-item widget, so
+   StripMenuItem draws it and this keeps it clear of the caption and slightly dimmed, as themes do. */
+.SubmenuArrow{margin-left:12px;opacity:0.65;}
 .ToolStrip menu button image,.MenuStrip menu button image{margin-left:-22px;}
 .ToolStrip menu button image+label,.MenuStrip menu button image+label{margin-left:-2px; }
 .ToolStrip>separator,.MenuStrip>separator{padding:0px;margin:2px;}
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/StripMenuItem.cs b/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/StripMenuItem.cs
index 1af21706..c3b2f29a 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/StripMenuItem.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/StripMenuItem.cs
@@ -23,6 +23,17 @@ namespace System.Windows.Forms
 
         private readonly Gtk.Label textLabel = new Gtk.Label() { Visible = false, Halign = Align.Start, Valign = Align.Center };
 
+        // Gtk3 got the "this item opens a submenu" triangle for free from GtkMenuItem's theming; Gtk4 has no
+        // menu-item widget, so the indicator is drawn here. A Label rather than a themed Gtk.Image because a
+        // missing icon name would silently render nothing, and the arrow is load-bearing information.
+        private readonly Gtk.Label submenuArrow = new Gtk.Label("▸")
+        {
+            Visible = false,
+            Halign = Align.End,
+            Valign = Align.Center,
+            Hexpand = true,
+        };
+
         private Gdk.Pixbuf _Image = null!;
 
         // Guards the Toggled->Activated bridge so that programmatic Checked/CheckState changes do not look
@@ -44,6 +55,8 @@ namespace System.Windows.Forms
             checkButton.Vexpand = true;
             contentBox.Append(iconImage);
             contentBox.Append(textLabel);
+            contentBox.Append(submenuArrow);
+            submenuArrow.StyleContext.AddClass("SubmenuArrow");
             checkButton.Child = contentBox; // Gtk4: Box.Add -> Append; the button's content is the icon+label box
             base.Append(checkButton); // Gtk4: Box.Add -> Append
             checkButton.Toggled += CheckButton_Toggled;
@@ -150,6 +163,7 @@ namespace System.Windows.Forms
             // Gtk4 Box has no reorder-child; remove and re-append in the wanted order.
             contentBox.Remove(iconImage);
             contentBox.Remove(textLabel);
+            contentBox.Remove(submenuArrow);
             if (textFirst)
             {
                 contentBox.Append(textLabel);
@@ -161,10 +175,16 @@ namespace System.Windows.Forms
                 contentBox.Append(textLabel);
             }
 
+            // The submenu indicator always trails the caption, whatever relation icon and text are in.
+            contentBox.Append(submenuArrow);
+
             var align = vertical ? Align.Center : Align.Start;
             contentBox.Halign = align;
             iconImage.Halign = align;
             textLabel.Halign = align;
+
+            // Re-assert the indicator layout, which needs the row to span the item's full width.
+            ApplyDropDownPlacement();
         }
 
         /// <summary>
@@ -175,10 +195,92 @@ namespace System.Windows.Forms
         /// </summary>
         public void ConfigureAsMenuBarItem()
         {
+            _isMenuBarItem = true;
             checkButton.Hexpand = false;
             checkButton.Vexpand = false;
             this.Hexpand = false;
             this.Halign = Align.Start;
+
+            // A drop-down may already have been built (the designer commonly fills DropDownItems before
+            // adding the item to the MenuStrip), so re-place it now that we know this is a bar entry.
+            ApplyDropDownPlacement();
+        }
+
+        /// <summary>
+        /// Whether this item is a top-level entry of a menu bar, as opposed to an entry inside a drop-down
+        /// or context menu. Set by <see cref="ConfigureAsMenuBarItem" /> when the item is added to a
+        /// <see cref="MenuStrip" />.
+        /// </summary>
+        private bool _isMenuBarItem;
+
+        /// <summary>
+        /// Configures this item as an entry inside a drop-down or context menu, where rows span the whole
+        /// width of the menu.
+        /// </summary>
+        /// <remarks>
+        /// The clickable surface is left-hugging by default, which suits a menu bar but not a menu row. In a
+        /// drop-down it has two visible consequences: only the caption highlights on hover instead of the
+        /// whole row, and - because a popover anchors to the widget it is attached to - a submenu opened to
+        /// the right started at the end of the caption rather than at the menu's edge, overlapping the menu
+        /// it came from.
+        /// </remarks>
+        public void ConfigureAsDropDownItem()
+        {
+            checkButton.Halign = Align.Fill;
+            checkButton.Hexpand = true;
+            this.Halign = Align.Fill;
+            this.Hexpand = true;
+        }
+
+        /// <summary>
+        /// Positions this item's drop-down the way WinForms and Gtk3 do, and shows or hides the submenu
+        /// indicator to match.
+        /// </summary>
+        /// <remarks>
+        /// <para>
+        /// A menu-bar entry drops its menu <em>downwards</em>, left-aligned with the entry. Every other item
+        /// that owns a drop-down is a submenu parent, and its menu must cascade to the <em>right</em> with
+        /// its top edge level with the item.
+        /// </para>
+        /// <para>
+        /// Gtk3 never needed this: <c>GtkMenuItem.Submenu</c> placed cascading menus itself. Gtk4 removed
+        /// the menu widgets, and a <see cref="Gtk.Popover" /> defaults to dropping downwards - so a submenu
+        /// opened on top of the menu it came from, hiding the items below its parent.
+        /// </para>
+        /// </remarks>
+        private void ApplyDropDownPlacement()
+        {
+            // Only a submenu parent gets an arrow; a menu-bar entry never shows one.
+            submenuArrow.Visible = _dropDown != null && !_isMenuBarItem;
+
+            if (submenuArrow.Visible)
+            {
+                // The arrow sits at the item's trailing edge, so the content row has to span the whole item
+                // rather than hugging its caption.
+                contentBox.Hexpand = true;
+                contentBox.Halign = Align.Fill;
+            }
+
+            if (_dropDown == null)
+            {
+                return;
+            }
+
+            if (_isMenuBarItem)
+            {
+                _dropDown.Position = Gtk.PositionType.Bottom;
+                // A bottom popover centres on its parent by default, so a drop-down wider than a narrow menu
+                // item spilled to the left. Start left-aligns the popover with the item's left edge.
+                _dropDown.Halign = Align.Start;
+                _dropDown.Valign = Align.Fill;
+            }
+            else
+            {
+                _dropDown.Position = Gtk.PositionType.Right;
+                _dropDown.Halign = Align.Fill;
+                // Level the submenu's top edge with its parent item instead of centring it on the item.
+                _dropDown.Valign = Align.Start;
+            }
         }
 
         // Gtk4 removed Gtk.Menu/Gtk.MenuItem.Submenu; a drop-down is a Gtk.Popover parented to the item and
@@ -199,14 +301,13 @@ namespace System.Windows.Forms
                 _dropDown = new Gtk.Popover
                 {
                     Autohide = true,
-                    Position = Gtk.PositionType.Bottom,
                     Child = _dropDownBox,
                     HasArrow = false,
-                    // A bottom popover centres on its parent by default, so a drop-down wider than a narrow
-                    // menu item spilled to the left. Halign.Start left-aligns the popover's edge with the
-                    // item's left edge, matching WinForms/Gtk3.
-                    Halign = Gtk.Align.Start,
                 };
+
+                // Direction and alignment depend on whether this item is a menu-bar entry or a submenu
+                // parent - see ApplyDropDownPlacement.
+                ApplyDropDownPlacement();
             }
 
             return _dropDownBox!;
@@ -218,6 +319,21 @@ namespace System.Windows.Forms
         /// <summary>The horizontal alignment of the drop-down popover relative to this item (for tests).</summary>
         public Gtk.Align DropDownAlign => _dropDown?.Halign ?? Gtk.Align.Fill;
 
+        /// <summary>The vertical alignment of the drop-down popover relative to this item (for tests).</summary>
+        public Gtk.Align DropDownValign => _dropDown?.Valign ?? Gtk.Align.Fill;
+
+        /// <summary>
+        /// The side of this item its drop-down opens on: <see cref="Gtk.PositionType.Bottom" /> for a
+        /// menu-bar entry, <see cref="Gtk.PositionType.Right" /> for a submenu parent.
+        /// </summary>
+        public Gtk.PositionType DropDownPosition => _dropDown?.Position ?? Gtk.PositionType.Bottom;
+
+        /// <summary>Whether the "opens a submenu" arrow is currently shown on this item.</summary>
+        public bool ShowsSubmenuArrow => submenuArrow.Visible;
+
+        /// <summary>The submenu indicator widget, so its position in the content row can be asserted.</summary>
+        public Gtk.Widget SubmenuArrowWidget => submenuArrow;
+
         /// <summary>
         /// Pops the drop-down open (no-op if the item has no drop-down, or is not yet on screen - Popup on an
         /// unmapped popover would abort in GTK).
