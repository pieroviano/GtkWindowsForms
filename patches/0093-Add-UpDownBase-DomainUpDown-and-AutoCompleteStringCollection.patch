@@ -0,0 +1,80 @@
+namespace System.Windows.Forms;
+
+using System.ComponentModel;
+
+/// <summary>
+/// Verifies <see cref="AutoCompleteStringCollection" /> — the string list that drives auto-completion on
+/// text controls. It is a pure model type (no GTK), so these assertions need no form.
+/// </summary>
+public class AutoCompleteStringCollectionFunctionalTests
+{
+    [Fact]
+    public void ImplementsIList()
+    {
+        Assert.True(typeof(System.Collections.IList).IsAssignableFrom(typeof(AutoCompleteStringCollection)));
+    }
+
+    [Fact]
+    public void Add_IndexOf_Contains_RoundTrip()
+    {
+        var c = new AutoCompleteStringCollection();
+        Assert.Equal(0, c.Add("one"));
+        Assert.Equal(1, c.Add("two"));
+
+        Assert.Equal(2, c.Count);
+        Assert.True(c.Contains("two"));
+        Assert.Equal(1, c.IndexOf("two"));
+        Assert.Equal("one", c[0]);
+    }
+
+    [Fact]
+    public void AddRange_AddsAll()
+    {
+        var c = new AutoCompleteStringCollection();
+        c.AddRange(new[] { "a", "b", "c" });
+        Assert.Equal(3, c.Count);
+        Assert.Equal("c", c[2]);
+    }
+
+    [Fact]
+    public void Remove_And_Clear()
+    {
+        var c = new AutoCompleteStringCollection();
+        c.AddRange(new[] { "x", "y", "z" });
+        c.Remove("y");
+        Assert.Equal(2, c.Count);
+        Assert.False(c.Contains("y"));
+
+        c.Clear();
+        Assert.Equal(0, c.Count);
+    }
+
+    [Fact]
+    public void CollectionChanged_FiresOnAddAndRemove()
+    {
+        var c = new AutoCompleteStringCollection();
+        var actions = new System.Collections.Generic.List<CollectionChangeAction>();
+        c.CollectionChanged += (s, e) => actions.Add(e.Action);
+
+        c.Add("item");                 // Add
+        c.Remove("item");              // Remove
+
+        Assert.Contains(CollectionChangeAction.Add, actions);
+        Assert.Contains(CollectionChangeAction.Remove, actions);
+    }
+
+    [Fact]
+    public void Enumeration_YieldsItems()
+    {
+        var c = new AutoCompleteStringCollection();
+        c.AddRange(new[] { "p", "q" });
+
+        var seen = new System.Collections.Generic.List<string>();
+        foreach (string s in c)
+        {
+            seen.Add(s);
+        }
+
+        Assert.Equal(new[] { "p", "q" }, seen);
+    }
+}
diff --git a/Gtk.Windows.Forms.Tests/System/Windows/Forms/UpDownFunctionalTests.cs b/Gtk.Windows.Forms.Tests/System/Windows/Forms/UpDownFunctionalTests.cs
new file mode 100644
index 00000000..3f2cbd6f
--- /dev/null
+++ b/Gtk.Windows.Forms.Tests/System/Windows/Forms/UpDownFunctionalTests.cs
@@ -0,0 +1,95 @@
+namespace System.Windows.Forms;
+
+extern alias gtk;
+
+/// <summary>
+/// Verifies the <see cref="UpDownBase" /> base class, the re-parenting of <see cref="NumericUpDown" /> onto
+/// it, and the new <see cref="DomainUpDown" /> control. Hierarchy claims are checked by reflection; the
+/// value/selection behaviour runs inside a single realized-form lifecycle (form created first so GTK is
+/// initialized), with no clipboard interaction.
+/// </summary>
+[Collection("NonParallelCollection")]
+public class UpDownFunctionalTests
+{
+    [Fact]
+    public void Hierarchy_IsFaithfulToWinForms()
+    {
+        Assert.True(typeof(UpDownBase).IsAssignableFrom(typeof(NumericUpDown)));
+        Assert.True(typeof(UpDownBase).IsAssignableFrom(typeof(DomainUpDown)));
+        // Real WinForms: UpDownBase : ContainerControl.
+        Assert.Equal(typeof(ContainerControl), typeof(UpDownBase).BaseType);
+    }
+
+    [Fact]
+    public void UpDownBehaviour_Behaves()
+    {
+        var form = new Form();
+        var numeric = new NumericUpDown();
+        var domain = new DomainUpDown();
+        form.Controls.Add(numeric);
+        form.Controls.Add(domain);
+
+        form.Load += (s, e) =>
+        {
+            try
+            {
+                // --- NumericUpDown.UpButton/DownButton step by Increment and clamp ---
+                numeric.Minimum = 0;
+                numeric.Maximum = 10;
+                numeric.Increment = 2;
+                numeric.Value = 4;
+                numeric.UpButton();
+                Assert.Equal(6m, numeric.Value);
+                numeric.DownButton();
+                Assert.Equal(4m, numeric.Value);
+                numeric.Value = 10;
+                numeric.UpButton(); // clamps at Maximum
+                Assert.Equal(10m, numeric.Value);
+
+                // --- DomainUpDown item model + selection ---
+                domain.Items.Add("alpha");
+                domain.Items.Add("beta");
+                domain.Items.Add("gamma");
+                Assert.Equal(3, domain.Items.Count);
+
+                domain.SelectedIndex = 0;
+                Assert.Equal("alpha", domain.SelectedItem);
+                Assert.Equal("alpha", domain.Text);
+
+                domain.DownButton();
+                Assert.Equal(1, domain.SelectedIndex);
+                Assert.Equal("beta", domain.SelectedItem);
+
+                domain.UpButton();
+                Assert.Equal(0, domain.SelectedIndex);
+
+                // --- without Wrap, UpButton stays at the first item ---
+                domain.UpButton();
+                Assert.Equal(0, domain.SelectedIndex);
+
+                // --- with Wrap, UpButton from the first item goes to the last ---
+                domain.Wrap = true;
+                domain.UpButton();
+                Assert.Equal(2, domain.SelectedIndex);
+                Assert.Equal("gamma", domain.SelectedItem);
+
+                // --- Sorted reorders the items ---
+                domain.Items.Clear();
+                domain.Items.Add("charlie");
+                domain.Items.Add("alpha");
+                domain.Items.Add("bravo");
+                domain.Sorted = true;
+                Assert.Equal("alpha", domain.Items[0]);
+                Assert.Equal("bravo", domain.Items[1]);
+                Assert.Equal("charlie", domain.Items[2]);
+            }
+            finally
+            {
+                form.Close();
+            }
+        };
+
+        form.ShowDialog();
+        form.Dispose();
+    }
+}
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/AutoCompleteStringCollection.cs b/Gtk.Windows.Forms/System/Windows/Forms/AutoCompleteStringCollection.cs
new file mode 100644
