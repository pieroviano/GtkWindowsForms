@@ -0,0 +1,159 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+// See the LICENSE file in the project root for more information.
+
+using System.Collections;
+using System.Collections.Generic;
+using System.ComponentModel;
+
+namespace System.Windows.Forms;
+
+/// <summary>
+/// Represents a collection of strings used for the automatic-completion feature on certain Windows Forms
+/// controls (such as <see cref="T:System.Windows.Forms.TextBox" /> and
+/// <see cref="T:System.Windows.Forms.ComboBox" />).
+/// </summary>
+public class AutoCompleteStringCollection : IList, ICollection, IEnumerable
+{
+    private readonly List<string> _items = new();
+
+    /// <summary>Initializes a new instance of the <see cref="T:System.Windows.Forms.AutoCompleteStringCollection" /> class.</summary>
+    public AutoCompleteStringCollection()
+    {
+    }
+
+    /// <summary>Occurs when the collection changes.</summary>
+    public event CollectionChangeEventHandler? CollectionChanged;
+
+    /// <summary>Gets the number of strings in the collection.</summary>
+    public int Count => _items.Count;
+
+    /// <summary>Gets a value indicating whether the collection is read-only. Always <see langword="false" />.</summary>
+    public bool IsReadOnly => false;
+
+    /// <summary>Gets a value indicating whether access to the collection is synchronized. Always <see langword="false" />.</summary>
+    public bool IsSynchronized => false;
+
+    /// <summary>Gets an object that can be used to synchronize access to the collection.</summary>
+    public object SyncRoot => this;
+
+    bool IList.IsFixedSize => false;
+
+    /// <summary>Gets or sets the string at the specified index.</summary>
+    /// <param name="index">The zero-based index of the string.</param>
+    /// <returns>The string at <paramref name="index" />.</returns>
+    public string this[int index]
+    {
+        get => _items[index];
+        set
+        {
+            _items[index] = value;
+            OnCollectionChanged(new CollectionChangeEventArgs(CollectionChangeAction.Refresh, null));
+        }
+    }
+
+    object? IList.this[int index]
+    {
+        get => this[index];
+        set => this[index] = (string)value!;
+    }
+
+    /// <summary>Adds a string to the collection.</summary>
+    /// <param name="value">The string to add.</param>
+    /// <returns>The zero-based index at which the string was added.</returns>
+    public int Add(string value)
+    {
+        _items.Add(value);
+        OnCollectionChanged(new CollectionChangeEventArgs(CollectionChangeAction.Add, value));
+        return _items.Count - 1;
+    }
+
+    /// <summary>Adds an array of strings to the collection.</summary>
+    /// <param name="value">The strings to add.</param>
+    public void AddRange(string[] value)
+    {
+        if (value == null)
+        {
+            throw new ArgumentNullException(nameof(value));
+        }
+
+        _items.AddRange(value);
+        OnCollectionChanged(new CollectionChangeEventArgs(CollectionChangeAction.Refresh, null));
+    }
+
+    /// <summary>Removes all strings from the collection.</summary>
+    public void Clear()
+    {
+        _items.Clear();
+        OnCollectionChanged(new CollectionChangeEventArgs(CollectionChangeAction.Refresh, null));
+    }
+
+    /// <summary>Determines whether the collection contains the specified string.</summary>
+    /// <param name="value">The string to locate.</param>
+    /// <returns><see langword="true" /> if the string is found; otherwise <see langword="false" />.</returns>
+    public bool Contains(string value) => _items.Contains(value);
+
+    /// <summary>Copies the collection to a string array, starting at the specified index.</summary>
+    /// <param name="array">The destination array.</param>
+    /// <param name="index">The zero-based index in the destination at which copying begins.</param>
+    public void CopyTo(string[] array, int index) => _items.CopyTo(array, index);
+
+    /// <summary>Returns the index of the specified string in the collection.</summary>
+    /// <param name="value">The string to locate.</param>
+    /// <returns>The zero-based index, or -1 if not found.</returns>
+    public int IndexOf(string value) => _items.IndexOf(value);
+
+    /// <summary>Inserts a string into the collection at the specified index.</summary>
+    /// <param name="index">The zero-based index at which to insert.</param>
+    /// <param name="value">The string to insert.</param>
+    public void Insert(int index, string value)
+    {
+        _items.Insert(index, value);
+        OnCollectionChanged(new CollectionChangeEventArgs(CollectionChangeAction.Add, value));
+    }
+
+    /// <summary>Removes the specified string from the collection.</summary>
+    /// <param name="value">The string to remove.</param>
+    public void Remove(string value)
+    {
+        if (_items.Remove(value))
+        {
+            OnCollectionChanged(new CollectionChangeEventArgs(CollectionChangeAction.Remove, value));
+        }
+    }
+
+    /// <summary>Removes the string at the specified index.</summary>
+    /// <param name="index">The zero-based index of the string to remove.</param>
+    public void RemoveAt(int index)
+    {
+        var value = _items[index];
+        _items.RemoveAt(index);
+        OnCollectionChanged(new CollectionChangeEventArgs(CollectionChangeAction.Remove, value));
+    }
+
+    /// <summary>Returns an enumerator that iterates through the collection.</summary>
+    /// <returns>An enumerator for the collection.</returns>
+    public IEnumerator GetEnumerator() => _items.GetEnumerator();
+
+    /// <summary>Raises the <see cref="E:System.Windows.Forms.AutoCompleteStringCollection.CollectionChanged" /> event.</summary>
+    /// <param name="e">A <see cref="T:System.ComponentModel.CollectionChangeEventArgs" /> that contains the event data.</param>
+    protected void OnCollectionChanged(CollectionChangeEventArgs e) => CollectionChanged?.Invoke(this, e);
+
+    int IList.Add(object? value) => Add((string)value!);
+
+    bool IList.Contains(object? value) => value is string s && Contains(s);
+
+    int IList.IndexOf(object? value) => value is string s ? IndexOf(s) : -1;
+
+    void IList.Insert(int index, object? value) => Insert(index, (string)value!);
+
+    void IList.Remove(object? value)
+    {
+        if (value is string s)
+        {
+            Remove(s);
+        }
+    }
+
+    void ICollection.CopyTo(Array array, int index) => ((ICollection)_items).CopyTo(array, index);
+}
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/DomainUpDown.cs b/Gtk.Windows.Forms/System/Windows/Forms/DomainUpDown.cs
new file mode 100644
index 00000000..67f48db9
--- /dev/null
+++ b/Gtk.Windows.Forms/System/Windows/Forms/DomainUpDown.cs
@@ -0,0 +1,276 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+// See the LICENSE file in the project root for more information.
+
+using System.Collections;
+using System.ComponentModel;
+using GtkDomainEntry = GtkSystem.Windows.Forms.GtkControls.ControlBase.TextBoxBase;
+
+namespace System.Windows.Forms;
+
+/// <summary>
+/// Represents a Windows spin box (also known as an up-down control) that displays string values from a list.
+/// </summary>
+/// <remarks>
+/// The item model, selection and wrap/sort behaviour follow WinForms exactly. The control is backed by a
+/// read-only GTK entry that shows the selected item; the up and down buttons are driven programmatically
+/// through <see cref="M:System.Windows.Forms.DomainUpDown.UpButton" /> and
+/// <see cref="M:System.Windows.Forms.DomainUpDown.DownButton" /> (GTK does not provide a composite text +
+/// spin-button widget, so the arrows are not rendered as separate glyphs — a documented visual deviation).
+/// </remarks>
+[DesignerCategory("Component")]
+public partial class DomainUpDown : UpDownBase
+{
+    /// <summary>
+    /// The self
+    /// </summary>
+    public readonly GtkDomainEntry self = new();
+
+    private readonly DomainUpDownItemCollection _items;
+    private int _selectedIndex = -1;
+    private bool _sorted;
+    private bool _wrap;
+
+    /// <summary>
+    /// Occurs when the <see cref="P:System.Windows.Forms.DomainUpDown.SelectedItem" /> property has been
+    /// changed.
+    /// </summary>
+    public event EventHandler? SelectedItemChanged;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="T:System.Windows.Forms.DomainUpDown" /> class.
+    /// </summary>
+    public DomainUpDown() : base()
+    {
+        self.Override.sender = this;
+        self.IsEditable = false;
+        _items = new DomainUpDownItemCollection(this);
+    }
+
+    /// <summary>
+    /// Gets the GTK control.
+    /// </summary>
+    public override object GtkControl => self;
+
+    /// <summary>
+    /// Gets the object collection assigned to this up-down control.
+    /// </summary>
+    public DomainUpDownItemCollection Items => _items;
+
+    /// <summary>
+    /// Gets or sets the text displayed in the up-down control.
+    /// </summary>
+    public override string Text
+    {
+        get => self.Text;
+        set => self.Text = value ?? string.Empty;
+    }
+
+    /// <summary>
+    /// Gets or sets a value indicating whether the item collection is sorted.
+    /// </summary>
+    public bool Sorted
+    {
+        get => _sorted;
+        set
+        {
+            _sorted = value;
+            if (_sorted)
+            {
+                _items.SortInternal();
+                UpdateDisplay();
+            }
+        }
+    }
+
+    /// <summary>
+    /// Gets or sets a value indicating whether the collection of items continues to the first or last item
+    /// if the user continues past the end of the list.
+    /// </summary>
+    public bool Wrap
+    {
+        get => _wrap;
+        set => _wrap = value;
+    }
+
+    /// <summary>
+    /// Gets or sets the index value of the selected item.
+    /// </summary>
+    public int SelectedIndex
+    {
+        get => _selectedIndex;
+        set
+        {
+            if (value < -1 || value >= _items.Count)
+            {
+                throw new ArgumentOutOfRangeException(nameof(value));
+            }
+
+            if (_selectedIndex != value)
+            {
+                _selectedIndex = value;
+                UpdateDisplay();
+                OnSelectedItemChanged(EventArgs.Empty);
+            }
+        }
+    }
+
+    /// <summary>
+    /// Gets or sets the selected item based on the index value of the selected item in the collection.
+    /// </summary>
+    public object? SelectedItem
+    {
+        get => _selectedIndex >= 0 && _selectedIndex < _items.Count ? _items[_selectedIndex] : null;
+        set
+        {
+            var index = value == null ? -1 : _items.IndexOf(value);
+            SelectedIndex = index;
+        }
+    }
+
+    /// <summary>
+    /// Displays the previous item in the collection.
+    /// </summary>
+    public override void UpButton()
+    {
+        MoveSelection(-1);
+    }
+
+    /// <summary>
+    /// Displays the next item in the collection.
+    /// </summary>
+    public override void DownButton()
+    {
+        MoveSelection(1);
+    }
+
+    /// <summary>
+    /// Returns a string that represents the <see cref="T:System.Windows.Forms.DomainUpDown" /> control.
+    /// </summary>
+    /// <returns>A string that includes the item count and selected index.</returns>
+    public override string ToString()
+    {
+        return $"{base.ToString()}, Items.Count: {_items.Count}, SelectedIndex: {_selectedIndex}";
+    }
+
+    /// <summary>
+    /// Raises the <see cref="E:System.Windows.Forms.DomainUpDown.SelectedItemChanged" /> event.
+    /// </summary>
+    /// <param name="e">An <see cref="T:System.EventArgs" /> that contains the event data.</param>
+    protected virtual void OnSelectedItemChanged(EventArgs e) => SelectedItemChanged?.Invoke(this, e);
+
+    internal void OnItemsChanged()
+    {
+        if (_sorted)
+        {
+            _items.SortInternal();
+        }
+
+        if (_selectedIndex >= _items.Count)
+        {
+            _selectedIndex = _items.Count - 1;
+        }
+
+        UpdateDisplay();
+    }
+
+    private void MoveSelection(int delta)
+    {
+        if (_items.Count == 0)
+        {
+            return;
+        }
+
+        var next = _selectedIndex + delta;
+        if (next < 0)
+        {
+            next = _wrap ? _items.Count - 1 : 0;
+        }
+        else if (next >= _items.Count)
+        {
+            next = _wrap ? 0 : _items.Count - 1;
+        }
+
+        SelectedIndex = next;
+    }
+
+    private void UpdateDisplay()
+    {
+        self.Text = SelectedItem?.ToString() ?? string.Empty;
+    }
+}
+
+/// <summary>
+/// Encapsulates a collection of objects for use by the <see cref="T:System.Windows.Forms.DomainUpDown" />
+/// class.
+/// </summary>
+public class DomainUpDownItemCollection : ArrayList
+{
+    private readonly DomainUpDown _owner;
+
+    internal DomainUpDownItemCollection(DomainUpDown owner)
+    {
+        _owner = owner;
+    }
+
+    /// <summary>Gets or sets an item at the specified index in the collection.</summary>
+    /// <param name="index">The zero-based index of the item.</param>
+    /// <returns>The item at <paramref name="index" />.</returns>
+    public override object? this[int index]
+    {
+        get => base[index];
+        set
+        {
+            base[index] = value;
+            _owner.OnItemsChanged();
+        }
+    }
+
+    /// <summary>Adds an item to the end of the collection.</summary>
+    /// <param name="value">The item to add.</param>
+    /// <returns>The index at which the item was added.</returns>
+    public override int Add(object? value)
+    {
+        var result = base.Add(value);
+        _owner.OnItemsChanged();
+        return result;
+    }
+
+    /// <summary>Inserts an item into the collection at the specified index.</summary>
+    /// <param name="index">The zero-based index at which to insert.</param>
+    /// <param name="value">The item to insert.</param>
+    public override void Insert(int index, object? value)
+    {
+        base.Insert(index, value);
+        _owner.OnItemsChanged();
+    }
+
+    /// <summary>Removes the specified item from the collection.</summary>
+    /// <param name="obj">The item to remove.</param>
+    public override void Remove(object? obj)
+    {
+        base.Remove(obj);
+        _owner.OnItemsChanged();
+    }
+
+    /// <summary>Removes the item at the specified index.</summary>
+    /// <param name="index">The zero-based index of the item to remove.</param>
+    public override void RemoveAt(int index)
+    {
+        base.RemoveAt(index);
+        _owner.OnItemsChanged();
+    }
+
+    /// <summary>Removes all items from the collection.</summary>
+    public override void Clear()
+    {
+        base.Clear();
+        _owner.OnItemsChanged();
+    }
+
+    internal void SortInternal()
+    {
+        base.Sort(Comparer<object?>.Create((a, b) =>
+            string.Compare(a?.ToString(), b?.ToString(), StringComparison.CurrentCulture)));
+    }
+}
