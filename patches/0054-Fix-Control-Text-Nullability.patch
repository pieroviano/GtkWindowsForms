+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/CheckBox.cs
@@ -87,7 +87,7 @@ public partial class CheckBox : Control
     /// <value>
     /// The text.
     /// </value>
-    public override string? Text
+    public override string Text
     {
         get { return self.Label; }
         set { self.Label = value; }
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/ComboBox.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/ComboBox.cs
