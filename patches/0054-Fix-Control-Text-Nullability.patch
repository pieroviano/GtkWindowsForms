From 804de89c5d742e42a5c728fd3ea224368df8bbba Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Date: Mon, 6 Apr 2026 04:02:52 +0300
Subject: [PATCH] Fix Control Text Nullability

---
 Net4x.Gtk.Windows.Forms/System/Windows/Forms/Button.cs      | 6 +++---
 Net4x.Gtk.Windows.Forms/System/Windows/Forms/CheckBox.cs    | 2 +-
 Net4x.Gtk.Windows.Forms/System/Windows/Forms/ComboBox.cs    | 2 +-
 .../System/Windows/Forms/Control/Control.cs                 | 6 +++---
 .../System/Windows/Forms/Control/IControl.cs                | 2 +-
 Net4x.Gtk.Windows.Forms/System/Windows/Forms/Form.cs        | 2 +-
 Net4x.Gtk.Windows.Forms/System/Windows/Forms/GroupBox.cs    | 2 +-
 Net4x.Gtk.Windows.Forms/System/Windows/Forms/Label.cs       | 4 ++--
 Net4x.Gtk.Windows.Forms/System/Windows/Forms/LinkLabel.cs   | 6 +++---
 Net4x.Gtk.Windows.Forms/System/Windows/Forms/ListBox.cs     | 2 +-
 .../System/Windows/Forms/Printing/PrintPreviewControl.cs    | 2 +-
 Net4x.Gtk.Windows.Forms/System/Windows/Forms/RadioButton.cs | 2 +-
 Net4x.Gtk.Windows.Forms/System/Windows/Forms/RichTextBox.cs | 2 +-
 Net4x.Gtk.Windows.Forms/System/Windows/Forms/SwitchBox.cs   | 2 +-
 .../System/Windows/Forms/TabControlBase/TabPage.cs          | 2 +-
 Net4x.Gtk.Windows.Forms/System/Windows/Forms/TextBox.cs     | 2 +-
 Net4x.Gtk.Windows.Forms/System/Windows/Forms/ToolStrip.cs   | 2 +-
 17 files changed, 24 insertions(+), 24 deletions(-)

diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Button.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Button.cs
index 863178a..02626bb 100644
--- a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Button.cs
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Button.cs
@@ -66,9 +66,9 @@ public partial class Button : Control
     /// <value>
     /// The text.
     /// </value>
-    public override string? Text
+    public override string Text
     {
-        get => ((Gtk.Label)self.Child).Text;
+        get => ((Gtk.Label)self.Child).Text ?? string.Empty;
         set => ((Gtk.Label)self.Child).Text = value;
     }
 
@@ -135,7 +135,7 @@ public partial class Button : Control
     /// <summary>
     /// Raises the Click event.
     /// </summary>
-    protected override void OnClick(System.EventArgs e)
+    protected internal override void OnClick(System.EventArgs e)
     {
         Click?.Invoke(this, e);
     }
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/CheckBox.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/CheckBox.cs
index a43afbe..170999f 100644
