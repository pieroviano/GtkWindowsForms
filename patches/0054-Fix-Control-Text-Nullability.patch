     {
         get => self.Entry.Text;
         set { self.Entry.Text = value; }
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs
index 237431b..5b7087c 100644
--- a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs
@@ -1263,11 +1263,11 @@ public partial class Control : Component, IControl, ISynchronizeInvoke, ICompone
     /// <summary>
     /// Gets or sets the text associated with the control.
     /// </summary>
-    public virtual string? Text
+    public virtual string Text
     {
         get;
         set;
-    }
+    } = null!;
 
     /// <summary>
     /// Gets or sets the top position of the control relative to its container.
@@ -2653,7 +2653,7 @@ public partial class Control : Component, IControl, ISynchronizeInvoke, ICompone
     /// <see cref="T:System.EventArgs" /> instance containing the event data.
     /// </param>
     [EditorBrowsable(EditorBrowsableState.Advanced)]
-    protected virtual void OnClick(EventArgs e)
+    protected internal virtual void OnClick(EventArgs e)
     {
         Click?.Invoke(this, e);
     }
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Control/IControl.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Control/IControl.cs
