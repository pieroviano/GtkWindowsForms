From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Subject: [PATCH] Gtk4: emit an absolute URI for a BackgroundImage

Restoring the custom-paint path brought back BackgroundImage on controls painted
through the override, but form and panel backgrounds stayed blank - Form2's
photograph was still missing.

They do not go through that path at all. UpdateStyle writes the image to a PNG
under Resources/ and emits background-image:url(...) with a relative path. Gtk3
resolved that against the process working directory; Gtk4 loads this stylesheet
from a string, which has no base URI, so the relative url() resolved to nothing
and the image silently never appeared. It now emits an absolute file:/// URI.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
diff --git a/Gtk.Windows.Forms.Tests/System/Windows/Forms/CustomPaintPathTests.cs b/Gtk.Windows.Forms.Tests/System/Windows/Forms/CustomPaintPathTests.cs
index 829cbb22..4499f714 100644
--- a/Gtk.Windows.Forms.Tests/System/Windows/Forms/CustomPaintPathTests.cs
+++ b/Gtk.Windows.Forms.Tests/System/Windows/Forms/CustomPaintPathTests.cs
@@ -70,6 +70,19 @@ public class CustomPaintPathTests
         Assert.Equal(0, handled);
     }
 
+    [Fact]
+    public void BackgroundImageCssUri_IsAbsolute()
+    {
+        // Gtk3 emitted a relative url() and resolved it against the process working directory. Gtk4 loads
+        // this stylesheet from a string, which has no base URI, so a relative url() resolves to nothing and
+        // the image silently never appeared - on every form and panel background in the sample.
+        var uri = Control.ToCssUri(Path.Combine("Resources", "x", "y_bgimage.png"));
+
+        Assert.StartsWith("file:///", uri, StringComparison.Ordinal);
+        Assert.DoesNotContain("\\", uri);
+        Assert.EndsWith("y_bgimage.png", uri, StringComparison.Ordinal);
+    }
+
     private static bool DeclaresSnapshotOverride(Type type)
     {
         return type.GetMethod(
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs b/Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs
index 43238322..74bf2c2f 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs
@@ -4247,7 +4247,11 @@ public partial class Control : Component, IControl, ISynchronizeInvoke, ICompone
                         Directory.CreateDirectory(bgimgdir);
                     bgpixbuf.Savev(bgimguri, "png", new string[] { }, new string[] { });
                 }
-                style.AppendFormat("background-image:url(\"{0}\");", bgimguri);
+                // Absolute file URI, not the relative path Gtk3 emitted. Gtk3 resolved a relative url()
+                // against the process working directory; Gtk4 loads this stylesheet from a string, which
+                // has no base URI, so a relative url() resolves to nothing and the image silently never
+                // appears - which is exactly what happened to every form and panel background.
+                style.AppendFormat("background-image:url(\"{0}\");", ToCssUri(bgimguri));
                 if (this.BackgroundImageLayout == ImageLayout.Tile)
                 {
                     style.Append("background-repeat:repeat;");
@@ -4412,6 +4416,25 @@ public partial class Control : Component, IControl, ISynchronizeInvoke, ICompone
     /// <summary>
     /// Updates the CSS/style for the control when mapped.
     /// </summary>
+    /// <summary>
+    /// Turns a path into a URI usable from a stylesheet loaded out of a string.
+    /// </summary>
+    /// <param name="path">A relative or absolute filesystem path.</param>
+    /// <returns>An absolute <c>file:///</c> URI, or the original path if it cannot be resolved.</returns>
+    internal static string ToCssUri(string path)
+    {
+        try
+        {
+            return new Uri(Path.GetFullPath(path)).AbsoluteUri;
+        }
+        catch (Exception ex)
+        {
+            Diagnostics.GtkLogger.Debug("Unable to build a CSS URI for " + path, ex);
+
+            return path;
+        }
+    }
+
     protected virtual void UpdateStyle()
     {
         GLib.Timeout.Add(1, () =>
