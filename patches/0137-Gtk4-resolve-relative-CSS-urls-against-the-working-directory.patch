From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Subject: [PATCH] Gtk4: resolve relative CSS urls against the working directory

Test1's button icons, its workflow chevrons and its bordered bottom buttons all
come from the sample's own stylesheet, theme/Test1.css, pulled in by theme/style.css
with a relative @import. None of it applied on Gtk4, and nothing said so: no
parsing error, no signal, nothing on stderr - the whole sheet simply contributed
nothing, which is why the theme looked like it had been read.

Application.Init reads the user stylesheet as text and hands the concatenation to
CssProvider.LoadFromData, exactly as Gtk3 did. Gtk3's parser gave such a sheet an
implicit base directory - it resolved a relative url() with g_file_new_for_path(),
i.e. against the process working directory - so both the @import and the images
nested inside the imported sheet resolved. Gtk4's gtk_css_parser_resolve_url()
returns nothing whenever the parser has no directory of its own, which is always
the case for LoadFromData/LoadFromString, so every relative reference is dropped
silently.

The new CssUri.ResolveUrls rewrites relative url() tokens to absolute file:///
URIs before the text reaches the provider, restoring the Gtk3 contract for every
consumer of the library. References that already carry a scheme (file:, data:,
resource:, http:), fragments and empty tokens are left byte-identical, and an
unresolvable one still becomes an absolute URI so Gtk reports it as invalid
rather than turning the declaration into a no-op. An imported sheet then gets a
base directory of its own from Gtk, so its own relative urls resolve natively.

The base directory is the working directory first - that is literally what Gtk3
used - then the application directory, which covers the case Gtk3 got wrong, an
app launched from somewhere else.

The same defect was still latent in Control.SetStyle: 0135 made the
BackgroundImage-only branch absolute but left the two Image branches emitting a
relative url(), so a control with an Image produced a declaration Gtk quietly
discarded. Both now go through ToCssUri. Application.Init also logs CSS parsing
errors, so the next theme breakage is at least visible.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs b/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs
index 97d0fc17..23c63eb8 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs
@@ -808,7 +808,16 @@ tooltip label {padding: 0px 10px; color: #555555;}
                 File.WriteAllText(themesetuppath, setupthemecontent.ToString(), Text.Encoding.UTF8);
             }
 
-            css.LoadFromData(cssBuilder.ToString());
+            // Gtk4 raises no diagnostic for a stylesheet it cannot make sense of beyond this signal, so
+            // surface it - a user theme that stops applying is otherwise completely invisible.
+            css.ParsingError += (_, args) => GtkLogger.Debug($"CSS parsing error in {args.Section}");
+            // A stylesheet loaded from a string has no base directory on Gtk4, and its
+            // gtk_css_parser_resolve_url() then silently drops every relative url() - images and, worse,
+            // @import - with no parsing error and nothing on stderr. Gtk3 resolved those against the
+            // process working directory, so a user theme that shipped relative references simply stopped
+            // applying. Make them absolute first: the working directory keeps the Gtk3 contract, and the
+            // application directory covers the case Gtk3 got wrong, an app launched from elsewhere.
+            css.LoadFromData(CssUri.ResolveUrls(cssBuilder.ToString(), Directory.GetCurrentDirectory(), appdirectory));
             Gtk.StyleContext.AddProviderForDisplay(Gdk.Display.Default, css, (uint)StyleProviderPriority.Application);
 
             // Gtk4: toolbar/menu-strip buttons keep the theme's rounded frame (box-shadow/border) even at
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs b/Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs
index 74bf2c2f..376e471a 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs
@@ -4179,7 +4179,9 @@ public partial class Control : Component, IControl, ISynchronizeInvoke, ICompone
                     var imagepixbuf = new Gdk.Pixbuf(this._image.PixbufData);
                     imagepixbuf.Save(imguri, "png");
                 }
-                style.AppendFormat("background:url(\"{0}\")", imguri);
+                // Absolute file URI - see the note on the background-image branch below: a relative url()
+                // in a stylesheet loaded from a string resolves to nothing on Gtk4.
+                style.AppendFormat("background:url(\"{0}\")", ToCssUri(imguri));
                 style.Append(" no-repeat");
                 if (this.ImageAlign == ContentAlignment.TopLeft)
                 {
@@ -4230,7 +4232,7 @@ public partial class Control : Component, IControl, ISynchronizeInvoke, ICompone
                         var bgpixbuf = new Gdk.Pixbuf(this._backgroundImage.PixbufData);
                         bgpixbuf.Savev(bgimguri, "png", new string[] { }, new string[] { });
                     }
-                    style.AppendFormat(",url(\"{0}\") repeat", bgimguri);
+                    style.AppendFormat(",url(\"{0}\") repeat", ToCssUri(bgimguri));
                 }
                 style.Append(";");
                 style.Append("background-origin: padding-box;");
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/Control/CssUri.cs b/Gtk.Windows.Forms/System/Windows/Forms/Control/CssUri.cs
new file mode 100644
index 00000000..1c56ce54
--- /dev/null
+++ b/Gtk.Windows.Forms/System/Windows/Forms/Control/CssUri.cs
@@ -0,0 +1,113 @@
+/*
+ * Based on GTK components, it is a cross-platform interface component that is compatible with the native C# control winform interface.
+ * Use this component GtkSystem.Windows.Forms instead of Microsoft.WindowsDesktop.App.WindowsForms, compile once, and run across Windows, Linux, and macOS
+ */
+
+using System.IO;
+using System.Text.RegularExpressions;
+
+namespace System.Windows.Forms;
+
+/// <summary>
+/// Makes the <c>url(...)</c> references of a stylesheet absolute before it is loaded from a string.
+/// </summary>
+/// <remarks>
+/// Gtk3 gave a stylesheet parsed out of a string an implicit base directory: its parser resolved a
+/// relative <c>url()</c> with <c>g_file_new_for_path()</c>, that is, against the process working
+/// directory. Gtk4's <c>gtk_css_parser_resolve_url()</c> instead returns nothing whenever the parser has
+/// no directory of its own, which is always the case for <c>LoadFromData</c>/<c>LoadFromString</c>. Every
+/// relative reference - an image, and just as importantly an <c>@import</c> - is therefore dropped
+/// <em>silently</em>: no parsing error is raised, nothing reaches stderr, the declaration simply never
+/// exists. Rewriting the references to absolute <c>file:///</c> URIs before the text reaches the provider
+/// restores the Gtk3 contract for every consumer of the library, and an imported sheet then gets a base
+/// directory of its own, so relative URLs nested inside it resolve natively.
+/// </remarks>
+internal static class CssUri
+{
+    /// <summary>
+    /// A <c>url()</c> token, with an optional single- or double-quoted target.
+    /// </summary>
+    private static readonly Regex UrlToken = new(
+        @"url\(\s*(?<q>['""]?)(?<target>[^)'""]*)\k<q>\s*\)",
+        RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
+
+    /// <summary>
+    /// A URI scheme prefix. Two characters at least are required before the colon, so that a Windows
+    /// drive letter ("C:/theme/x.png") is treated as a path rather than as a scheme.
+    /// </summary>
+    private static readonly Regex SchemePrefix = new(
+        @"^[a-zA-Z][a-zA-Z0-9+.\-]+:",
+        RegexOptions.CultureInvariant);
+
+    /// <summary>
+    /// Rewrites every relative <c>url(...)</c> in <paramref name="css" /> as an absolute
+    /// <c>file:///</c> URI.
+    /// </summary>
+    /// <param name="css">The stylesheet text, as it would be handed to a <see cref="Gtk.CssProvider" />.</param>
+    /// <param name="baseDirectories">
+    /// The directories a relative reference is resolved against, most significant first. The first
+    /// directory that actually holds the target wins; when none does, the first usable directory is used
+    /// anyway, so that Gtk reports the reference as invalid exactly as it would have done before.
+    /// </param>
+    /// <returns>
+    /// The stylesheet with its relative references made absolute. Tokens that are empty, that are a
+    /// fragment (<c>url(#gradient)</c>) or that already carry a scheme (<c>file:</c>, <c>resource:</c>,
+    /// <c>data:</c>, <c>http:</c>, ...) are returned untouched, as is any token that cannot be resolved.
+    /// </returns>
+    internal static string ResolveUrls(string css, params string[] baseDirectories)
+    {
+        if (string.IsNullOrEmpty(css) || baseDirectories == null || baseDirectories.Length == 0)
+        {
+            return css;
+        }
+
+        return UrlToken.Replace(css, match =>
+        {
+            var target = match.Groups["target"].Value.Trim();
+            if (target.Length == 0 || target[0] == '#' || SchemePrefix.IsMatch(target))
+            {
+                return match.Value;
+            }
+
+            var resolved = ToAbsoluteUri(target, baseDirectories);
+
+            return resolved == null ? match.Value : $"url(\"{resolved}\")";
+        });
+    }
+
+    /// <summary>
+    /// Resolves one relative reference against the candidate base directories.
+    /// </summary>
+    /// <param name="target">The reference as it appears in the stylesheet.</param>
+    /// <param name="baseDirectories">The directories to try, most significant first.</param>
+    /// <returns>An absolute <c>file:///</c> URI, or <see langword="null" /> if none could be built.</returns>
+    private static string? ToAbsoluteUri(string target, string[] baseDirectories)
+    {
+        string? fallback = null;
+        foreach (var directory in baseDirectories)
+        {
+            if (string.IsNullOrEmpty(directory))
+            {
+                continue;
+            }
+
+            try
+            {
+                var full = Path.GetFullPath(Path.Combine(directory, target));
+                var uri = new Uri(full).AbsoluteUri;
+                if (File.Exists(full) || Directory.Exists(full))
+                {
+                    return uri;
+                }
+
+                fallback ??= uri;
+            }
+            catch (Exception ex)
+            {
+                Diagnostics.GtkLogger.Debug($"Unable to build a CSS URI for {target} under {directory}", ex);
+            }
+        }
+
+        return fallback;
+    }
+}
diff --git a/Gtk.Windows.Forms.Tests/System/Windows/Forms/CssUrlResolutionTests.cs b/Gtk.Windows.Forms.Tests/System/Windows/Forms/CssUrlResolutionTests.cs
new file mode 100644
index 00000000..befdfd76
--- /dev/null
+++ b/Gtk.Windows.Forms.Tests/System/Windows/Forms/CssUrlResolutionTests.cs
@@ -0,0 +1,181 @@
+namespace System.Windows.Forms;
+
+extern alias gtk;
+
+using System.IO;
+using System.Reflection;
+
+/// <summary>
+/// A stylesheet the library loads from a string must keep resolving its relative <c>url()</c> references.
+/// </summary>
+/// <remarks>
+/// Gtk3's parser resolved a relative <c>url()</c> in string-loaded CSS against the process working
+/// directory. Gtk4 has no base directory there at all and drops the reference - an image, or an entire
+/// <c>@import</c>ed sheet - without raising a parsing error or writing anything to stderr. That is why the
+/// sample's <c>theme/Test1.css</c> silently contributed nothing on Gtk4 while everything looked healthy.
+/// </remarks>
+[Collection("NonParallelCollection")]
+public class CssUrlResolutionTests : IDisposable
+{
+    private readonly string _root;
+
+    // Constructing a Gdk.Pixbuf and a Gtk.CssProvider needs the type system initialised.
+    public CssUrlResolutionTests()
+    {
+        Application.Init();
+        _root = Path.Combine(Path.GetTempPath(), "CssUrlResolutionTests_" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(_root);
+    }
+
+    public void Dispose()
+    {
+        try
+        {
+            Directory.Delete(_root, true);
+        }
+        catch (IOException)
+        {
+            // A leftover temp directory is not worth failing a test over.
+        }
+
+        GC.SuppressFinalize(this);
+    }
+
+    [Fact]
+    public void RelativeReferences_BecomeAbsoluteFileUris()
+    {
+        var css = "@import url(\"theme/Test1.css\");\n#x{background-image:url('img/a.png')}";
+
+        var resolved = CssUri.ResolveUrls(css, _root);
+
+        Assert.Contains($"url(\"{Uri(Path.Combine(_root, "theme", "Test1.css"))}\")", resolved);
+        Assert.Contains($"url(\"{Uri(Path.Combine(_root, "img", "a.png"))}\")", resolved);
+    }
+
+    [Fact]
+    public void ReferencesThatAreAlreadyResolvable_AreLeftAlone()
+    {
+        // Anything carrying a scheme, and any fragment, is already meaningful to the parser; rewriting it
+        // would break it. A single letter before the colon is a Windows drive, not a scheme.
+        var css = "a{background-image:url(\"file:///c:/x.png\")}"
+                + "b{background-image:url(data:image/png;base64,AAA)}"
+                + "c{background-image:url(resource:///org/app/x.png)}"
+                + "d{background-image:url(https://example.invalid/x.png)}"
+                + "e{fill:url(#grad)}"
+                + "f{background-image:url()}";
+
+        Assert.Equal(css, CssUri.ResolveUrls(css, _root));
+    }
+
+    [Fact]
+    public void TheFirstBaseDirectoryHoldingTheTarget_Wins()
+    {
+        // The working directory keeps the Gtk3 contract; the application directory is the fallback for the
+        // case Gtk3 got wrong - an app launched from somewhere else.
+        var elsewhere = Path.Combine(_root, "elsewhere");
+        Directory.CreateDirectory(elsewhere);
+        File.WriteAllText(Path.Combine(elsewhere, "found.css"), "#y{color:#fff}");
+
+        var resolved = CssUri.ResolveUrls("@import url(\"found.css\");", _root, elsewhere);
+
+        Assert.Contains($"url(\"{Uri(Path.Combine(elsewhere, "found.css"))}\")", resolved);
+    }
+
+    [Fact]
+    public void AMissingTarget_StillBecomesAbsolute()
+    {
+        // Gtk marks an unresolvable reference invalid either way; emitting the URI keeps the failure
+        // diagnosable instead of turning the declaration into a no-op.
+        var resolved = CssUri.ResolveUrls("#x{background-image:url(\"gone.png\")}", _root);
+
+        Assert.Contains($"url(\"{Uri(Path.Combine(_root, "gone.png"))}\")", resolved);
+    }
+
+    [Fact]
+    public void AnImportedSheetAndItsImages_ReachTheGtk4Parser()
+    {
+        // The oracle is Gtk4's own parser: the dump of a provider tells whether the imported sheet exists
+        // at all, and how it printed the image - "invalid image" is Gtk's marker for a url() it could not
+        // resolve, so it distinguishes "the rule loaded" from "the rule loaded and its image resolved".
+        var probe = Path.Combine(_root, "sub", "p.png");
+        Directory.CreateDirectory(Path.GetDirectoryName(probe)!);
+        using (var pixbuf = new Gdk.Pixbuf(Gdk.Colorspace.Rgb, true, 8, 1, 1))
+        {
+            pixbuf.Savev(probe, "png", new string[] { }, new string[] { });
+        }
+
+        File.WriteAllText(Path.Combine(_root, "a.css"), "#probe{background-image:url(\"sub/p.png\")}");
+        var rootCss = Path.Combine(_root, "root.css");
+        File.WriteAllText(rootCss, "@import url(\"a.css\");");
+        var text = File.ReadAllText(rootCss);
+
+        var asIs = new Gtk.CssProvider();
+        asIs.LoadFromData(text);
+
+        Assert.DoesNotContain("#probe", asIs.ToString());
+
+        var resolved = new Gtk.CssProvider();
+        resolved.LoadFromData(CssUri.ResolveUrls(text, _root));
+        var dump = resolved.ToString();
+
+        Assert.Contains("#probe", dump);
+        Assert.DoesNotContain("invalid image", dump);
+    }
+
+    [Fact]
+    public void AControlImage_ResolvesToAnImageGtkCanLoad()
+    {
+        // Control.SetStyle writes the Image to a PNG and points background/background-image at it. The
+        // BackgroundImage-only branch was already made absolute; the Image branches were not, so a Button
+        // with an Image produced a declaration Gtk quietly discarded. Gtk's own dump is the oracle:
+        // "none /* FIXME */" is a resolved url() it has yet to load, "none /* invalid image */" is one it
+        // could not resolve at all.
+        using var pixbuf = new Gdk.Pixbuf(Gdk.Colorspace.Rgb, true, 8, 4, 4);
+        var button = new Button
+        {
+            Name = "cssUrlResolutionProbe",
+            Image = new gtk::System.Drawing.Bitmap(4, 4) { Pixbuf = pixbuf },
+            ImageAlign = gtk::System.Drawing.ContentAlignment.TopCenter,
+        };
+
+        try
+        {
+            var setStyle = typeof(Control).GetMethod(
+                "SetStyle",
+                BindingFlags.Instance | BindingFlags.NonPublic,
+                null,
+                new[] { typeof(Gtk.Widget) },
+                null)!;
+            setStyle.Invoke(button, new object[] { button.Widget! });
+
+            var provider = (Gtk.CssProvider)typeof(Control)
+                .GetField("provider", BindingFlags.Instance | BindingFlags.NonPublic)!
+                .GetValue(button)!;
+            var dump = provider.ToString();
+
+            Assert.Contains("background-image: none /* FIXME */", dump);
+            Assert.DoesNotContain("invalid image", dump);
+        }
+        finally
+        {
+            // SetStyle materialises the image under Resources/<name>/ in the working directory.
+            try
+            {
+                Directory.Delete(Path.Combine("Resources", "cssUrlResolutionProbe"), true);
+            }
+            catch (IOException)
+            {
+                // Leftovers are harmless.
+            }
+            catch (UnauthorizedAccessException)
+            {
+                // Leftovers are harmless.
+            }
+        }
+    }
+
+    /// <summary>
+    /// The absolute URI form the resolver is expected to emit for a path.
+    /// </summary>
+    private static string Uri(string path) => new System.Uri(Path.GetFullPath(path)).AbsoluteUri;
+}
