From 7bdd65c37ba4f26b82576a6e88b8374b9d6e6c50 Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Date: Sat, 25 Jul 2026 08:12:18 +0300
Subject: [PATCH] Add MdiClient (MDI child container)

Closes API-COMPLETENESS.md P1 item 2 (MdiClient) and the nested
MdiClient.ControlCollection. The type was absent, so form.MdiClient, is MdiClient
and LayoutMdi did not compile - and because MdiClient derives from Control, ~500
inherited members were reported missing with it.

Implemented as a scrollable Control-derived container (mirroring Panel's GTK
backing) whose children are the MDI child windows. LayoutMdi arranges them:
Cascade steps each child down and to the right, TileHorizontal/TileVertical
split the client area into rows/columns, ArrangeIcons is a no-op (no minimized-
icon representation on this layer).

Covered by MdiClientFunctionalTests (is-a-Control with a child collection,
cascade offset, horizontal tiling, empty-client safety, nested collection ctor).
Full Forms suite green at 2480.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 .../Windows/Forms/MdiClientFunctionalTests.cs |  80 +++++++++++++
 .../System/Windows/Forms/MdiClient.cs         | 109 ++++++++++++++++++
 2 files changed, 189 insertions(+)
 create mode 100644 Gtk.Windows.Forms.Tests/System/Windows/Forms/MdiClientFunctionalTests.cs
 create mode 100644 Gtk.Windows.Forms/System/Windows/Forms/MdiClient.cs

diff --git a/Gtk.Windows.Forms.Tests/System/Windows/Forms/MdiClientFunctionalTests.cs b/Gtk.Windows.Forms.Tests/System/Windows/Forms/MdiClientFunctionalTests.cs
new file mode 100644
index 00000000..80456b14
--- /dev/null
+++ b/Gtk.Windows.Forms.Tests/System/Windows/Forms/MdiClientFunctionalTests.cs
@@ -0,0 +1,80 @@
+using System.Windows.Forms;
+
+namespace GtkWinForms.Tests.System.Windows.Forms;
+
+/// <summary>
+/// Tests for <see cref="MdiClient"/> (§4 of API-COMPLETENESS). The type was absent, so <c>is MdiClient</c>,
+/// type references and <c>LayoutMdi</c> did not compile. It is a Control-derived scrollable container; the
+/// tests pin that it is a Control with a working child collection, that LayoutMdi cascades and tiles its
+/// children, and that the nested ControlCollection constructs.
+/// </summary>
+[Collection("NonParallelCollection")]
+public class MdiClientFunctionalTests
+{
+    static MdiClientFunctionalTests()
+    {
+        using var _ = new Form();
+    }
+
+    [Fact]
+    public void MdiClient_IsAControl_WithAChildCollection()
+    {
+        using var client = new MdiClient();
+
+        Assert.IsAssignableFrom<Control>(client);
+        Assert.NotNull(client.Controls);
+    }
+
+    [Fact]
+    public void LayoutMdi_Cascade_StepsEachChildDownAndRight()
+    {
+        using var client = new MdiClient();
+        client.Size = new global::System.Drawing.Size(400, 300);
+        var a = new Button();
+        var b = new Button();
+        client.Controls.Add(a);
+        client.Controls.Add(b);
+
+        client.LayoutMdi(MdiLayout.Cascade);
+
+        // The second child is offset from the first by the cascade step in both axes.
+        Assert.True(b.Left > a.Left, "cascade must step the second child to the right");
+        Assert.True(b.Top > a.Top, "cascade must step the second child down");
+    }
+
+    [Fact]
+    public void LayoutMdi_TileHorizontal_StacksChildrenVertically()
+    {
+        using var client = new MdiClient();
+        client.Size = new global::System.Drawing.Size(400, 300);
+        var a = new Button();
+        var b = new Button();
+        client.Controls.Add(a);
+        client.Controls.Add(b);
+
+        client.LayoutMdi(MdiLayout.TileHorizontal);
+
+        // Horizontal tiling puts each child in its own full-width row, so the second sits below the first.
+        Assert.True(b.Top > a.Top, "the second child must be in a lower row");
+    }
+
+    [Fact]
+    public void LayoutMdi_WithNoChildren_DoesNotThrow()
+    {
+        using var client = new MdiClient();
+
+        var ex = Record.Exception(() => client.LayoutMdi(MdiLayout.Cascade));
+
+        Assert.Null(ex);
+    }
+
+    [Fact]
+    public void NestedControlCollection_ConstructsForItsOwner()
+    {
+        using var client = new MdiClient();
+
+        var collection = new MdiClient.ControlCollection(client);
+
+        Assert.NotNull(collection);
+    }
+}
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/MdiClient.cs b/Gtk.Windows.Forms/System/Windows/Forms/MdiClient.cs
new file mode 100644
index 00000000..aead1c8c
--- /dev/null
+++ b/Gtk.Windows.Forms/System/Windows/Forms/MdiClient.cs
@@ -0,0 +1,109 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+using System.Collections.Generic;
+using System.Drawing;
+using GtkSystem.Windows.Forms.GtkControls.ControlBase;
+
+namespace System.Windows.Forms;
+
+/// <summary>
+/// Represents the container that an MDI (multiple-document interface) parent form uses to host its child
+/// forms. The type was absent, so <c>form.MdiClient</c>, <c>is MdiClient</c> and <c>LayoutMdi</c> did not
+/// compile. It is a scrollable container whose children are the MDI child windows; <see cref="LayoutMdi" />
+/// cascades or tiles them.
+/// </summary>
+public sealed class MdiClient : ScrollableControl
+{
+    /// <summary>The backing GTK container widget.</summary>
+    public readonly PanelBase self = new();
+
+    private readonly Control.ControlCollection _controls;
+
+    /// <summary>Initializes a new instance of the <see cref="MdiClient" /> class.</summary>
+    public MdiClient() : base()
+    {
+        self.Override.sender = this;
+        _controls = new Control.ControlCollection(this, self.contaner);
+    }
+
+    /// <summary>Gets the collection of MDI child controls hosted by this client.</summary>
+    public override Control.ControlCollection Controls => _controls;
+
+    /// <summary>Gets the underlying GTK widget.</summary>
+    public override object GtkControl => self;
+
+    /// <summary>Arranges the MDI child forms within the client according to <paramref name="value" />.</summary>
+    /// <param name="value">The layout to apply.</param>
+    public void LayoutMdi(MdiLayout value)
+    {
+        if (_controls == null || _controls.Count == 0)
+        {
+            return;
+        }
+
+        var children = new List<Control>();
+        foreach (Control child in _controls)
+        {
+            children.Add(child);
+        }
+
+        var area = ClientRectangle;
+        if (area.Width <= 0 || area.Height <= 0)
+        {
+            area = new Rectangle(0, 0, Math.Max(1, Width), Math.Max(1, Height));
+        }
+
+        switch (value)
+        {
+            case MdiLayout.Cascade:
+                // Each child steps down and to the right by one title-bar height.
+                const int step = 24;
+                for (var i = 0; i < children.Count; i++)
+                {
+                    var offset = i * step;
+                    var w = Math.Max(1, area.Width - offset - step);
+                    var h = Math.Max(1, area.Height - offset - step);
+                    children[i].SetBounds(area.X + offset, area.Y + offset, w, h, BoundsSpecified.All);
+                }
+
+                break;
+
+            case MdiLayout.TileHorizontal:
+                {
+                    var rowHeight = Math.Max(1, area.Height / children.Count);
+                    for (var i = 0; i < children.Count; i++)
+                    {
+                        children[i].SetBounds(area.X, area.Y + i * rowHeight, area.Width, rowHeight, BoundsSpecified.All);
+                    }
+
+                    break;
+                }
+
+            case MdiLayout.TileVertical:
+                {
+                    var colWidth = Math.Max(1, area.Width / children.Count);
+                    for (var i = 0; i < children.Count; i++)
+                    {
+                        children[i].SetBounds(area.X + i * colWidth, area.Y, colWidth, area.Height, BoundsSpecified.All);
+                    }
+
+                    break;
+                }
+
+            case MdiLayout.ArrangeIcons:
+                // Minimized-child icon arrangement has no representation on this layer.
+                break;
+        }
+    }
+
+    /// <summary>Represents the collection of controls (MDI child windows) hosted by an <see cref="MdiClient" />.</summary>
+    public new class ControlCollection : Control.ControlCollection
+    {
+        /// <summary>Initializes a new instance for the given owner.</summary>
+        /// <param name="owner">The owning <see cref="MdiClient" />.</param>
+        public ControlCollection(MdiClient owner) : base(owner)
+        {
+        }
+    }
+}
