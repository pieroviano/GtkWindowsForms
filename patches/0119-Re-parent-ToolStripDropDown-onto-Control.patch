From e92d6124cc6ff9899c11967e33fa344733963367 Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Date: Sat, 25 Jul 2026 19:15:50 +0300
Subject: [PATCH] Re-parent ToolStripDropDown onto ToolStrip/Control (P0
 structural fix)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Closes API-COMPLETENESS.md's §2/§8 P0 — the single biggest lever in the diff.
ToolStripDropDown derived from ToolStripItem; real WinForms has it derive from
ToolStrip : ScrollableControl : Control, so every drop-down and ContextMenuStrip
was missing the entire Control surface (~670 member gaps across ToolStripDropDown
382->153, ContextMenuStrip 374->150, ToolStripDropDownMenu 374->150).

The fix turned out contained, not the deep surgery feared: ToolStripDropDown is
not used as a ToolStripItem anywhere, so change its base to ToolStrip, hide the
inherited toolbar-box `self` with `new StripDropDown self` (the native Gtk.Menu),
and override GtkControl to return it so the inherited Control plumbing targets
the menu. The only other edit is ToolStripItemCollection's drop-down ctor, which
now reaches the menu via GtkControl instead of the old ToolStripItem-style
Widget.MenuItem. The menu model itself (items added through a menu item's
DropDownItems, routed to the Gtk.Menu) is unchanged.

Covered by ToolStripDropDownReparentFunctionalTests (is-a Control, the Control
surface resolves, menu population still works). Full Forms suite green at 2494,
Drawing at 1216.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 ...oolStripDropDownReparentFunctionalTests.cs | 57 +++++++++++++++++++
 .../Forms/MenuStripBase/ToolStripDropDown.cs  | 28 +++------
 .../MenuStripBase/ToolStripItemCollection.cs  |  5 +-
 3 files changed, 69 insertions(+), 21 deletions(-)
 create mode 100644 Net4x.Gtk.Windows.Forms.Tests/System/Windows/Forms/ToolStripDropDownReparentFunctionalTests.cs

diff --git a/Net4x.Gtk.Windows.Forms.Tests/System/Windows/Forms/ToolStripDropDownReparentFunctionalTests.cs b/Net4x.Gtk.Windows.Forms.Tests/System/Windows/Forms/ToolStripDropDownReparentFunctionalTests.cs
new file mode 100644
index 00000000..9000a96c
--- /dev/null
+++ b/Net4x.Gtk.Windows.Forms.Tests/System/Windows/Forms/ToolStripDropDownReparentFunctionalTests.cs
@@ -0,0 +1,57 @@
+using System.Windows.Forms;
+
+namespace Net4x.Gtk.Windows.Forms.Tests.System.Windows.Forms;
+
+/// <summary>
+/// Pins the §2 structural fix: <see cref="ToolStripDropDown"/> now derives from <see cref="ToolStrip"/> →
+/// <see cref="Control"/> (it was a <c>ToolStripItem</c>), so a drop-down and every <see cref="ContextMenuStrip"/>
+/// carry the whole <c>Control</c> surface. The drop-down keeps its native <c>Gtk.Menu</c> backing, so the
+/// existing menu model — adding items through a menu item's <c>DropDownItems</c> — must still work.
+/// </summary>
+[Collection("NonParallelCollection")]
+public class ToolStripDropDownReparentFunctionalTests
+{
+    static ToolStripDropDownReparentFunctionalTests()
+    {
+        using var _ = new Form();
+    }
+
+    [Fact]
+    public void ToolStripDropDown_IsNowAControl()
+    {
+        using var dropDown = new ToolStripDropDown();
+
+        Assert.IsAssignableFrom<ToolStrip>(dropDown);
+        Assert.IsAssignableFrom<Control>(dropDown);
+    }
+
+    [Fact]
+    public void ContextMenuStrip_IsAControl_WithTheControlSurface()
+    {
+        using var menu = new ContextMenuStrip();
+
+        Assert.IsAssignableFrom<Control>(menu);
+
+        // A representative slice of the Control surface that was previously missing from every drop-down:
+        // events and properties now resolve and can be used.
+        var backColorChanges = 0;
+        menu.BackColorChanged += (_, _) => backColorChanges++;
+        menu.Text = "ctx";
+        Assert.Equal("ctx", menu.Text);
+    }
+
+    [Fact]
+    public void MenuModelStillWorks_ItemsAddedThroughDropDownItems()
+    {
+        // The native-menu population path (a menu item owning a drop-down) is unchanged by the re-parent.
+        using var parent = new ToolStripMenuItem("File");
+        var open = new ToolStripMenuItem("Open");
+        var save = new ToolStripMenuItem("Save");
+
+        parent.DropDownItems.Add(open);
+        parent.DropDownItems.Add(save);
+
+        Assert.Equal(2, parent.DropDownItems.Count);
+        Assert.Same(open, parent.DropDownItems[0]);
+    }
+}
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripDropDown.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripDropDown.cs
index 339e6f98..f18ac0be 100644
--- a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripDropDown.cs
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripDropDown.cs
@@ -13,12 +13,14 @@ namespace System.Windows.Forms;
 /// <see cref="!:System.Windows.Forms.Menu" />
 /// is retained for both backward compatibility and future use if you choose.
 /// </summary>
-public class ToolStripDropDown : ToolStripItem
+public class ToolStripDropDown : ToolStrip
 {
     /// <summary>
-    /// The self
+    /// The self — a native GTK popup menu. Hides <see cref="ToolStrip" />'s toolbar-box <c>self</c>; the
+    /// drop-down is rendered as a real <c>Gtk.Menu</c> while inheriting the <see cref="Control" /> API
+    /// surface from <see cref="ToolStrip" />.
     /// </summary>
-    public StripDropDown self = new StripDropDown();
+    public new StripDropDown self = new StripDropDown();
 
     /// <summary>
     /// Initializes a new instance of the
@@ -30,22 +32,8 @@ public class ToolStripDropDown : ToolStripItem
     }
 
     /// <summary>
-    /// Gets or sets the size of the image scaling.
+    /// Gets the underlying GTK control — the native popup menu, so the inherited <see cref="Control" />
+    /// plumbing targets it rather than the toolbar box.
     /// </summary>
-    /// <value>
-    /// The size of the image scaling.
-    /// </value>
-    public Size ImageScalingSize
-    {
-        get;
-        set;
-    }
-
-    /// <summary>
-    /// Gets the widget.
-    /// </summary>
-    /// <value>
-    /// The widget.
-    /// </value>
-    public override IToolMenuItem Widget { get => self; }
+    public override object GtkControl => self;
 }
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripItemCollection.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripItemCollection.cs
index de9eb2a3..33444a90 100644
--- a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripItemCollection.cs
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripItemCollection.cs
@@ -80,7 +80,10 @@ public class ToolStripItemCollection : List<ToolStripItem>, ICollection, IEnumer
     /// </param>
     public ToolStripItemCollection(ToolStripDropDown owner)
     {
-        this.menu = owner.Widget.MenuItem as Gtk.Menu;
+        // The drop-down's GtkControl is its native Gtk.Menu (StripDropDown). It used to be reached via the
+        // ToolStripItem-style Widget.MenuItem; now that ToolStripDropDown derives from ToolStrip/Control the
+        // menu is the GtkControl directly.
+        this.menu = owner.GtkControl as Gtk.Menu;
         isToolStripDropDown = true;
     }
 
