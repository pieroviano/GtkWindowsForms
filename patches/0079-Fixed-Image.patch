From f461019d08525a984568f5669c41269066e02908 Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Date: Sun, 12 Apr 2026 07:10:30 +0300
Subject: [PATCH] Fixed Image

---
 Net4x.Gtk.Drawing/System/Drawing/Image.cs | 91 +++++++++++++++++++++--
 1 file changed, 85 insertions(+), 6 deletions(-)

diff --git a/Net4x.Gtk.Drawing/System/Drawing/Image.cs b/Net4x.Gtk.Drawing/System/Drawing/Image.cs
index 58e9138..647942f 100644
--- a/Net4x.Gtk.Drawing/System/Drawing/Image.cs
+++ b/Net4x.Gtk.Drawing/System/Drawing/Image.cs
@@ -102,7 +102,26 @@ public abstract class Image : Gtk.Widget, IDisposable, ICloneable, ISerializable
     public string? FileName
     {
         get => _fileName;
-        set { _fileName = value; Pixbuf = new Gdk.Pixbuf(value); }
+        set
+        {
+            _fileName = value;
+            if (!string.IsNullOrEmpty(value))
+            {
+                try
+                {
+                    Pixbuf = new Gdk.Pixbuf(value);
+                }
+                catch (GLib.GException ex)
+                {
+                    System.Diagnostics.GtkLogger.Debug($"Failed to load Pixbuf from file '{value}'", ex);
+                    Pixbuf = null;
+                }
+            }
+            else
+            {
+                Pixbuf = null;
+            }
+        }
     }
 
     /// <summary>
@@ -166,7 +185,7 @@ public abstract class Image : Gtk.Widget, IDisposable, ICloneable, ISerializable
 
     /// <summary>
     /// Gets the physical dimensions of this image in the units of
-    /// <see cref="T:System.Drawing.SizeF" />.
+    /// <see cref="T:System.Drawing.SizeF"/>.
     /// </summary>
     public SizeF PhysicalDimension
     {
@@ -188,14 +207,43 @@ public abstract class Image : Gtk.Widget, IDisposable, ICloneable, ISerializable
     {
         get
         {
-            if (_Pixbuf == null && _PixbufData != null) { _Pixbuf = new Gdk.Pixbuf(_PixbufData); }
+            if (_Pixbuf == null && _PixbufData != null)
+            {
+                try
+                {
+                    _Pixbuf = new Gdk.Pixbuf(_PixbufData);
+                }
+                catch (GLib.GException ex)
+                {
+                    System.Diagnostics.GtkLogger.Debug("Failed to create Pixbuf from PixbufData", ex);
+                    // If pixbuf creation fails, clear the underlying data to avoid repeated failures.
+                    _PixbufData = null;
+                    _Pixbuf = null;
+                }
+            }
 
             return _Pixbuf;
         }
         set
         {
             _Pixbuf = value;
-            if (value != null) _PixbufData = value.SaveToBuffer("bmp");
+            if (value != null)
+            {
+                try
+                {
+                    _PixbufData = value.SaveToBuffer("bmp");
+                }
+                catch (GLib.GException ex)
+                {
+                    System.Diagnostics.GtkLogger.Debug("Pixbuf.SaveToBuffer failed in Image.Pixbuf setter", ex);
+                    // keep Pixbuf but clear PixbufData to avoid using invalid buffer
+                    _PixbufData = null;
+                }
+            }
+            else
+            {
+                _PixbufData = null;
+            }
         }
     }
 
@@ -207,11 +255,42 @@ public abstract class Image : Gtk.Widget, IDisposable, ICloneable, ISerializable
     {
         get
         {
-            if (_PixbufData == null && _Pixbuf != null) { _PixbufData = _Pixbuf.SaveToBuffer("bmp"); }
+            if (_PixbufData == null && _Pixbuf != null)
+            {
+                try
+                {
+                    _PixbufData = _Pixbuf.SaveToBuffer("bmp");
+                }
+                catch (GLib.GException ex)
+                {
+                    System.Diagnostics.GtkLogger.Debug("Pixbuf.SaveToBuffer failed in Image.PixbufData getter", ex);
+                    _PixbufData = null;
+                }
+            }
 
             return _PixbufData;
         }
-        set { _PixbufData = value; _Pixbuf = new Gdk.Pixbuf(value); }
+        set
+        {
+            _PixbufData = value;
+            if (value != null)
+            {
+                try
+                {
+                    _Pixbuf = new Gdk.Pixbuf(value);
+                }
+                catch (GLib.GException ex)
+                {
+                    System.Diagnostics.GtkLogger.Debug("Failed to create Pixbuf from PixbufData in setter", ex);
+                    _Pixbuf = null;
+                    _PixbufData = null;
+                }
+            }
+            else
+            {
+                _Pixbuf = null;
+            }
+        }
     }
 
     /// <summary>
-- 
2.51.1.windows.1

