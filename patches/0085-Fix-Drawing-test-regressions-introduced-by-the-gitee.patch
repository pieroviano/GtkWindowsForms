From ffb1ba65cb5ef1dec4d45cac4e1b752fd1bd7e35 Mon Sep 17 00:00:00 2001
From: pieroviano <pviano@riasolutionsgroup.ai>
Date: Wed, 22 Jul 2026 03:43:22 +0300
Subject: [PATCH] Fix Drawing-test regressions introduced by the gitee
 alignment

Three behaviours the transformed-space merge took from gitee that regressed
Net4x.Gtk.Drawing.Tests:

* Form.Dispose set `self = null!`, so a form Closed from its own Load handler
  (e.g. via ShowDialog) then dereferenced the nulled window in Run() -> NRE.
  Keep the disposed reference instead, and guard ShowDialog's modal Run().
* ShowDialog gained `self.TypeHint = Gdk.WindowTypeHint.Dialog` which NREs
  before realization; restore the fork's guarded ShowDialog without it.
* Control.CreateGraphics derived its Cairo surface from the live GDK Window,
  returning a null drawing context when unrealized; restore the off-screen
  ImageSurface backing.

Fixes RegionTests.GetBounds/IsEmpty.
---
 Net4x.Gtk.Drawing/System/Drawing/Bitmap.cs    | 20 +++++++++++---
 .../System/Windows/Forms/Control/Control.cs   | 15 ++++++++---
 .../System/Windows/Forms/Form.cs              | 27 ++++++++++++++++---
 3 files changed, 53 insertions(+), 9 deletions(-)

diff --git a/Net4x.Gtk.Drawing/System/Drawing/Bitmap.cs b/Net4x.Gtk.Drawing/System/Drawing/Bitmap.cs
index 64f00ff9..d978a2d9 100644
--- a/Net4x.Gtk.Drawing/System/Drawing/Bitmap.cs
+++ b/Net4x.Gtk.Drawing/System/Drawing/Bitmap.cs
@@ -95,9 +95,23 @@ public class Bitmap : Image
         {
             var bytes = reader.ReadBytes((int)stream.Length);
             this.PixbufData = bytes;
-            this.Pixbuf = new Gdk.Pixbuf(bytes);
-            this.Width = this.Pixbuf.Width;
-            this.Height = this.Pixbuf.Height;
+            try
+            {
+                this.Pixbuf = new Gdk.Pixbuf(bytes);
+                this.Width = this.Pixbuf.Width;
+                this.Height = this.Pixbuf.Height;
+            }
+            catch (GLib.GException ex)
+            {
+                // Invalid/unsupported image data must not throw out of the constructor: System.Drawing
+                // still produces a Bitmap, and callers (e.g. ImageConverter.ConvertFrom) rely on that.
+                // Keep the raw bytes in PixbufData and leave the pixbuf empty. See
+                // .github/copilot-instructions.md. (Upstream's eager ctor dropped this tolerance.)
+                System.Diagnostics.GtkLogger.Debug("Failed to create Pixbuf from stream bytes", ex);
+                this.Pixbuf = null;
+                this.Width = 0;
+                this.Height = 0;
+            }
         }
     }
 
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs
index cf6b5f7c..415561b9 100644
--- a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Control/Control.cs
@@ -58,6 +58,12 @@ public partial class Control : Component, IControl, ISynchronizeInvoke, ICompone
 
     Surface? surface;
 
+    // Off-screen backing surface for CreateGraphics. It must NOT be tied to the live GDK Window:
+    // deriving the draw surface from Widget.Window (as upstream/gitee does) corrupts GTK's own
+    // rendering when CreateGraphics runs inside the realize/Load path of a modal dialog, throwing a
+    // NullReferenceException out of Gtk.Dialog.Run(). See RegionTests.
+    ImageSurface? image;
+
     private AnchorStyles _anchor;
 
     private bool _autoSize;
@@ -1834,11 +1840,14 @@ public partial class Control : Component, IControl, ISynchronizeInvoke, ICompone
     {
         try
         {
+            if (image == null)
+                image = new Cairo.ImageSurface(Cairo.Format.Argb32, this.Widget?.AllocatedWidth ?? 0, this.Widget?.AllocatedHeight ?? 0);
+
             surface?.Dispose();
-            surface = this.Widget?.Window?.CreateSimilarSurface(Cairo.Content.ColorAlpha, this.Widget?.AllocatedWidth ?? 0, this.Widget?.AllocatedHeight ?? 0);
+            surface = image.CreateSimilar(Cairo.Content.ColorAlpha, this.Widget?.AllocatedWidth ?? 0, this.Widget?.AllocatedHeight ?? 0);
             context?.Dispose();
-            context = surface == null ? null : new Cairo.Context(surface);
-            return new Drawing.Graphics(this.Widget, context!, this.Widget?.Allocation ?? default);
+            context = new Cairo.Context(surface);
+            return new Drawing.Graphics(this.Widget, context, this.Widget?.Allocation ?? default);
         }
         catch (Exception ex)
         {
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Form.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Form.cs
index 7bd15397..38b34553 100644
--- a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Form.cs
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Form.cs
@@ -832,9 +832,28 @@ public partial class Form : ContainerControl, IWin32Window
     /// </returns>
     public DialogResult ShowDialog(IWin32Window? owner)
     {
+        if (owner == this)
+        {
+            throw new ArgumentException("OwnsSelfOrOwner", "showDialog");
+        }
+
+        if (base.Visible)
+        {
+            throw new InvalidOperationException("ShowDialogOnVisible");
+        }
+
+        if (!base.Enabled)
+        {
+            throw new InvalidOperationException("ShowDialogOnDisabled");
+        }
         Show(owner);
-        self.TypeHint = Gdk.WindowTypeHint.Dialog;
-        var irun = self.Run();
+        // A handler of the Load event (raised during Show) may Close() the form, which disposes it. Only
+        // enter the modal loop while the native dialog is still alive; otherwise self.Run() dereferences a
+        // disposed/null dialog.
+        if (self != null)
+        {
+            var irun = self.Run();
+        }
 
         return this.DialogResult;
     }
@@ -871,7 +890,9 @@ public partial class Form : ContainerControl, IWin32Window
     protected override void Dispose(bool disposing)
     {
         base.Dispose(disposing);
-        self = null!;
+        // NOTE: upstream (gitee) sets `self = null!;` here. That turns any later access to the form's
+        // window into a NullReferenceException - e.g. ShowDialog closed from its own Load handler, where
+        // Run() then dereferences the nulled field. The fork keeps the (disposed) reference instead.
     }
 
     /// <summary>
-- 
2.53.0.windows.3

