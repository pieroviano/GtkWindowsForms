From 61e5ef935695153049e557af4aa7578fc5fdc130 Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Date: Sun, 5 Apr 2026 05:20:15 +0300
Subject: [PATCH] Fix Application

---
 .../Windows/Forms/Application/Application.cs  | 34 +++++++++++++++----
 1 file changed, 28 insertions(+), 6 deletions(-)

diff --git a/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs b/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs
index 1081448..a1bf8ea 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs
@@ -35,6 +35,8 @@ public sealed class Application
         private set;
     }
 
+    public static bool DontQuit { get; set; }
+
     /// <summary>
     /// Gets the common application data path.
     /// </summary>
@@ -208,18 +210,19 @@ public sealed class Application
             {
                 if (e == null)
                 {
-                    Gtk.Application.Quit();
+                    Quit();
                 }
                 else
                 {
                     if (e.Cancel == false)
                     {
-                        Gtk.Application.Quit();
+                        Quit();
                     }
                 }
             }
             finally
             {
+                GtkLogger.Info("Application quitting");
             }
         }
     }
@@ -233,8 +236,7 @@ public sealed class Application
         {
             try
             {
-
-                Gtk.Application.Quit();
+                Quit();
             }
             finally
             {
@@ -509,7 +511,7 @@ public sealed class Application
     private static void App_Shutdown(object sender, EventArgs e)
     {
         GtkLogger.Info("App_Shutdown");
-        Gtk.Application.Quit();
+        Quit();
     }
 
     private static void Control_Destroyed(object sender, EventArgs e)
@@ -519,6 +521,26 @@ public sealed class Application
 
     private static void QuitActivated(object sender, EventArgs e)
     {
-        Gtk.Application.Quit();
+        Quit();
+    }
+
+    public static void Quit()
+    {
+        if (!DontQuit)
+        {
+#if DEBUG_QUIT
+            if (!Debugger.IsAttached)
+            {
+                Debugger.Launch();
+            }
+#endif
+            Gtk.Application.Quit();
+        }
+    }
+
+    public static void Init(bool dontQuit)
+    {
+        Forms.Application.DontQuit = dontQuit;
+        Application.Init();
     }
 }
\ No newline at end of file
-- 
