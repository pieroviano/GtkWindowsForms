From 61d939fb1e54976e7e9456f4fb18bd32bcbd8401 Mon Sep 17 00:00:00 2001
From: pviano-ria <pviano@riasolutionsgroup.ai>
Date: Wed, 11 Nov 2026 09:00:24 +0200
Subject: [PATCH] Route bypassed events through their OnXxx methods
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Several GTK signal handlers raised events directly instead of through the
control's OnXxx method, so OnXxx overrides never ran — the same defect fixed
for LinkLabel. Funnel each through its OnXxx (and make the event sender the
control, as in classic WinForms):

- CheckedListBox.Control_ChildActivated -> OnSelectedIndexChanged /
  OnSelectedValueChanged / OnSelectedItemChanged
- DataGridView data-bind + realize -> OnDataBindingComplete /
  OnAllowUserToOrderColumnsChanged / OnAllowUserToResizeColumnsChanged
- ListView checkbox toggle -> OnItemCheck / OnItemChecked
- ApplicationContext.ExitThreadCore -> OnThreadExit
- PropertyGridView.Selection_Changed -> OnSelectedGridItemChanged

CheckedListBox's handler is widened to internal so a test can drive it.
---
 .../Windows/Forms/Application/ApplicationContext.cs |  2 +-
 .../System/Windows/Forms/CheckedListBox.cs          | 13 +++++++++----
 .../System/Windows/Forms/DataGridView.cs            |  6 +++---
 Gtk.Windows.Forms/System/Windows/Forms/ListView.cs  |  6 ++++--
 .../PropertyGridBase/PropertyGridView.cs            |  4 +++-
 5 files changed, 20 insertions(+), 11 deletions(-)

diff --git a/Gtk.Windows.Forms/System/Windows/Forms/Application/ApplicationContext.cs b/Gtk.Windows.Forms/System/Windows/Forms/Application/ApplicationContext.cs
index 9201d51b..c29bc5f6 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/Application/ApplicationContext.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/Application/ApplicationContext.cs
@@ -121,7 +121,7 @@ public class ApplicationContext : IDisposable
     /// <summary>
     /// Causes the thread's message loop to be terminated.
     /// </summary>
-    protected virtual void ExitThreadCore() => ThreadExit?.Invoke(this, EventArgs.Empty);
+    protected virtual void ExitThreadCore() => OnThreadExit(EventArgs.Empty);
 
     /// <summary>
     /// Called when the mainForm is closed. The default implementation
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/CheckedListBox.cs b/Gtk.Windows.Forms/System/Windows/Forms/CheckedListBox.cs
index 5e35c58b..cb0fb090 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/CheckedListBox.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/CheckedListBox.cs
@@ -403,11 +403,16 @@ public partial class CheckedListBox : ContainerControl
             item.WidthRequest = this.Width;
     }
 
-    private void Control_ChildActivated(object o, Gtk.ChildActivatedArgs args)
+    /// <summary>
+    /// Handles GTK's child-activated signal. It funnels each selection event through its
+    /// <c>OnXxx</c> method so overrides run, exactly as in classic WinForms; raising the events
+    /// directly here bypassed those overrides, so they never ran.
+    /// </summary>
+    internal void Control_ChildActivated(object o, Gtk.ChildActivatedArgs args)
     {
-        SelectedIndexChanged?.Invoke(this, args);
-        SelectedValueChanged?.Invoke(this, args);
-        SelectedItemChanged?.Invoke(this, args);
+        OnSelectedIndexChanged(EventArgs.Empty);
+        OnSelectedValueChanged(EventArgs.Empty);
+        OnSelectedItemChanged(EventArgs.Empty);
     }
 
     /// <summary>
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/DataGridView.cs b/Gtk.Windows.Forms/System/Windows/Forms/DataGridView.cs
index d029f31c..2a80fbde 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/DataGridView.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/DataGridView.cs
@@ -2495,7 +2495,7 @@ public partial class DataGridView : ScrollableControl
             {
                 LoadListSource();
             }
-            DataBindingComplete?.Invoke(this, new DataGridViewBindingCompleteEventArgs(ListChangedType.Reset));
+            OnDataBindingComplete(new DataGridViewBindingCompleteEventArgs(ListChangedType.Reset));
         }
         _Created = true;
     }
@@ -2519,8 +2519,8 @@ public partial class DataGridView : ScrollableControl
             Is_GridView_Realized = true;
             OnSetDataSource();
             _columns.Invalidate();
-            AllowUserToOrderColumnsChanged?.Invoke(this, EventArgs.Empty);
-            AllowUserToResizeColumnsChanged?.Invoke(this, EventArgs.Empty);
+            OnAllowUserToOrderColumnsChanged(EventArgs.Empty);
+            OnAllowUserToResizeColumnsChanged(EventArgs.Empty);
             foreach (Binding binding in DataBindings)
                 GridView.AddNotification(binding.PropertyName, propertyNotity);
 
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/ListView.cs b/Gtk.Windows.Forms/System/Windows/Forms/ListView.cs
index f51796bd..d8fcb326 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/ListView.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/ListView.cs
@@ -1668,10 +1668,12 @@ public class ListView : ContainerControl
         if (thisitem != null)
         {
             thisitem.Checked = box?.self.Active ?? false;
-            ItemCheck?.Invoke(sender!, new ItemCheckEventArgs(checkitem?.Index ?? -1, (box?.self.Active ?? false) ? CheckState.Checked : CheckState.Unchecked, (box?.self.Active ?? false) ? CheckState.Unchecked : CheckState.Checked));
+            // Funnel through OnItemCheck/OnItemChecked so overrides run and the event sender is the
+            // ListView, as in classic WinForms; raising the events directly bypassed those overrides.
+            OnItemCheck(new ItemCheckEventArgs(checkitem?.Index ?? -1, (box?.self.Active ?? false) ? CheckState.Checked : CheckState.Unchecked, (box?.self.Active ?? false) ? CheckState.Unchecked : CheckState.Checked));
             if ((box?.self.Active ?? false) == true)
             {
-                ItemChecked?.Invoke(sender!, new ItemCheckedEventArgs(thisitem));
+                OnItemChecked(new ItemCheckedEventArgs(thisitem));
             }
         }
     }
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/PropertyGridInternal/PropertyGridBase/PropertyGridView.cs b/Gtk.Windows.Forms/System/Windows/Forms/PropertyGridInternal/PropertyGridBase/PropertyGridView.cs
index d76eaf83..54cb144f 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/PropertyGridInternal/PropertyGridBase/PropertyGridView.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/PropertyGridInternal/PropertyGridBase/PropertyGridView.cs
@@ -405,7 +405,9 @@ internal sealed partial class PropertyGridView
         if (tree.IsSensitive && tree.Selection.GetSelected(out var model, out var oiter))
         {
             var propertyItem = store.GetValue(oiter, 0) as GridEntry;
-            SelectedGridItemChanged?.Invoke(sender, new SelectedGridItemChangedEventArgs(oldSelectedPropertyItem, propertyItem));
+            // Funnel through OnSelectedGridItemChanged instead of raising the event directly, so the
+            // single raise-point is honoured and the event sender is this grid view.
+            OnSelectedGridItemChanged(new SelectedGridItemChangedEventArgs(oldSelectedPropertyItem, propertyItem));
             oldSelectedPropertyItem = propertyItem;
         }
     }
-- 
