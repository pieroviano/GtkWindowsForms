From 01ceb7c7809ce7730a4d157082eee9e6cdce9024 Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Date: Fri, 10 Apr 2026 06:04:55 +0300
Subject: [PATCH] Fixed SolidBrush

---
 Gtk.Drawing/System/Drawing/Drawing2D/HatchBrush.cs | 2 +-
 Gtk.Drawing/System/Drawing/SolidBrush.cs           | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Gtk.Drawing/System/Drawing/Drawing2D/HatchBrush.cs b/Gtk.Drawing/System/Drawing/Drawing2D/HatchBrush.cs
index 107027e..ee36210 100644
--- a/Gtk.Drawing/System/Drawing/Drawing2D/HatchBrush.cs
+++ b/Gtk.Drawing/System/Drawing/Drawing2D/HatchBrush.cs
@@ -108,7 +108,7 @@ public sealed class HatchBrush : Brush
     /// The
     /// <see cref="T:System.Drawing.Drawing2D.HatchBrush" /> this method creates, cast as an object.
     /// </returns>
-    public override object? Clone()
+    public override object Clone()
     {
         // HatchBrush is immutable-like (stores simple properties),
         // so cloning simply creates a new instance with the same values.
diff --git a/Gtk.Drawing/System/Drawing/SolidBrush.cs b/Gtk.Drawing/System/Drawing/SolidBrush.cs
index b9db8b6..9aa2281 100644
--- a/Gtk.Drawing/System/Drawing/SolidBrush.cs
+++ b/Gtk.Drawing/System/Drawing/SolidBrush.cs
@@ -50,9 +50,9 @@ public sealed class SolidBrush : Brush
     /// The
     /// <see cref="T:System.Drawing.SolidBrush" /> object that this method creates.
     /// </returns>
-    public override object? Clone()
+    public override object Clone()
     {
-        return null;
+        return new SolidBrush(Color);
     }
 
     /// <summary>
-- 
2.51.1.windows.1

