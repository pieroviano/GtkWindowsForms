From 2fd7fe33ad0e044ccb0d287ee3fdebf9f6eb2788 Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Date: Sun, 5 Apr 2026 05:34:36 +0300
Subject: [PATCH] Added Clear to FormCollection

---
 .../Windows/Forms/Application/FormCollection.cs      | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/Gtk.Windows.Forms/System/Windows/Forms/Application/FormCollection.cs b/Gtk.Windows.Forms/System/Windows/Forms/Application/FormCollection.cs
index f03c7ea..124713f 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/Application/FormCollection.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/Application/FormCollection.cs
@@ -93,4 +93,16 @@ public class FormCollection : ReadOnlyCollectionBase
             InnerList.Remove(form);
         }
     }
+
+    public void Clear()
+    {
+        lock (CollectionSyncRoot)
+        {
+            foreach (Form form in InnerList)
+            {
+                form.Dispose();
+            }
+            InnerList.Clear();
+        }
+    }
 }
\ No newline at end of file
