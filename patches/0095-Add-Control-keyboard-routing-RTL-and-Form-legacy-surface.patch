diff --git a/Gtk.Windows.Forms.Tests/System/Windows/Forms/ControlExtensibilityFunctionalTests.cs b/Gtk.Windows.Forms.Tests/System/Windows/Forms/ControlExtensibilityFunctionalTests.cs
new file mode 100644
index 00000000..e6884514
--- /dev/null
+++ b/Gtk.Windows.Forms.Tests/System/Windows/Forms/ControlExtensibilityFunctionalTests.cs
@@ -0,0 +1,89 @@
+namespace System.Windows.Forms;
+
+extern alias gtk;
+
+/// <summary>
+/// Verifies the <see cref="Control" /> extensibility surface: right-to-left alignment translation, the
+/// keyboard-command routing chain (<c>ProcessKeyMessage</c>/<c>ProcessCmdKey</c>) and the parent-change
+/// notification override points. A <see cref="Panel" />-derived probe exposes the protected members; it is
+/// created inside a realized form (form first so GTK is initialized), with no clipboard interaction.
+/// </summary>
+[Collection("NonParallelCollection")]
+public class ControlExtensibilityFunctionalTests
+{
+    private sealed class KeyProbe : Panel
+    {
+        public bool KeyDownFired;
+
+        protected override void OnKeyDown(KeyEventArgs e)
+        {
+            KeyDownFired = true;
+            base.OnKeyDown(e);
+        }
+
+        public bool RunProcessKeyMessage(ref Message m) => ProcessKeyMessage(ref m);
+
+        public bool RunProcessCmdKey(ref Message m, Keys k) => ProcessCmdKey(ref m, k);
+
+        public HorizontalAlignment Rtl(HorizontalAlignment a) => RtlTranslateAlignment(a);
+
+        public gtk::System.Drawing.ContentAlignment RtlContent(gtk::System.Drawing.ContentAlignment a)
+            => RtlTranslateAlignment(a);
+    }
+
+    private sealed class CmdKeyParent : Panel
+    {
+        public Keys LastKey;
+
+        protected override bool ProcessCmdKey(ref Message msg, Keys keyData)
+        {
+            LastKey = keyData;
+            return true; // claim every command key
+        }
+    }
+
+    [Fact]
+    public void Extensibility_Behaves()
+    {
+        var form = new Form();
+        var parent = new CmdKeyParent();
+        var probe = new KeyProbe();
+        form.Controls.Add(parent);
+        parent.Controls.Add(probe);
+
+        form.Load += (s, e) =>
+        {
+            try
+            {
+                // --- RtlTranslate flips left/right only when RightToLeft is Yes ---
+                probe.RightToLeft = RightToLeft.No;
+                Assert.Equal(HorizontalAlignment.Left, probe.Rtl(HorizontalAlignment.Left));
+
+                probe.RightToLeft = RightToLeft.Yes;
+                Assert.Equal(HorizontalAlignment.Right, probe.Rtl(HorizontalAlignment.Left));
+                Assert.Equal(HorizontalAlignment.Left, probe.Rtl(HorizontalAlignment.Right));
+                Assert.Equal(HorizontalAlignment.Center, probe.Rtl(HorizontalAlignment.Center));
+                Assert.Equal(gtk::System.Drawing.ContentAlignment.TopRight,
+                    probe.RtlContent(gtk::System.Drawing.ContentAlignment.TopLeft));
+
+                // --- ProcessKeyMessage raises OnKeyDown for a WM_KEYDOWN message ---
+                var keyMsg = Message.Create(probe.Handle, 0x0100, (IntPtr)(int)Keys.A, IntPtr.Zero);
+                probe.RunProcessKeyMessage(ref keyMsg);
+                Assert.True(probe.KeyDownFired);
+
+                // --- ProcessCmdKey forwards to the parent, which handles it ---
+                var cmdMsg = Message.Create(probe.Handle, 0x0100, (IntPtr)(int)(Keys.Control | Keys.S), IntPtr.Zero);
+                var handled = probe.RunProcessCmdKey(ref cmdMsg, Keys.Control | Keys.S);
+                Assert.True(handled);
+                Assert.Equal(Keys.Control | Keys.S, parent.LastKey);
+            }
+            finally
+            {
+                form.Close();
+            }
+        };
+
+        form.ShowDialog();
+        form.Dispose();
+    }
+}
diff --git a/Gtk.Windows.Forms.Tests/System/Windows/Forms/FormLegacyFunctionalTests.cs b/Gtk.Windows.Forms.Tests/System/Windows/Forms/FormLegacyFunctionalTests.cs
new file mode 100644
index 00000000..d0de3642
--- /dev/null
+++ b/Gtk.Windows.Forms.Tests/System/Windows/Forms/FormLegacyFunctionalTests.cs
@@ -0,0 +1,97 @@
+namespace System.Windows.Forms;
+
+extern alias gtk;
+
+using System.ComponentModel;
+
+/// <summary>
+/// Verifies the pre-2.0 <see cref="Form" /> lifecycle surface: the legacy <c>Closing</c>/<c>Closed</c>
+/// events (wired into the modern <c>FormClosing</c>/<c>FormClosed</c> raising, including cancel
+/// propagation), owned-form management, <c>ParentForm</c> and validation. Reflection covers the API shape;
+/// behaviour runs in a realized form.
+/// </summary>
+[Collection("NonParallelCollection")]
+public class FormLegacyFunctionalTests
+{
+    private sealed class ClosingProbe : Form
+    {
+        public void RaiseFormClosing(FormClosingEventArgs e) => OnFormClosing(e);
+
+        public void RaiseFormClosed(FormClosedEventArgs e) => OnFormClosed(e);
+    }
+
+    [Fact]
+    public void LegacyMembers_Exist()
+    {
+        var t = typeof(Form);
+        Assert.NotNull(t.GetEvent("Closing"));
+        Assert.NotNull(t.GetEvent("Closed"));
+        Assert.NotNull(t.GetEvent("Activated"));
+        Assert.NotNull(t.GetEvent("Deactivate"));
+        Assert.NotNull(t.GetProperty("OwnedForms"));
+        Assert.NotNull(t.GetProperty("ParentForm"));
+        Assert.NotNull(t.GetMethod("Validate", Type.EmptyTypes));
+        Assert.NotNull(t.GetMethod("AddOwnedForm"));
+    }
+
+    [Fact]
+    public void LegacyClosingClosed_FireFromModernRaisers_WithCancelPropagation()
+    {
+        // No ShowDialog: the Form static constructor initializes GTK, so the raisers can be exercised
+        // directly. (Re-entering OnFormClosed inside a live modal loop is unsafe on this GTK host.)
+        var form = new ClosingProbe();
+
+        var closingFired = 0;
+        var closedFired = 0;
+        form.Closing += (s, e) => { closingFired++; e.Cancel = true; };
+        form.Closed += (s, e) => closedFired++;
+
+        // The legacy Closing runs when FormClosing is raised, and its cancel flows back to the modern args.
+        var closingArgs = new FormClosingEventArgs(CloseReason.UserClosing, false);
+        form.RaiseFormClosing(closingArgs);
+        Assert.Equal(1, closingFired);
+        Assert.True(closingArgs.Cancel);
+
+        // The legacy Closed runs when FormClosed is raised.
+        form.RaiseFormClosed(new FormClosedEventArgs(CloseReason.UserClosing));
+        Assert.Equal(1, closedFired);
+
+        form.Dispose();
+    }
+
+    [Fact]
+    public void OwnedForms_And_ParentForm_Validate()
+    {
+        var owner = new Form();
+
+        owner.Load += (s, e) =>
+        {
+            try
+            {
+                var owned = new Form();
+                Assert.Empty(owner.OwnedForms);
+
+                owner.AddOwnedForm(owned);
+                Assert.Single(owner.OwnedForms);
+                Assert.Same(owned, owner.OwnedForms[0]);
+                Assert.Same(owner, owned.ParentForm);
+
+                owner.RemoveOwnedForm(owned);
+                Assert.Empty(owner.OwnedForms);
+                Assert.Null(owned.ParentForm);
+
+                // validation shims succeed
+                Assert.True(owner.Validate());
+                Assert.True(owner.ValidateChildren());
+                owned.Dispose();
+            }
+            finally
+            {
+                owner.Close();
+            }
+        };
+
+        owner.ShowDialog();
+        owner.Dispose();
+    }
+}
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/Control/Control.Extensibility.cs b/Gtk.Windows.Forms/System/Windows/Forms/Control/Control.Extensibility.cs
new file mode 100644
index 00000000..f2338cee
--- /dev/null
+++ b/Gtk.Windows.Forms/System/Windows/Forms/Control/Control.Extensibility.cs
@@ -0,0 +1,230 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+// See the LICENSE file in the project root for more information.
+
+using System.Drawing;
+
+namespace System.Windows.Forms;
+
+/// <summary>
+/// Keyboard-command routing, right-to-left alignment translation and parent-change notification override
+/// points that custom controls ported from WinForms rely on. These mirror the real
+/// <c>System.Windows.Forms.Control</c> members so overriding source compiles and behaves.
+/// </summary>
+public partial class Control
+{
+    // Windows message identifiers used by the key-processing chain.
+    private const int WM_KEYDOWN = 0x0100;
+    private const int WM_KEYUP = 0x0101;
+    private const int WM_CHAR = 0x0102;
+    private const int WM_SYSKEYDOWN = 0x0104;
+    private const int WM_SYSKEYUP = 0x0105;
+    private const int WM_SYSCHAR = 0x0106;
+
+    /// <summary>
+    /// Processes a command key. Override to intercept a shortcut before it reaches the focused control; the
+    /// default implementation forwards to the parent so a container can handle keys for its children.
+    /// </summary>
+    /// <param name="msg">A <see cref="T:System.Windows.Forms.Message" />, passed by reference, that represents the message to process.</param>
+    /// <param name="keyData">One of the <see cref="T:System.Windows.Forms.Keys" /> values that represents the key to process.</param>
+    /// <returns><see langword="true" /> if the key was processed; otherwise <see langword="false" />.</returns>
+    protected virtual bool ProcessCmdKey(ref Message msg, Keys keyData)
+        => Parent != null && Parent.ProcessCmdKey(ref msg, keyData);
+
+    /// <summary>Processes a dialog key. The default implementation forwards to the parent.</summary>
+    /// <param name="keyData">The key to process.</param>
+    /// <returns><see langword="true" /> if the key was processed; otherwise <see langword="false" />.</returns>
+    protected virtual bool ProcessDialogKey(Keys keyData)
+        => Parent != null && Parent.ProcessDialogKey(keyData);
+
+    /// <summary>Processes a dialog character. The default implementation forwards to the parent.</summary>
+    /// <param name="charCode">The character to process.</param>
+    /// <returns><see langword="true" /> if the character was processed; otherwise <see langword="false" />.</returns>
+    protected virtual bool ProcessDialogChar(char charCode)
+        => Parent != null && Parent.ProcessDialogChar(charCode);
+
+    /// <summary>Processes a mnemonic character. The default implementation returns <see langword="false" />.</summary>
+    /// <param name="charCode">The mnemonic character to process.</param>
+    /// <returns><see langword="true" /> if the mnemonic was consumed; otherwise <see langword="false" />.</returns>
+    protected internal virtual bool ProcessMnemonic(char charCode) => false;
+
+    /// <summary>
+    /// Previews a key message. The default implementation forwards to the parent, giving a container the
+    /// first chance to inspect the key.
+    /// </summary>
+    /// <param name="m">A <see cref="T:System.Windows.Forms.Message" />, passed by reference, that represents the message to process.</param>
+    /// <returns><see langword="true" /> if the message was processed; otherwise <see langword="false" />.</returns>
+    protected virtual bool ProcessKeyPreview(ref Message m)
+        => Parent != null && Parent.ProcessKeyPreview(ref m);
+
+    /// <summary>
+    /// Processes a key message by raising the appropriate key event
+    /// (<see cref="M:System.Windows.Forms.Control.OnKeyDown(System.Windows.Forms.KeyEventArgs)" />,
+    /// <see cref="M:System.Windows.Forms.Control.OnKeyPress(System.Windows.Forms.KeyPressEventArgs)" /> or
+    /// <see cref="M:System.Windows.Forms.Control.OnKeyUp(System.Windows.Forms.KeyEventArgs)" />).
+    /// </summary>
+    /// <param name="m">A <see cref="T:System.Windows.Forms.Message" />, passed by reference, that represents the message to process.</param>
+    /// <returns><see langword="true" /> if the message was handled by an event; otherwise <see langword="false" />.</returns>
+    protected virtual bool ProcessKeyEventArgs(ref Message m)
+    {
+        switch (m.Msg)
+        {
+            case WM_KEYDOWN:
+            case WM_SYSKEYDOWN:
+                var down = new KeyEventArgs((Keys)(int)m.WParam);
+                OnKeyDown(down);
+                return down.Handled;
+            case WM_KEYUP:
+            case WM_SYSKEYUP:
+                var up = new KeyEventArgs((Keys)(int)m.WParam);
+                OnKeyUp(up);
+                return up.Handled;
+            case WM_CHAR:
+            case WM_SYSCHAR:
+                var press = new KeyPressEventArgs((char)(int)m.WParam);
+                OnKeyPress(press);
+                return press.Handled;
+            default:
+                return false;
+        }
+    }
+
+    /// <summary>
+    /// Processes a keyboard message, giving the parent a preview first and then raising the key events.
+    /// </summary>
+    /// <param name="m">A <see cref="T:System.Windows.Forms.Message" />, passed by reference, that represents the message to process.</param>
+    /// <returns><see langword="true" /> if the message was processed; otherwise <see langword="false" />.</returns>
+    protected internal virtual bool ProcessKeyMessage(ref Message m)
+    {
+        if (Parent != null && Parent.ProcessKeyPreview(ref m))
+        {
+            return true;
+        }
+
+        return ProcessKeyEventArgs(ref m);
+    }
+
+    /// <summary>
+    /// Determines whether the specified key is a regular input key that the control handles itself rather
+    /// than a special key handled by dialog processing. The default implementation returns
+    /// <see langword="false" />.
+    /// </summary>
+    /// <param name="keyData">One of the <see cref="T:System.Windows.Forms.Keys" /> values.</param>
+    /// <returns><see langword="true" /> if the key is a regular input key; otherwise <see langword="false" />.</returns>
+    protected virtual bool IsInputKey(Keys keyData) => false;
+
+    /// <summary>
+    /// Determines whether a character is an input character that the control recognizes. The default
+    /// implementation returns <see langword="true" />.
+    /// </summary>
+    /// <param name="charCode">The character to test.</param>
+    /// <returns><see langword="true" /> if the character is an input character; otherwise <see langword="false" />.</returns>
+    protected virtual bool IsInputChar(char charCode) => true;
+
+    /// <summary>Converts the specified <see cref="T:System.Windows.Forms.HorizontalAlignment" /> when the control's layout is right-to-left.</summary>
+    /// <param name="align">The alignment to convert.</param>
+    /// <returns>The converted alignment.</returns>
+    protected HorizontalAlignment RtlTranslateAlignment(HorizontalAlignment align) => RtlTranslateHorizontal(align);
+
+    /// <summary>Converts the specified <see cref="T:System.Windows.Forms.LeftRightAlignment" /> when the control's layout is right-to-left.</summary>
+    /// <param name="align">The alignment to convert.</param>
+    /// <returns>The converted alignment.</returns>
+    protected LeftRightAlignment RtlTranslateAlignment(LeftRightAlignment align) => RtlTranslateLeftRight(align);
+
+    /// <summary>Converts the specified <see cref="T:System.Drawing.ContentAlignment" /> when the control's layout is right-to-left.</summary>
+    /// <param name="align">The alignment to convert.</param>
+    /// <returns>The converted alignment.</returns>
+    protected ContentAlignment RtlTranslateAlignment(ContentAlignment align) => RtlTranslateContent(align);
+
+    /// <summary>Converts the specified <see cref="T:System.Windows.Forms.HorizontalAlignment" /> when the control's layout is right-to-left.</summary>
+    /// <param name="align">The alignment to convert.</param>
+    /// <returns>The converted alignment.</returns>
+    protected HorizontalAlignment RtlTranslateHorizontal(HorizontalAlignment align)
+    {
+        if (RightToLeft == RightToLeft.Yes)
+        {
+            if (align == HorizontalAlignment.Left)
+            {
+                return HorizontalAlignment.Right;
+            }
+
+            if (align == HorizontalAlignment.Right)
+            {
+                return HorizontalAlignment.Left;
+            }
+        }
+
+        return align;
+    }
+
+    /// <summary>Converts the specified <see cref="T:System.Windows.Forms.LeftRightAlignment" /> when the control's layout is right-to-left.</summary>
+    /// <param name="align">The alignment to convert.</param>
+    /// <returns>The converted alignment.</returns>
+    protected LeftRightAlignment RtlTranslateLeftRight(LeftRightAlignment align)
+    {
+        if (RightToLeft == RightToLeft.Yes)
+        {
+            return align == LeftRightAlignment.Left ? LeftRightAlignment.Right : LeftRightAlignment.Left;
+        }
+
+        return align;
+    }
+
+    /// <summary>Converts the specified <see cref="T:System.Drawing.ContentAlignment" /> when the control's layout is right-to-left.</summary>
+    /// <param name="align">The alignment to convert.</param>
+    /// <returns>The converted alignment.</returns>
+    protected ContentAlignment RtlTranslateContent(ContentAlignment align)
+    {
+        if (RightToLeft != RightToLeft.Yes)
+        {
+            return align;
+        }
+
+        return align switch
+        {
+            ContentAlignment.TopLeft => ContentAlignment.TopRight,
+            ContentAlignment.TopRight => ContentAlignment.TopLeft,
+            ContentAlignment.MiddleLeft => ContentAlignment.MiddleRight,
+            ContentAlignment.MiddleRight => ContentAlignment.MiddleLeft,
+            ContentAlignment.BottomLeft => ContentAlignment.BottomRight,
+            ContentAlignment.BottomRight => ContentAlignment.BottomLeft,
+            _ => align,
+        };
+    }
+
+    /// <summary>Raises the <see cref="E:System.Windows.Forms.Control.BackColorChanged" /> event when the parent's back color changes.</summary>
+    /// <param name="e">An <see cref="T:System.EventArgs" /> that contains the event data.</param>
+    protected virtual void OnParentBackColorChanged(EventArgs e) => OnBackColorChanged(e);
+
+    /// <summary>Raises the <see cref="E:System.Windows.Forms.Control.BackgroundImageChanged" /> event when the parent's background image changes.</summary>
+    /// <param name="e">An <see cref="T:System.EventArgs" /> that contains the event data.</param>
+    protected virtual void OnParentBackgroundImageChanged(EventArgs e) => OnBackgroundImageChanged(e);
+
+    /// <summary>Raises the <see cref="E:System.Windows.Forms.Control.BindingContextChanged" /> event when the parent's binding context changes.</summary>
+    /// <param name="e">An <see cref="T:System.EventArgs" /> that contains the event data.</param>
+    protected virtual void OnParentBindingContextChanged(EventArgs e) => OnBindingContextChanged(e);
+
+    /// <summary>Raises the <see cref="E:System.Windows.Forms.Control.CursorChanged" /> event when the parent's cursor changes.</summary>
+    /// <param name="e">An <see cref="T:System.EventArgs" /> that contains the event data.</param>
+    protected virtual void OnParentCursorChanged(EventArgs e) => OnCursorChanged(e);
+
+    /// <summary>Raises the <see cref="E:System.Windows.Forms.Control.EnabledChanged" /> event when the parent's enabled state changes.</summary>
+    /// <param name="e">An <see cref="T:System.EventArgs" /> that contains the event data.</param>
+    protected virtual void OnParentEnabledChanged(EventArgs e) => OnEnabledChanged(e);
+
+    /// <summary>Raises the <see cref="E:System.Windows.Forms.Control.FontChanged" /> event when the parent's font changes.</summary>
+    /// <param name="e">An <see cref="T:System.EventArgs" /> that contains the event data.</param>
+    protected virtual void OnParentFontChanged(EventArgs e) => OnFontChanged(e);
+
+    /// <summary>Raises the <see cref="E:System.Windows.Forms.Control.ForeColorChanged" /> event when the parent's fore color changes.</summary>
+    /// <param name="e">An <see cref="T:System.EventArgs" /> that contains the event data.</param>
+    protected virtual void OnParentForeColorChanged(EventArgs e) => OnForeColorChanged(e);
+
+    /// <summary>Raises the <see cref="E:System.Windows.Forms.Control.RightToLeftChanged" /> event when the parent's right-to-left value changes.</summary>
+    /// <param name="e">An <see cref="T:System.EventArgs" /> that contains the event data.</param>
+    protected virtual void OnParentRightToLeftChanged(EventArgs e) => OnRightToLeftChanged(e);
+
+    /// <summary>Raises the <see cref="E:System.Windows.Forms.Control.VisibleChanged" /> event when the parent's visibility changes.</summary>
+    /// <param name="e">An <see cref="T:System.EventArgs" /> that contains the event data.</param>
+    protected virtual void OnParentVisibleChanged(EventArgs e) => OnVisibleChanged(e);
+}
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/Form.Legacy.cs b/Gtk.Windows.Forms/System/Windows/Forms/Form.Legacy.cs
new file mode 100644
index 00000000..8a51570a
--- /dev/null
+++ b/Gtk.Windows.Forms/System/Windows/Forms/Form.Legacy.cs
@@ -0,0 +1,105 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+// See the LICENSE file in the project root for more information.
+
+using System.Collections.Generic;
+using System.ComponentModel;
+
+namespace System.Windows.Forms;
+
+/// <summary>
+/// The pre-2.0 lifecycle events (<see cref="E:System.Windows.Forms.Form.Closing" />,
+/// <see cref="E:System.Windows.Forms.Form.Closed" />, <see cref="E:System.Windows.Forms.Form.Activated" />,
+/// <see cref="E:System.Windows.Forms.Form.Deactivate" />) plus owned-form management, parent-form access,
+/// validation and centering. These mirror <c>System.Windows.Forms.Form</c> so source that predates
+/// <c>FormClosing</c>/<c>FormClosed</c> — a very common partial surface — keeps compiling and behaving.
+/// </summary>
+public partial class Form
+{
+    private readonly List<Form> _ownedForms = new();
+
+    /// <summary>Occurs when the form is closing. Superseded by <see cref="E:System.Windows.Forms.Form.FormClosing" />.</summary>
+    public event CancelEventHandler? Closing;
+
+    /// <summary>Occurs when the form is closed. Superseded by <see cref="E:System.Windows.Forms.Form.FormClosed" />.</summary>
+    public event EventHandler? Closed;
+
+    /// <summary>Occurs when the form is activated in code or by the user.</summary>
+    public event EventHandler? Activated;
+
+    /// <summary>Occurs when the form loses focus and is no longer the active form.</summary>
+    public event EventHandler? Deactivate;
+
+    /// <summary>Gets an array of <see cref="T:System.Windows.Forms.Form" /> objects that represent all forms that are owned by this form.</summary>
+    public Form[] OwnedForms => _ownedForms.ToArray();
+
+    /// <summary>Gets the form that owns this form (its parent in an owner relationship), or <see langword="null" />.</summary>
+    public Form? ParentForm { get; internal set; }
+
+    /// <summary>Adds an owned form to this form.</summary>
+    /// <param name="ownedForm">The form to be added.</param>
+    public void AddOwnedForm(Form ownedForm)
+    {
+        if (ownedForm == null)
+        {
+            return;
+        }
+
+        if (!_ownedForms.Contains(ownedForm))
+        {
+            _ownedForms.Add(ownedForm);
+            ownedForm.ParentForm = this;
+        }
+    }
+
+    /// <summary>Removes an owned form from this form.</summary>
+    /// <param name="ownedForm">The form to be removed.</param>
+    public void RemoveOwnedForm(Form ownedForm)
+    {
+        if (ownedForm != null && _ownedForms.Remove(ownedForm))
+        {
+            ownedForm.ParentForm = null;
+        }
+    }
+
+    /// <summary>Validates the last invalidated control and its ancestors up through, but not including, the current control.</summary>
+    /// <returns><see langword="true" /> if validation succeeds; otherwise <see langword="false" />.</returns>
