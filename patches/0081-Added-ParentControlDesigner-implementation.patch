Subject: [PATCH] Added ParentControlDesigner implementation

---
 .../Design/Designer/ComponentDesigner.cs      |  2 +-
 .../Forms/Design/Designer/DocumentDesigner.cs |  9 +--
 .../Design/Designer/ParentControlDesigner.cs  | 76 ++++++++++++++-----
 3 files changed, 64 insertions(+), 23 deletions(-)

diff --git a/Net4x.Gtk.Windows.Forms/System/ComponentModel/Design/Designer/ComponentDesigner.cs b/Net4x.Gtk.Windows.Forms/System/ComponentModel/Design/Designer/ComponentDesigner.cs
index a9a1afd..9de479d 100644
--- a/Net4x.Gtk.Windows.Forms/System/ComponentModel/Design/Designer/ComponentDesigner.cs
+++ b/Net4x.Gtk.Windows.Forms/System/ComponentModel/Design/Designer/ComponentDesigner.cs
@@ -92,7 +92,7 @@ public partial class ComponentDesigner : ITreeDesigner, IDesignerFilter, ICompon
         _component = component;
     }
 
-    IComponent IDesigner.Component { get; }
+    IComponent? IDesigner.Component { get; }
 
     /// <summary>
     /// Restores an instance of a component to its default state.
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Design/Designer/DocumentDesigner.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Design/Designer/DocumentDesigner.cs
index 5acff1f..353a6c4 100644
--- a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Design/Designer/DocumentDesigner.cs
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Design/Designer/DocumentDesigner.cs
@@ -145,13 +145,12 @@ public partial class DocumentDesigner : ScrollableControlDesigner, IRootDesigner
         }
 
         // Try to obtain a designer host from the root component's site as a fallback
-        var host = (this.Component as IComponent)?.Site?.GetService(typeof(IDesignerHost)) as IDesignerHost;
-        if (host is null)
+        if ((this.Component as IComponent)?.Site?.GetService(typeof(IDesignerHost)) is not IDesignerHost host)
         {
             return;
         }
 
-        using DesignerTransaction transaction = host.CreateTransaction("ToolPicked");
+        using var transaction = host.CreateTransaction("ToolPicked");
 
         try
         {
@@ -166,7 +165,7 @@ public partial class DocumentDesigner : ScrollableControlDesigner, IRootDesigner
                 try
                 {
                     var parameters = createMethod.GetParameters();
-                    object? invokeResult = createMethod.Invoke(tool, parameters.Length == 1 ? new object?[] { host } : null);
+                    var invokeResult = createMethod.Invoke(tool, parameters.Length == 1 ? new object?[] { host } : null);
                     components = invokeResult as object[];
                 }
                 catch (TargetInvocationException)
@@ -211,7 +210,7 @@ public partial class DocumentDesigner : ScrollableControlDesigner, IRootDesigner
 
             if (components is { Length: > 0 } &&
                 components[0] is Control control &&
-                host.RootComponent is Control parent)
+                host?.RootComponent is Control parent)
             {
                 if (parent is Form form)
                 {
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Design/Designer/ParentControlDesigner.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Design/Designer/ParentControlDesigner.cs
index 19758f3..a6c359b 100644
--- a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Design/Designer/ParentControlDesigner.cs
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Design/Designer/ParentControlDesigner.cs
@@ -10,7 +10,7 @@ namespace System.Windows.Forms.Design;
 /// to manipulate child components, and provides a selection UI handler for all
 /// components it contains.
 /// </summary>
-public partial class ParentControlDesigner : ControlDesigner, IOleDragClient
+public class ParentControlDesigner : ControlDesigner, IOleDragClient
 {
     /// <summary>
     /// Checks if the client is read only.  That is, if components can
@@ -24,11 +24,16 @@ public partial class ParentControlDesigner : ControlDesigner, IOleDragClient
     /// false
     /// </c>.
     /// </value>
-    /// <exception cref="T:System.NotImplementedException">
-    /// </exception>
-    public bool CanModifyComponents => throw new NotImplementedException();
+    public bool CanModifyComponents
+    {
+        get
+        {
+            // Basic implementation: allow modification if we have a Control as root
+            return Component is Control;
+        }
+    }
 
-    public IComponent? Component { get; set; }
+    public override IComponent? Component { get; set; }
 
     /// <summary>
     /// Retrieves the control view instance for the designer that is hosting the drag.
@@ -53,11 +58,38 @@ public partial class ParentControlDesigner : ControlDesigner, IOleDragClient
     /// false
     /// </c> otherwise.
     /// </returns>
-    /// <exception cref="T:System.NotImplementedException">
-    /// </exception>
     public bool AddComponent(IComponent component, string name, bool firstAdd)
     {
-        throw new NotImplementedException();
+        if (!CanModifyComponents || component is null)
+        {
+            return false;
+        }
+
+        if (Component is not Control parent)
+        {
+            return false;
+        }
+
+        if (component is Control control)
+        {
+            // Assign name if possible
+            if (!string.IsNullOrEmpty(name))
+            {
+                control.Name = name;
+            }
+
+            parent.Controls?.Add(control);
+
+            // Basic positioning for first add
+            if (firstAdd)
+            {
+                control.Location = new System.Drawing.Point(10, 10);
+            }
+
+            return true;
+        }
+
+        return false;
     }
 
     /// <summary>
@@ -70,11 +102,14 @@ public partial class ParentControlDesigner : ControlDesigner, IOleDragClient
     /// <returns>
     /// Control.
     /// </returns>
-    /// <exception cref="T:System.NotImplementedException">
-    /// </exception>
     public Control GetControlForComponent(object component)
     {
-        throw new NotImplementedException();
+        if (component is Control control)
+        {
+            return control;
+        }
+
+        throw new ArgumentException(@"Component is not a Control.", nameof(component));
     }
 
     /// <summary>
@@ -83,11 +118,14 @@ public partial class ParentControlDesigner : ControlDesigner, IOleDragClient
     /// <returns>
     /// Control.
     /// </returns>
-    /// <exception cref="T:System.NotImplementedException">
-    /// </exception>
     public Control GetDesignerControl()
     {
-        throw new NotImplementedException();
+        if (Component is Control control)
+        {
+            return control;
+        }
+
+        throw new InvalidOperationException("Designer is not associated with a Control.");
     }
 
     /// <summary>
@@ -104,10 +142,14 @@ public partial class ParentControlDesigner : ControlDesigner, IOleDragClient
     /// false
     /// </c>.
     /// </returns>
-    /// <exception cref="T:System.NotImplementedException">
-    /// </exception>
     public bool IsDropOk(IComponent component)
     {
-        throw new NotImplementedException();
+        if (!CanModifyComponents || component is null)
+        {
+            return false;
+        }
+
+        // Only allow dropping controls onto controls
+        return component is Control;
     }
 }
