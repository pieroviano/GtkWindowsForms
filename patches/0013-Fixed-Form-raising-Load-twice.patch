From a08448090b499eb092ad0041b9bf1284e2f99850 Mon Sep 17 00:00:00 2001
From: pviano-ria <pviano@riasolutionsgroup.ai>
Date: Thu, 26 Mar 2026 04:50:54 +0200
Subject: [PATCH] Fixed Form raising Load twice

---
 Net4x.Gtk.Windows.Forms/System/Windows/Forms/Form.cs | 11 +++++------
 1 file changed, 5 insertions(+), 6 deletions(-)

diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Form.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Form.cs
index 1adb9b41..d53e2639 100644
--- a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Form.cs
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Form.cs
@@ -77,6 +77,11 @@ public partial class Form : ContainerControl, IWin32Window
         remove { self.Scroll += value; }
     }
 
+    static Form()
+    {
+        Application.Init();
+    }
+
     /// <summary>
     /// Initializes a new instance of the
     /// <see cref="T:System.Windows.Forms.Form" /> class.
@@ -603,7 +608,6 @@ public partial class Form : ContainerControl, IWin32Window
                     }
                 }
             }
-            OnLoadHandler();
         }
         OnShownHandler();
     }
@@ -647,11 +651,6 @@ public partial class Form : ContainerControl, IWin32Window
         self.Iconify();
     }
 
-    private void OnLoadHandler()
-    {
-        OnLoad(EventArgs.Empty);
-    }
-
     private void OnShownHandler()
     {
         OnShown(EventArgs.Empty);
-- 
2.53.0.windows.2

