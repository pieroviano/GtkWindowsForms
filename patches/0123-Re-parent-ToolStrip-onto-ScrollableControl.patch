From 175bd2271856ee4dc8355dfd82742851f864a24c Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Date: Sat, 25 Jul 2026 19:58:11 +0300
Subject: [PATCH] Re-parent ToolStrip onto ScrollableControl

ToolStrip derived from Control; real WinForms has ToolStrip : ScrollableControl :
Control, so the whole ToolStrip cluster was missing the scrollable-control surface
(AutoScroll, HScroll/VScroll, HorizontalScroll/VerticalScroll, DockPadding,
AutoScrollMargin/MinSize/Position). One-line base change, empirical like the
ToolStripDropDown fix: ScrollableControl's ctor casts GtkControl to
IScrollableBoxBase, which the toolbar's Gtk.MenuBar backing is not, so scrollbase
is simply null and scrolling is a no-op - acceptable for a toolbar - while the
API surface is inherited.

Closes ~120 member gaps across the cluster (net10: ToolStrip 130->115,
ContextMenuStrip 150->135, MenuStrip 134->119, StatusStrip 129->114,
BindingNavigator 130->115, ToolStripDropDown 153->138). Covered by
ToolStripScrollableReparentFunctionalTests. Full Forms suite green at 2504.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 ...lStripScrollableReparentFunctionalTests.cs | 42 +++++++++++++++++++
 .../System/Windows/Forms/ToolStrip.cs         |  2 +-
 2 files changed, 43 insertions(+), 1 deletion(-)
 create mode 100644 Gtk.Windows.Forms.Tests/System/Windows/Forms/ToolStripScrollableReparentFunctionalTests.cs

diff --git a/Gtk.Windows.Forms.Tests/System/Windows/Forms/ToolStripScrollableReparentFunctionalTests.cs b/Gtk.Windows.Forms.Tests/System/Windows/Forms/ToolStripScrollableReparentFunctionalTests.cs
new file mode 100644
index 00000000..dd10800e
--- /dev/null
+++ b/Gtk.Windows.Forms.Tests/System/Windows/Forms/ToolStripScrollableReparentFunctionalTests.cs
@@ -0,0 +1,42 @@
+using System.Windows.Forms;
+
+namespace GtkWinForms.Tests.System.Windows.Forms;
+
+/// <summary>
+/// Pins the ToolStrip base-class fix: <see cref="ToolStrip"/> now derives from
+/// <see cref="ScrollableControl"/> (it was a plain <see cref="Control"/>), matching WinForms, so the whole
+/// ToolStrip cluster inherits the scrollable-control surface (AutoScroll, HScroll/VScroll, DockPadding, …).
+/// Scrolling itself is a no-op on a toolbar's non-scrollable GTK backing, which is fine.
+/// </summary>
+[Collection("NonParallelCollection")]
+public class ToolStripScrollableReparentFunctionalTests
+{
+    static ToolStripScrollableReparentFunctionalTests()
+    {
+        using var _ = new Form();
+    }
+
+    [Fact]
+    public void ToolStrip_IsNowAScrollableControl()
+    {
+        using var strip = new ToolStrip();
+
+        Assert.IsAssignableFrom<ScrollableControl>(strip);
+        Assert.IsAssignableFrom<Control>(strip);
+    }
+
+    [Fact]
+    public void TheClusterInheritsTheScrollableSurface()
+    {
+        // A representative slice of the ScrollableControl surface, now present on the cluster's members.
+        using var menu = new ContextMenuStrip();
+        using var status = new StatusStrip();
+
+        Assert.IsAssignableFrom<ScrollableControl>(menu);
+        Assert.IsAssignableFrom<ScrollableControl>(status);
+
+        // AutoScroll resolves and round-trips (it drives no real scrolling on the toolbar backing).
+        menu.AutoScroll = true;
+        Assert.True(menu.AutoScroll);
+    }
+}
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/ToolStrip.cs b/Gtk.Windows.Forms/System/Windows/Forms/ToolStrip.cs
index 735f3c42..bceeaf7e 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/ToolStrip.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/ToolStrip.cs
@@ -13,7 +13,7 @@ namespace System.Windows.Forms;
 /// <summary>
 /// Provides a container for Windows toolbar objects.
 /// </summary>
-public class ToolStrip : Control
+public class ToolStrip : ScrollableControl
 {
