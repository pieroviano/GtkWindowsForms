diff --git a/Gtk.Windows.Forms/System/Windows/Forms/TreeViewBase/TreeNodeCollection.cs b/Gtk.Windows.Forms/System/Windows/Forms/TreeViewBase/TreeNodeCollection.cs
index 49a8f8d9..2316bdef 100644
