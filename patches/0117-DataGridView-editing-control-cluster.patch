diff --git a/Net4x.Gtk.Windows.Forms.Tests/System/Windows/Forms/DataGridViewEditingControlFunctionalTests.cs b/Net4x.Gtk.Windows.Forms.Tests/System/Windows/Forms/DataGridViewEditingControlFunctionalTests.cs
