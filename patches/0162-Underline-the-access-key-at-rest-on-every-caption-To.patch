diff --git a/Gtk.Windows.Forms/System/Windows/Forms/Button.cs b/Gtk.Windows.Forms/System/Windows/Forms/Button.cs
index 2f8cbd25..058713d0 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/Button.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/Button.cs
@@ -83,8 +83,7 @@ public partial class Button : ButtonBase
         {
             _text = value ?? string.Empty;
             var label = (Gtk.Label)self.Child;
-            label.Text = Mnemonics.ToGtk(_text, UseMnemonic);
-            label.UseUnderline = UseMnemonic; // set_text clears the flag, so it goes on afterwards
+            Mnemonics.Apply(label, _text, UseMnemonic);
         }
     }
 
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/CheckBox.cs b/Gtk.Windows.Forms/System/Windows/Forms/CheckBox.cs
index 4a03bf92..a8dc6242 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/CheckBox.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/CheckBox.cs
@@ -114,16 +114,20 @@ public partial class CheckBox : ButtonBase
         set
         {
             _text = value ?? string.Empty;
-            var caption = Mnemonics.ToGtk(_text, UseMnemonic);
             if (self.Child is Gtk.Label label)
             {
-                label.Text = caption;
-                label.UseUnderline = UseMnemonic; // set_text clears the flag, so it goes on afterwards
+                Mnemonics.Apply(label, _text, UseMnemonic);
             }
             else
             {
-                self.Label = caption;
+                self.Label = Mnemonics.ToGtk(_text, UseMnemonic);
                 self.UseUnderline = UseMnemonic;
+                // The button's own caption label gets the underlined spelling; Alt+key still toggles the box.
+                if (self.GetLabelWidget() is { } caption)
+                {
+                    Mnemonics.Apply(caption, _text, UseMnemonic);
+                    caption.MnemonicWidget = self;
+                }
             }
         }
     }
