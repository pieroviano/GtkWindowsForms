+using System.Drawing;
+using System.Windows.Forms.VisualStyles;
+
+namespace System.Windows.Forms;
+
+/// <summary>Provides methods used to render a check box control with visual styles. Rendering falls back to classic (non-themed) drawing; GTK draws real chrome for live controls.</summary>
+public static class CheckBoxRenderer
+{
+    /// <summary>Gets or sets a value indicating whether the renderer follows the application render mode.</summary>
+    public static bool RenderMatchingApplicationState { get; set; } = true;
+
+    /// <summary>Indicates whether the background is semitransparent. Returns <see langword="false" />.</summary>
+    /// <param name="state">The visual state.</param>
+    /// <returns><see langword="false" />.</returns>
+    public static bool IsBackgroundPartiallyTransparent(CheckBoxState state) => false;
+
+    /// <summary>Draws the background of a control's parent.</summary>
+    /// <param name="g">The graphics used to draw.</param>
+    /// <param name="bounds">The area to draw.</param>
+    /// <param name="childControl">The control whose parent background is drawn.</param>
+    public static void DrawParentBackground(Graphics g, Rectangle bounds, Control childControl)
+    {
+        using var brush = new SolidBrush(childControl?.BackColor ?? SystemColors.Control);
+        g.FillRectangle(brush, bounds);
+    }
+
+    /// <summary>Gets the size of the glyph.</summary>
+    /// <param name="g">The graphics used to measure.</param>
+    /// <param name="state">The visual state.</param>
+    /// <returns>The glyph size.</returns>
+    public static Size GetGlyphSize(Graphics g, CheckBoxState state) => new Size(13, 13);
+
+    private static ButtonState MapGlyph(CheckBoxState state)
+    {
+        var b = ButtonState.Normal;
+        var n = state.ToString();
+        if (n.StartsWith("Checked") || n.StartsWith("Mixed")) { b |= ButtonState.Checked; }
+        if (n.EndsWith("Pressed")) { b |= ButtonState.Pushed; }
+        if (n.EndsWith("Disabled")) { b |= ButtonState.Inactive; }
+        return b;
+    }
+
+    /// <summary>Draws a DrawCheckBox glyph.</summary>
+    public static void DrawCheckBox(Graphics g, Point glyphLocation, CheckBoxState state)
+    {
+        ControlPaint.DrawCheckBox(g, new Rectangle(glyphLocation, GetGlyphSize(g, state)), MapGlyph(state));
+    }
+
+    /// <summary>Draws a DrawCheckBox glyph with text.</summary>
+    public static void DrawCheckBox(Graphics g, Point glyphLocation, Rectangle textBounds, string text, Font font, bool focused, CheckBoxState state)
+        => DrawCheckBox(g, glyphLocation, textBounds, text, font, TextFormatFlags.Default, focused, state);
+
+    /// <summary>Draws a DrawCheckBox glyph with text and format flags.</summary>
+    public static void DrawCheckBox(Graphics g, Point glyphLocation, Rectangle textBounds, string text, Font font, TextFormatFlags flags, bool focused, CheckBoxState state)
+    {
+        DrawCheckBox(g, glyphLocation, state);
+        TextRenderer.DrawText(g, text, font, textBounds, SystemColors.ControlText, flags);
+        if (focused) { ControlPaint.DrawFocusRectangle(g, textBounds); }
+    }
+
+    /// <summary>Draws a DrawCheckBox glyph with text and an image.</summary>
+    public static void DrawCheckBox(Graphics g, Point glyphLocation, Rectangle textBounds, string text, Font font, Image image, Rectangle imageBounds, bool focused, CheckBoxState state)
+        => DrawCheckBox(g, glyphLocation, textBounds, text, font, TextFormatFlags.Default, image, imageBounds, focused, state);
+
+    /// <summary>Draws a DrawCheckBox glyph with text, an image and format flags.</summary>
+    public static void DrawCheckBox(Graphics g, Point glyphLocation, Rectangle textBounds, string text, Font font, TextFormatFlags flags, Image image, Rectangle imageBounds, bool focused, CheckBoxState state)
+    {
+        DrawCheckBox(g, glyphLocation, state);
+        if (image != null) { g.DrawImage(image, imageBounds); }
+        TextRenderer.DrawText(g, text, font, textBounds, SystemColors.ControlText, flags);
+        if (focused) { ControlPaint.DrawFocusRectangle(g, textBounds); }
+    }
+}
