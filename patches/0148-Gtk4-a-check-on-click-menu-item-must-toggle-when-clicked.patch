From 2b9dcfd9c7967f6fc7807fb5c4cbaaef5a190c1a Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Date: Mon, 24 Aug 2026 06:09:45 +0300
Subject: [PATCH] Gtk4: a check-on-click menu item must toggle when clicked

ToolStripMenuItem had no CheckOnClick at all, and the Gtk4 widget always
undoes the CheckButton toggle a click produces, so a checked item could
never be unchecked by clicking it - the sample's "Dropdown List 1 / Item 1"
stayed checked however often it was clicked.

Add the missing WinForms property and honour it from OnClick: a
check-on-click item flips its state on every click and notifies before
raising Click, an ordinary command item keeps the current behaviour (the
state stays under the application's control). CheckState becomes the single
place the state is written, so both it and Checked notify exactly once, and
CheckState.Indeterminate no longer switches the toggle back on. The tray
menu now reads CheckOnClick for its checkable inference, and the sample
declares the property the item was always meant to have.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../Forms/StripMenuItemRenderingTests.cs      | 86 +++++++++++++++++++
 .../Forms/MenuStripBase/ToolStripMenuItem.cs  | 61 ++++++++++++-
 .../System/Windows/Forms/TrayMenuModel.cs     |  8 +-
 GtkWinFormsApp/Form3.Designer.cs              |  1 +
 4 files changed, 148 insertions(+), 8 deletions(-)

diff --git a/Gtk.Windows.Forms.Tests/System/Windows/Forms/StripMenuItemRenderingTests.cs b/Gtk.Windows.Forms.Tests/System/Windows/Forms/StripMenuItemRenderingTests.cs
index 22b138dd..db8e7da1 100644
--- a/Gtk.Windows.Forms.Tests/System/Windows/Forms/StripMenuItemRenderingTests.cs
+++ b/Gtk.Windows.Forms.Tests/System/Windows/Forms/StripMenuItemRenderingTests.cs
@@ -501,6 +501,92 @@ public class StripMenuItemRenderingTests
         Assert.Null(ex);
     }
 
+    [Fact]
+    public void CheckOnClick_DefaultsToFalse()
+    {
+        // WinForms default: an item only becomes checkable when the application opts in.
+        Assert.False(new ToolStripMenuItem("New").CheckOnClick);
+    }
+
+    [Fact]
+    public void CheckOnClickItem_TogglesCheckedOnEveryClick()
+    {
+        // Regression: a checked check-on-click item could not be unchecked by clicking it. The Gtk4 widget
+        // toggle is always reverted, and nothing put the WinForms state back the other way, so the item
+        // stayed checked however often it was clicked (the sample's "Dropdown List 1 / Item 1").
+        var item = new ToolStripMenuItem("Item 1") { CheckOnClick = true, Checked = true };
+
+        SimulateUserClick(item);
+
+        Assert.False(item.Checked);
+        Assert.Equal(CheckState.Unchecked, item.CheckState);
+        Assert.False(item.checkButton.Active); // the indicator follows, so a re-opened menu shows no check
+
+        SimulateUserClick(item);
+
+        Assert.True(item.Checked);
+        Assert.Equal(CheckState.Checked, item.CheckState);
+        Assert.True(item.checkButton.Active);
+    }
+
+    [Fact]
+    public void CheckOnClickItem_RaisesCheckedChangedAndCheckStateChanged_BeforeClick()
+    {
+        // WinForms flips the state from its click handling and notifies before raising Click, so a Click
+        // handler already sees the new state.
+        var item = new ToolStripMenuItem("Item 1") { CheckOnClick = true };
+        var order = new System.Collections.Generic.List<string>();
+        item.CheckedChanged += (s, e) => order.Add("checked");
+        item.CheckStateChanged += (s, e) => order.Add("checkstate");
+        item.Click += (s, e) => order.Add("click:" + item.Checked);
+
+        SimulateUserClick(item);
+
+        Assert.Equal(new[] { "checked", "checkstate", "click:True" }, order);
+    }
+
+    [Fact]
+    public void CheckOnClickItem_PerformClick_TogglesCheckedToo()
+    {
+        // PerformClick is the programmatic form of a click and must behave the same way.
+        var item = new ToolStripMenuItem("Item 1") { CheckOnClick = true, Checked = true };
+
+        item.PerformClick();
+
+        Assert.False(item.Checked);
+    }
+
+    [Fact]
+    public void SettingCheckState_RaisesCheckedChangedAndCheckStateChanged_OnceEach()
+    {
+        // The state used to change silently, so nothing driven off CheckedChanged (a menu mirrored into a
+        // tray icon, an enabled/disabled command) ever heard about a programmatic change.
+        var item = new ToolStripMenuItem("Item 1");
+        var checkedChanged = 0;
+        var stateChanged = 0;
+        item.CheckedChanged += (s, e) => checkedChanged++;
+        item.CheckStateChanged += (s, e) => stateChanged++;
+
+        item.Checked = true;
+        item.Checked = true; // no change - no second notification
+
+        Assert.Equal(1, checkedChanged);
+        Assert.Equal(1, stateChanged);
+    }
+
+    [Fact]
+    public void IndeterminateCheckState_LeavesToggleInactive()
+    {
+        // CheckState.Indeterminate is "inconsistent", not "active"; the state setter used to assign Checked
+        // afterwards as well, which switched the toggle on and drew a full check mark.
+        var item = new ToolStripMenuItem("Item 1") { CheckState = CheckState.Indeterminate };
+
+        Assert.Equal(CheckState.Indeterminate, item.CheckState);
+        Assert.True(item.Checked); // WinForms counts indeterminate as checked
+        Assert.True(item.checkButton.Inconsistent);
+        Assert.False(item.checkButton.Active);
+    }
+
     [Fact]
     public void SettingCheckedInCode_DoesNotRaiseClick()
     {
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripMenuItem.cs b/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripMenuItem.cs
index d8f5874b..dffdbde0 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripMenuItem.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripMenuItem.cs
@@ -91,9 +91,9 @@ public class ToolStripMenuItem : ToolStripItem
         set
         {
             // Do not route through base.Checked: it now derives from CheckState, which this type
-            // overrides, so the two setters would call each other forever.
-            self.Checked = value;
-            self.CheckState = value ? CheckState.Checked : CheckState.Unchecked;
+            // overrides, so the two setters would call each other forever. CheckState is the single
+            // place the state is written, so both setters notify exactly once.
+            CheckState = value ? CheckState.Checked : CheckState.Unchecked;
         }
     }
 
@@ -108,11 +108,44 @@ public class ToolStripMenuItem : ToolStripItem
         get => self.CheckState;
         set
         {
+            var previous = self.CheckState;
+
+            // Only CheckState is written: StripMenuItem.CheckState already drives both the toggle and the
+            // inconsistent flag. Assigning self.Checked afterwards used to switch the toggle back on for
+            // CheckState.Indeterminate, which is "inconsistent, not active".
             self.CheckState = value;
-            self.Checked = value != CheckState.Unchecked;
+
+            if (previous == value)
+            {
+                return;
+            }
+
+            // WinForms raises both events from the state change itself, so a programmatic assignment
+            // notifies just like a user click does.
+            OnCheckedChanged(EventArgs.Empty);
+            OnCheckStateChanged(EventArgs.Empty);
         }
     }
 
+    /// <summary>
+    /// Gets or sets a value indicating whether the item's
+    /// <see cref="Checked" /> state flips each time the item is clicked.
+    /// </summary>
+    /// <value>
+    /// <c>
+    /// true
+    /// </c> if a click toggles the check state; otherwise,
+    /// <c>
+    /// false
+    /// </c> (the WinForms default), in which case the state is only ever set in code.
+    /// </value>
+    /// <remarks>
+    /// The property was missing altogether, so the shim had no way to express a checkable menu item: the
+    /// backing Gtk4 CheckButton's own toggle is always undone (see <see cref="StripMenuItem" />), which
+    /// left an item like the sample's checked "Item 1" impossible to uncheck by clicking it.
+    /// </remarks>
+    public bool CheckOnClick { get; set; }
+
     public override ToolStripItemDisplayStyle DisplayStyle
     {
         get => base.DisplayStyle;
@@ -162,6 +195,26 @@ public class ToolStripMenuItem : ToolStripItem
 
     public override IToolMenuItem Widget { get => self; }
 
+    /// <summary>
+    /// Raises the Click event, first flipping the check state when
+    /// <see cref="CheckOnClick" /> is set.
+    /// </summary>
+    /// <param name="e">The event data.</param>
+    /// <remarks>
+    /// WinForms toggles a check-on-click item from its click handling and raises CheckedChanged before
+    /// Click, so handlers observe the new state; the order is kept here. Nothing happens for an ordinary
+    /// command item, whose check state stays under the application's control.
+    /// </remarks>
+    protected override void OnClick(EventArgs e)
+    {
+        if (CheckOnClick)
+        {
+            CheckState = CheckState == CheckState.Unchecked ? CheckState.Checked : CheckState.Unchecked;
+        }
+
+        base.OnClick(e);
+    }
+
     /// <summary>
     /// Raises the CheckedChanged event.
     /// </summary>
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/TrayMenuModel.cs b/Gtk.Windows.Forms/System/Windows/Forms/TrayMenuModel.cs
index 42adc3c0..cd65d2c6 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/TrayMenuModel.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/TrayMenuModel.cs
@@ -240,10 +240,10 @@ internal sealed class TrayMenuModel
 
             if (item is ToolStripMenuItem menuItem)
             {
-                // The shim's ToolStripMenuItem exposes no CheckOnClick, so an item is treated as checkable
-                // exactly when it currently carries a check state. An item that is checkable but unchecked
-                // therefore renders without a check box - the only fidelity loss the available surface allows.
-                node.IsCheckable = menuItem.CheckState != CheckState.Unchecked;
+                // An item is checkable when it says so (CheckOnClick) or when it currently carries a check
+                // state - the latter covers items whose check mark the application drives itself, which have
+                // no other way to advertise that they are checkable.
+                node.IsCheckable = menuItem.CheckOnClick || menuItem.CheckState != CheckState.Unchecked;
                 node.Checked = menuItem.CheckState == CheckState.Checked;
             }
 
diff --git a/GtkWinFormsApp/Form3.Designer.cs b/GtkWinFormsApp/Form3.Designer.cs
index 159217a0..5db9f6dc 100644
--- a/GtkWinFormsApp/Form3.Designer.cs
+++ b/GtkWinFormsApp/Form3.Designer.cs
@@ -240,6 +240,7 @@ namespace GtkWinFormsApp
             // memnuToolStripMenuItem
             // 
             memnuToolStripMenuItem.Checked = true;
+            memnuToolStripMenuItem.CheckOnClick = true;
             memnuToolStripMenuItem.CheckState = CheckState.Checked;
             memnuToolStripMenuItem.Name = "memnuToolStripMenuItem";
             memnuToolStripMenuItem.Size = new Size(116, 26);
-- 
