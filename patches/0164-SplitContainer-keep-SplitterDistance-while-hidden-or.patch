From 0c5e42b9ba82ef5e5204bc522946d8a759ac4617 Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Date: Sat, 7 Nov 2026 03:21:05 +0200
Subject: [PATCH] SplitContainer: keep SplitterDistance while hidden or
 unsized, add SplitterMoving/SplitterMoved

GTK clamps a paned's position while it has no allocation and never restores it; the WinForms distance is kept and re-applied on allocation and re-show. The events are raised for user drags and for a changed SplitterDistance, not for GTK clamps or resizes. FixedPanel.None lets both panels resize.
---
 .../Forms/SplitContainerDistanceTests.cs      | 276 ++++++++++++++++++
 .../System/Windows/Forms/SplitContainer.cs    | 202 ++++++++++++-
 2 files changed, 472 insertions(+), 6 deletions(-)
 create mode 100644 Gtk.Windows.Forms.Tests/System/Windows/Forms/SplitContainerDistanceTests.cs

diff --git a/Gtk.Windows.Forms.Tests/System/Windows/Forms/SplitContainerDistanceTests.cs b/Gtk.Windows.Forms.Tests/System/Windows/Forms/SplitContainerDistanceTests.cs
new file mode 100644
index 00000000..9d1ae920
--- /dev/null
+++ b/Gtk.Windows.Forms.Tests/System/Windows/Forms/SplitContainerDistanceTests.cs
@@ -0,0 +1,276 @@
+using System.Diagnostics;
+using System.Drawing;
+
+namespace System.Windows.Forms;
+
+/// <summary>
+/// SplitterDistance is a WinForms value that has to survive GTK clamping the paned's position while the
+/// control is hidden or has no allocation, and SplitterMoving/SplitterMoved report real moves only.
+/// WinForms: the distance persists while hidden/unsized and is honoured once the control has its size; setting
+/// it raises SplitterMoved; the user dragging raises SplitterMoving (cancellable) then SplitterMoved.
+/// Needs a display (real windows, pumped main loop).
+/// </summary>
+[Collection("NonParallelCollection")]
+public class SplitContainerDistanceTests
+{
+    private static bool PumpUntil(Func<bool> condition, int timeoutMs = 5000)
+    {
+        var watch = Stopwatch.StartNew();
+        while (watch.ElapsedMilliseconds < timeoutMs)
+        {
+            Application.DoEvents();
+            if (condition())
+            {
+                return true;
+            }
+
+            Threading.Thread.Sleep(15);
+        }
+
+        return condition();
+    }
+
+    private static void Settle(int ms)
+    {
+        var watch = Stopwatch.StartNew();
+        while (watch.ElapsedMilliseconds < ms)
+        {
+            Application.DoEvents();
+            Threading.Thread.Sleep(15);
+        }
+    }
+
+    private static bool Allocated(SplitContainer split) => split.self.AllocatedWidth > 1;
+
+    private static Form HostedSplit(out Panel host, out SplitContainer split, bool hostVisible = true)
+    {
+        var form = new Form { ClientSize = new Size(800, 400) };
+        form.SuspendLayout();
+        host = new Panel { Location = new Point(0, 0), Size = new Size(700, 300), Visible = hostVisible };
+        split = new SplitContainer { Location = new Point(0, 0), Size = new Size(700, 300) };
+        host.Controls.Add(split);
+        form.Controls.Add(host);
+        form.ResumeLayout(false);
+
+        return form;
+    }
+
+    [Fact]
+    public void DistanceSetBeforeShow_IsHonouredOnceTheControlHasItsSize()
+    {
+        var form = HostedSplit(out _, out var split);
+        split.SplitterDistance = 300;
+        try
+        {
+            form.Show();
+            Assert.True(PumpUntil(() => Allocated(split)));
+            Settle(1500);
+
+            Assert.Equal(300, split.SplitterDistance);
+            Assert.Equal(295, split.self.Position);
+        }
+        finally
+        {
+            form.Close();
+        }
+    }
+
+    [Fact]
+    public void DistanceSurvivesTheParentBeingHiddenAtStartAndShownLater_WithoutMoveEvents()
+    {
+        var form = HostedSplit(out var host, out var split, hostVisible: false);
+        split.SplitterDistance = 443;
+        var moved = 0;
+        var moving = 0;
+        split.SplitterMoved += (_, _) => moved++;
+        split.SplitterMoving += (_, _) => moving++;
+        var anchor = new Button { Location = new Point(0, 320), Size = new Size(50, 24) };
+        form.Controls.Add(anchor);
+        try
+        {
+            form.Show();
+            Assert.True(PumpUntil(() => anchor.Widget!.AllocatedWidth > 1));
+            Settle(1000);
+            Assert.Equal(443, split.SplitterDistance);
+
+            host.Visible = true;
+            Assert.True(PumpUntil(() => Allocated(split)));
+            Settle(1500);
+
+            Assert.Equal(443, split.SplitterDistance);
+            Assert.Equal(438, split.self.Position);
+            Assert.Equal(0, moved);
+            Assert.Equal(0, moving);
+        }
+        finally
+        {
+            form.Close();
+        }
+    }
+
+    // The case seen in an application: visible with a distance, its parent hidden (a tab switch), shown again.
+    [Fact]
+    public void DistanceSurvivesTheParentBeingHiddenAndShownAgain()
+    {
+        var form = HostedSplit(out var host, out var split);
+        split.SplitterDistance = 443;
+        var moved = 0;
+        try
+        {
+            form.Show();
+            Assert.True(PumpUntil(() => Allocated(split)));
+            Settle(1500);
+            Assert.Equal(443, split.SplitterDistance);
+            split.SplitterMoved += (_, _) => moved++;
+
+            host.Visible = false;
+            Settle(800);
+            Assert.Equal(443, split.SplitterDistance);
+
+            host.Visible = true;
+            Assert.True(PumpUntil(() => Allocated(split)));
+            Settle(1500);
+
+            Assert.Equal(443, split.SplitterDistance);
+            Assert.Equal(438, split.self.Position);
+            Assert.Equal(0, moved);
+        }
+        finally
+        {
+            form.Close();
+        }
+    }
+
+    [Fact]
+    public void DistanceSetWhileHidden_IsHonouredOnShow()
+    {
+        var form = HostedSplit(out var host, out var split, hostVisible: false);
+        var anchor = new Button { Location = new Point(0, 320), Size = new Size(50, 24) };
+        form.Controls.Add(anchor);
+        try
+        {
+            form.Show();
+            Assert.True(PumpUntil(() => anchor.Widget!.AllocatedWidth > 1));
+            Settle(500);
+            split.SplitterDistance = 250;
+            Assert.Equal(250, split.SplitterDistance);
+
+            host.Visible = true;
+            Assert.True(PumpUntil(() => Allocated(split)));
+            Settle(1500);
+
+            Assert.Equal(250, split.SplitterDistance);
+            Assert.Equal(245, split.self.Position);
+        }
+        finally
+        {
+            form.Close();
+        }
+    }
+
+    [Fact]
+    public void DistanceIsKeptWhenTheControlIsResized_WithPanel1Fixed()
+    {
+        var form = HostedSplit(out var host, out var split);
+        split.FixedPanel = FixedPanel.Panel1;
+        split.SplitterDistance = 200;
+        var moved = 0;
+        try
+        {
+            form.Show();
+            Assert.True(PumpUntil(() => Allocated(split)));
+            Settle(1500);
+            split.SplitterMoved += (_, _) => moved++;
+
+            host.Size = new Size(760, 300);
+            split.Size = new Size(760, 300);
+            Assert.True(PumpUntil(() => split.self.AllocatedWidth == 760));
+            Settle(800);
+
+            Assert.Equal(200, split.SplitterDistance);
+            Assert.Equal(0, moved);
+        }
+        finally
+        {
+            form.Close();
+        }
+    }
+
+    [Fact]
+    public void SettingTheDistance_RaisesSplitterMovedOnlyWhenItChanges()
+    {
+        var form = HostedSplit(out _, out var split);
+        try
+        {
+            form.Show();
+            Assert.True(PumpUntil(() => Allocated(split)));
+            Settle(1500);
+            var args = new List<SplitterEventArgs>();
+            split.SplitterMoved += (_, e) => args.Add(e);
+
+            split.SplitterDistance = 220;
+            split.SplitterDistance = 220;
+            split.SplitterDistance = 180;
+            Settle(300);
+
+            Assert.Equal(2, args.Count);
+            Assert.Equal(220, args[0].SplitX);
+            Assert.Equal(180, args[1].SplitX);
+        }
+        finally
+        {
+            form.Close();
+        }
+    }
+
+    // A user drag changes the paned's position while the control is allocated: Moving (cancellable) then Moved.
+    [Fact]
+    public void AUserMove_RaisesMovingThenMoved_AndCancellingPutsTheSplitterBack()
+    {
+        var form = HostedSplit(out _, out var split);
+        split.SplitterDistance = 300;
+        var order = new List<string>();
+        try
+        {
+            form.Show();
+            Assert.True(PumpUntil(() => Allocated(split)));
+            Settle(1500);
+            split.SplitterMoving += (_, e) => order.Add("moving:" + e.SplitX);
+            split.SplitterMoved += (_, e) => order.Add("moved:" + e.SplitX);
+
+            split.self.Position = 150;
+            Settle(300);
+
+            Assert.Equal(new[] { "moving:155", "moved:155" }, order);
+            Assert.Equal(155, split.SplitterDistance);
+
+            order.Clear();
+            split.SplitterMoving += (_, e) => e.Cancel = true;
+            split.self.Position = 100;
+            Settle(300);
+
+            Assert.Equal(new[] { "moving:105" }, order);
+            Assert.Equal(155, split.SplitterDistance);
+        }
+        finally
+        {
+            form.Close();
+        }
+    }
+
+    [Fact]
+    public void FixedPanelNone_LetsBothPanelsResize()
+    {
+        var split = new SplitContainer { FixedPanel = FixedPanel.None };
+        Assert.True(split.self.ResizeStartChild);
+        Assert.True(split.self.ResizeEndChild);
+
+        split.FixedPanel = FixedPanel.Panel1;
+        Assert.False(split.self.ResizeStartChild);
+        Assert.True(split.self.ResizeEndChild);
+
+        split.FixedPanel = FixedPanel.Panel2;
+        Assert.True(split.self.ResizeStartChild);
+        Assert.False(split.self.ResizeEndChild);
+    }
+}
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/SplitContainer.cs b/Gtk.Windows.Forms/System/Windows/Forms/SplitContainer.cs
index 140db4d3..7464f42d 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/SplitContainer.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/SplitContainer.cs
@@ -48,6 +48,11 @@ public partial class SplitContainer : ContainerControl
         _panel2.self.contaner.Name = "Child2";
         self.StartChild = _panel1.Widget;
         self.EndChild = _panel2.Widget;
+
+        // GTK clamps the paned's position while it has no allocation (hidden parent, or not yet laid out) and
+        // never restores it, so the WinForms distance is kept here and re-applied once there is room.
+        self.AddNotification("position", (_, _) => OnGtkPositionChanged());
+        self.Mapped += (_, _) => BeginReapplyDistance();
     }
 
     /// <summary>
@@ -62,10 +67,10 @@ public partial class SplitContainer : ContainerControl
         set
         {
             _fixedPanel = value;
-            var resize = value == FixedPanel.Panel2;
-            // Gtk4: Paned.PanedChild/indexer removed; per-child resize is ResizeStart/EndChild.
-            self.ResizeStartChild = resize;
-            self.ResizeEndChild = !resize;
+            // Gtk4: Paned.PanedChild/indexer removed; per-child resize is ResizeStart/EndChild. The fixed panel
+            // keeps its size; with None both panels resize.
+            self.ResizeStartChild = value != FixedPanel.Panel1;
+            self.ResizeEndChild = value != FixedPanel.Panel2;
         }
     }
 
@@ -151,10 +156,195 @@ public partial class SplitContainer : ContainerControl
     /// <value>
     /// The splitter distance.
     /// </value>
+    /// <remarks>
+    /// The value persists while the control is hidden or has no size yet (GTK clamps its own position then) and
+    /// is applied as soon as the control is allocated, again after it is shown anew. Setting it raises
+    /// <see cref="SplitterMoved" /> when the value changes, as WinForms does; a user drag raises
+    /// <see cref="SplitterMoving" /> (cancellable) and <see cref="SplitterMoved" />. GTK's own clamping is
+    /// not a move and raises nothing. The paned's position is the distance less the legacy 5 px handle offset.
+    /// </remarks>
     public int SplitterDistance
     {
-        get => self.Position + 5;
-        set { _SplitterDistance = Math.Max(1, value - 5); self.Position = _SplitterDistance; }
+        get
+        {
+            if (_requestedDistance >= 0 && (!IsAllocatedAlongAxis() || self.Position == _appliedPosition))
+            {
+                return _requestedDistance;
+            }
+
+            return self.Position + 5;
+        }
+        set
+        {
+            var previous = SplitterDistance;
+            _requestedDistance = Math.Max(1, value);
+            _SplitterDistance = Math.Max(1, value - 5);
+            ApplyDistance();
+            var current = SplitterDistance;
+            if (current != previous)
+            {
+                OnSplitterMoved(new SplitterEventArgs(0, 0, current, 0));
+            }
+        }
+    }
+
+    /// <summary>Occurs when the splitter is being moved by the user; cancelling puts it back.</summary>
+    public event SplitterCancelEventHandler? SplitterMoving;
+
+    /// <summary>Occurs when the splitter has moved, by the user or by setting <see cref="SplitterDistance" />.</summary>
+    public event SplitterEventHandler? SplitterMoved;
+
+    /// <summary>Raises the <see cref="SplitterMoving" /> event.</summary>
+    /// <param name="e">The event data.</param>
+    protected virtual void OnSplitterMoving(SplitterCancelEventArgs e) => SplitterMoving?.Invoke(this, e);
+
+    /// <summary>Raises the <see cref="SplitterMoved" /> event.</summary>
+    /// <param name="e">The event data.</param>
+    protected virtual void OnSplitterMoved(SplitterEventArgs e) => SplitterMoved?.Invoke(this, e);
+
+    /// <summary>The distance last asked for, in WinForms terms (-1 = never set).</summary>
+    private int _requestedDistance = -1;
+
+    /// <summary>The paned position this control last wrote.</summary>
+    private int _appliedPosition = -1;
+
+    /// <summary>Set while this control writes the paned position, so its notification is not a move.</summary>
+    private bool _applyingDistance;
+
+    /// <summary>The allocation along the splitter's axis at the last notification.</summary>
+    private int _lastAxisAllocation;
+
+    /// <summary>While true GTK's position notifications are clamps, not moves (mapped, not yet re-applied).</summary>
+    private bool _reapplyPending;
+
+    private int AxisAllocation() =>
+        self.Orientation == Gtk.Orientation.Horizontal ? self.AllocatedWidth : self.AllocatedHeight;
+
+    private bool IsAllocatedAlongAxis() => AxisAllocation() > 1;
+
+    /// <summary>Writes the requested distance to the paned, clamped to what the allocation can hold.</summary>
+    private void ApplyDistance()
+    {
+        if (_requestedDistance < 0)
+        {
+            return;
+        }
+
+        var target = Math.Max(1, _requestedDistance - 5);
+        var axis = AxisAllocation();
+        if (axis > 1)
+        {
+            target = Math.Min(target, Math.Max(1, axis - 1));
+        }
+
+        _appliedPosition = target;
+        if (self.Position == target)
+        {
+            return;
+        }
+
+        _applyingDistance = true;
+        try
+        {
+            self.Position = target;
+        }
+        finally
+        {
+            _applyingDistance = false;
+        }
+    }
+
+    /// <summary>The control was mapped (first show, or shown again): re-apply the distance once it has room.</summary>
+    private void BeginReapplyDistance()
+    {
+        if (_requestedDistance < 0)
+        {
+            return;
+        }
+
+        _reapplyPending = true;
+        _lastAxisAllocation = 0;
+        var tries = 0;
+        GLib.Timeout.Add(30, () =>
+        {
+            if (self.Handle == IntPtr.Zero)
+            {
+                return false;
+            }
+
+            if (IsAllocatedAlongAxis())
+            {
+                _lastAxisAllocation = AxisAllocation();
+                ApplyDistance();
+                _reapplyPending = false;
+
+                return false;
+            }
+
+            if (++tries < 100)
+            {
+                return true;
+            }
+
+            _reapplyPending = false;
+
+            return false;
+        });
+    }
+
+    /// <summary>GTK reported a new paned position: a user move, a resize, or a clamp.</summary>
+    private void OnGtkPositionChanged()
+    {
+        if (_applyingDistance || _reapplyPending || !self.IsMapped)
+        {
+            return;
+        }
+
+        var axis = AxisAllocation();
+        if (axis <= 1)
+        {
+            // GTK clamping a control that has no room (yet).
+            return;
+        }
+
+        var distance = self.Position + 5;
+        if (axis != _lastAxisAllocation)
+        {
+            // The control was resized: GTK moved the position by its own rule (the fixed panel keeps its
+            // size, with None the panels share the change). Not a move; just follow.
+            _lastAxisAllocation = axis;
+            _requestedDistance = distance;
+            _appliedPosition = self.Position;
+
+            return;
+        }
+
+        if (distance == _requestedDistance)
+        {
+            return;
+        }
+
+        var previousPosition = _appliedPosition >= 0 ? _appliedPosition : _requestedDistance - 5;
+        var args = new SplitterCancelEventArgs(0, 0, distance, 0);
+        OnSplitterMoving(args);
+        if (args.Cancel)
+        {
+            _applyingDistance = true;
+            try
+            {
+                self.Position = Math.Max(1, previousPosition);
+            }
+            finally
+            {
+                _applyingDistance = false;
+            }
+
+            return;
+        }
+
+        _requestedDistance = distance;
+        _appliedPosition = self.Position;
+        OnSplitterMoved(new SplitterEventArgs(0, 0, distance, 0));
     }
 
     /// <summary>
