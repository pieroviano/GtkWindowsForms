Subject: [PATCH] Fixing Gtk.Drawing

---
 .../System/Drawing/Drawing2D/Bitmap.cs        |  6 +-----
 .../System/Drawing/Drawing2D/Image.cs         |  6 ++----
 Net4x.Gtk.Drawing/System/Drawing/Icon.cs      | 20 ++++++++++++++++---
 3 files changed, 20 insertions(+), 12 deletions(-)

diff --git a/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/Bitmap.cs b/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/Bitmap.cs
index 26429a57..362d998e 100644
--- a/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/Bitmap.cs
+++ b/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/Bitmap.cs
@@ -1,11 +1,7 @@
-using System.ComponentModel;
+﻿using System.ComponentModel;
 using System.Drawing.Imaging;
-using System.IO;
 using System.Runtime.InteropServices;
 using System.Runtime.Serialization;
-using Cairo;
-using Gdk;
-using Pango;
 
 namespace System.Drawing;
 
diff --git a/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/Image.cs b/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/Image.cs
index 6a1a68d1..d6ebf72e 100644
--- a/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/Image.cs
+++ b/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/Image.cs
@@ -1,7 +1,5 @@
-using System.ComponentModel;
-using System.Diagnostics.CodeAnalysis;
+﻿using System.ComponentModel;
 using System.Drawing.Imaging;
-using System.Globalization;
 using System.Runtime.InteropServices;
 using System.Runtime.Serialization;
 
@@ -15,7 +13,7 @@ namespace System.Drawing;
 /// <filterpriority>1
 /// </filterpriority>
 [Serializable]
-public abstract class Image : Gtk.Widget, IDisposable, ICloneable, ISerializable//,MarshalByRefObject
+public abstract class Image : Gtk.Widget, IDisposable, ICloneable, ISerializable
 {
 
     internal IntPtr nativeImage;
diff --git a/Net4x.Gtk.Drawing/System/Drawing/Icon.cs b/Net4x.Gtk.Drawing/System/Drawing/Icon.cs
index 923efba6..f124502c 100644
--- a/Net4x.Gtk.Drawing/System/Drawing/Icon.cs
+++ b/Net4x.Gtk.Drawing/System/Drawing/Icon.cs
@@ -1,4 +1,4 @@
-using System.ComponentModel;
+﻿using System.ComponentModel;
 using System.IO;
 using System.Runtime.Serialization;
 using Gdk;
@@ -305,7 +305,14 @@ public sealed class Icon : MarshalByRefObject, ICloneable, IDisposable, ISeriali
 
             return _Pixbuf;
         }
-        set { _Pixbuf = value; _PixbufData = value.SaveToBuffer("bmp"); }
+        set
+        {
+            _Pixbuf = value;
+            if (value != null)
+            {
+                _PixbufData = value.SaveToBuffer("bmp");
+            }
+        }
     }
 
     /// <summary>
@@ -322,7 +329,14 @@ public sealed class Icon : MarshalByRefObject, ICloneable, IDisposable, ISeriali
 
             return _PixbufData;
         }
-        set { _PixbufData = value; _Pixbuf = new Gdk.Pixbuf((byte[])value.Clone()); }
+        set
+        {
+            _PixbufData = value;
+            if (value != null)
+            {
+                _Pixbuf = new Gdk.Pixbuf((byte[])value.Clone());
+            }
+        }
     }
 
     /// <summary>
