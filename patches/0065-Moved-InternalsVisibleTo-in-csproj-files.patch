From f61e1c0049bc9b183fe1a04ea1e9296dcc3bd08f Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Date: Thu, 9 Apr 2026 05:57:55 +0300
Subject: [PATCH] Moved InternalsVisibleTo in csproj files

---
 Gtk.Drawing/Gtk.Drawing.csproj                | 8 ++++++++
 Gtk.Drawing/Properties/InternalsVisibleTo.cs        | 4 ----
 .../Gtk.Windows.Extensions.csproj                   | 5 +++++
 .../Properties/InternalsVisibleTo.cs                      | 3 ---
 Gtk.Windows.Forms/Gtk.Windows.Forms.csproj    | 5 +++++
 Gtk.Windows.Forms/Properties/InternalsVisibleTo.cs  | 3 ---
 6 files changed, 18 insertions(+), 10 deletions(-)
 delete mode 100644 Gtk.Drawing/Properties/InternalsVisibleTo.cs
 delete mode 100644 Gtk.Windows.Extensions/Properties/InternalsVisibleTo.cs
 delete mode 100644 Gtk.Windows.Forms/Properties/InternalsVisibleTo.cs

diff --git a/Gtk.Drawing/Gtk.Drawing.csproj b/Gtk.Drawing/Gtk.Drawing.csproj
index 44e2bc3..1b7d4af 100644
--- a/Gtk.Drawing/Gtk.Drawing.csproj
+++ b/Gtk.Drawing/Gtk.Drawing.csproj
@@ -41,6 +41,14 @@
         <NoWarn>$(NoWarn);CS8002;CS0067;CS0169;CS0419;CS0436;CS0414;CS3021;CS8002</NoWarn>
         <PackageId>Gtk.Drawing</PackageId>
     </PropertyGroup>
+    <ItemGroup>
+        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
+            <_Parameter1>Gtk.Windows.Forms.Tests, </_Parameter1>
+        </AssemblyAttribute>
+        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
+            <_Parameter1>Gtk.Drawing.Tests, </_Parameter1>
+        </AssemblyAttribute>
+    </ItemGroup>
     <ItemGroup>
         <Compile Include="..\Gtk.Windows.Forms\System\Diagnostics\CodeAnalysis\NotNullWhenAttribute.cs" Link="System\Diagnostics\CodeAnalysis\NotNullWhenAttribute.cs" />
     </ItemGroup>
diff --git a/Gtk.Drawing/Properties/InternalsVisibleTo.cs b/Gtk.Drawing/Properties/InternalsVisibleTo.cs
deleted file mode 100644
index fc118a9..0000000
--- a/Gtk.Drawing/Properties/InternalsVisibleTo.cs
+++ /dev/null
@@ -1,4 +0,0 @@
-﻿using System.Runtime.CompilerServices;
-
-[assembly: InternalsVisibleTo("Gtk.Windows.Forms.Tests, ")]
-[assembly: InternalsVisibleTo("Gtk.Drawing.Tests, ")]
diff --git a/Gtk.Windows.Extensions/Gtk.Windows.Extensions.csproj b/Gtk.Windows.Extensions/Gtk.Windows.Extensions.csproj
index 9001f71..3f82286 100644
--- a/Gtk.Windows.Extensions/Gtk.Windows.Extensions.csproj
+++ b/Gtk.Windows.Extensions/Gtk.Windows.Extensions.csproj
@@ -27,6 +27,11 @@
         <None Remove="Resources\**" />
         <None Remove="System.Windows.Forms\**" />
     </ItemGroup>
+    <ItemGroup>
+        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
+            <_Parameter1>Gtk.Windows.Forms.Tests, </_Parameter1>
+        </AssemblyAttribute>
+    </ItemGroup>
     <ItemGroup>
         <PackageReference Include="Net4x.NuGetUtility" Version="$(NuGetUtilityVersion)" PrivateAssets="All" />
     </ItemGroup>
diff --git a/Gtk.Windows.Extensions/Properties/InternalsVisibleTo.cs b/Gtk.Windows.Extensions/Properties/InternalsVisibleTo.cs
deleted file mode 100644
index adde6f4..0000000
--- a/Gtk.Windows.Extensions/Properties/InternalsVisibleTo.cs
+++ /dev/null
@@ -1,3 +0,0 @@
-﻿using System.Runtime.CompilerServices;
-
-[assembly: InternalsVisibleTo("Gtk.Windows.Forms.Tests, ")]
diff --git a/Gtk.Windows.Forms/Gtk.Windows.Forms.csproj b/Gtk.Windows.Forms/Gtk.Windows.Forms.csproj
index 41cb43f..0c25a01 100644
--- a/Gtk.Windows.Forms/Gtk.Windows.Forms.csproj
+++ b/Gtk.Windows.Forms/Gtk.Windows.Forms.csproj
@@ -41,6 +41,11 @@ Based on GTKSystem.Windows.Forms:
     <ItemGroup>
         <None Include="$(MSBuildProjectName).xml" Pack="true" PackagePath="\Documentation.xml" />
     </ItemGroup>
+    <ItemGroup>
+        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
+            <_Parameter1>Gtk.Windows.Forms.Tests, </_Parameter1>
+        </AssemblyAttribute>
+    </ItemGroup>
     <ItemGroup>
         <Compile Remove="GTKControls\Interface\**" />
         <Compile Remove="GTKControls\Struct\**" />
diff --git a/Gtk.Windows.Forms/Properties/InternalsVisibleTo.cs b/Gtk.Windows.Forms/Properties/InternalsVisibleTo.cs
deleted file mode 100644
index adde6f4..0000000
--- a/Gtk.Windows.Forms/Properties/InternalsVisibleTo.cs
+++ /dev/null
@@ -1,3 +0,0 @@
-﻿using System.Runtime.CompilerServices;
-
-[assembly: InternalsVisibleTo("Gtk.Windows.Forms.Tests, ")]
-- 
2.51.1.windows.1

