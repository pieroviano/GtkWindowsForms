From dab582e8e013c0ebc430a3a8dc80cc92c009bae6 Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Date: Fri, 3 Apr 2026 03:45:19 +0300
Subject: [PATCH] Fix PropertyStore

---
 .../Windows/Forms/Collection/PropertyStore.cs | 63 +++++++++++++++++--
 .../System/Windows/Forms/Enum/Padding.cs      |  8 +++
 2 files changed, 67 insertions(+), 4 deletions(-)

diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Collection/PropertyStore.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Collection/PropertyStore.cs
index 9ada8b7..87eb68c 100644
--- a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Collection/PropertyStore.cs
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Collection/PropertyStore.cs
@@ -582,11 +582,39 @@ internal partial class PropertyStore
     /// </summary>
     private bool LocateIntegerEntry(short entryKey, out int index)
     {
+        if (_intEntries is null || _intEntries.Length == 0)
+        {
+            index = 0;
+            return false;
+        }
 
-        index = 0;
+        var low = 0;
+        var high = _intEntries.Length - 1;
 
-        return false;
+        while (low <= high)
+        {
+            var mid = (low + high) / 2;
+            var midKey = _intEntries[mid].Key;
 
+            if (midKey == entryKey)
+            {
+                index = mid;
+                return true;
+            }
+
+            if (midKey < entryKey)
+            {
+                low = mid + 1;
+            }
+            else
+            {
+                high = mid - 1;
+            }
+        }
+
+        // Not found → insertion index
+        index = low;
+        return false;
     }
 
     /// <summary>
@@ -599,11 +627,38 @@ internal partial class PropertyStore
     /// </summary>
     private bool LocateObjectEntry(short entryKey, out int index)
     {
+        if (_objEntries is null || _objEntries.Length == 0)
+        {
+            index = 0;
+            return false;
+        }
 
-        index = 0;
+        var low = 0;
+        var high = _objEntries.Length - 1;
 
-        return false;
+        while (low <= high)
+        {
+            var mid = (low + high) / 2;
+            var midKey = _objEntries[mid].Key;
 
+            if (midKey == entryKey)
+            {
+                index = mid;
+                return true;
+            }
+
+            if (midKey < entryKey)
+            {
+                low = mid + 1;
+            }
+            else
+            {
+                high = mid - 1;
+            }
+        }
+
+        index = low;
+        return false;
     }
 
     /// <summary>
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Enum/Padding.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Enum/Padding.cs
index cf1fa1c..1a9e687 100644
--- a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Enum/Padding.cs
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Enum/Padding.cs
@@ -182,6 +182,14 @@ public struct Padding
     /// </returns>
     public override bool Equals(object other)
     {
+        if (other is Padding p)
+        {
+            return Left == p.Left
+                && Top == p.Top
+                && Right == p.Right
+                && Bottom == p.Bottom;
+        }
+
         return false;
     }
 
