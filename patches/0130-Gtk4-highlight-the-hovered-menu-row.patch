From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Subject: [PATCH] Gtk4: highlight the hovered menu row, as Gtk3 did

Gtk3 drew the hovered menu row in the theme's selection colours, courtesy of
GtkMenuItem. Gtk4 has no menu-item widget, so a drop-down row fell back to the
theme's plain button hover and the menu gave almost no feedback about which
entry the pointer was on.

The rules load through the existing User-priority provider, because the theme's
own button:hover would otherwise win. Menu-bar entries are excluded so they keep
the strip's own hover.

The background goes on the row's button and the foreground only on its caption
row: a drop-down popover is parented to the button, so an inheritable colour
there cascades into the submenu it opens and repaints its captions white on
white. A test pins that scoping, since it is not obvious from reading the rule.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
diff --git a/Gtk.Windows.Forms.Tests/System/Windows/Forms/StripMenuItemRenderingTests.cs b/Gtk.Windows.Forms.Tests/System/Windows/Forms/StripMenuItemRenderingTests.cs
index 2d031d6f..2d1dedff 100644
--- a/Gtk.Windows.Forms.Tests/System/Windows/Forms/StripMenuItemRenderingTests.cs
+++ b/Gtk.Windows.Forms.Tests/System/Windows/Forms/StripMenuItemRenderingTests.cs
@@ -238,6 +238,34 @@ public class StripMenuItemRenderingTests
         Assert.False(icon.Visible, "clearing Image must clear the icon, not leave the old one on screen");
     }
 
+    [Fact]
+    public void HoveredMenuRow_IsStyledWithTheSelectionColours_ButNotMenuBarEntries()
+    {
+        // Gtk3 drew the hovered menu row in the theme's selection colours via GtkMenuItem; Gtk4 has no
+        // menu-item widget, so a drop-down row was left with the theme's plain button hover and gave no
+        // feedback about which entry the pointer was on. The rules must sit at User priority, or the
+        // theme's own button:hover wins.
+        var css = Application.UserPriorityCss;
+
+        Assert.Contains(".MenuItemButton:not(.MenuBarItem):hover", css);
+        Assert.Contains("@theme_selected_bg_color", css);
+    }
+
+    [Fact]
+    public void HoverForeground_IsScopedToTheCaptionRow_SoItCannotCascadeIntoAnOpenSubmenu()
+    {
+        // The drop-down popover is parented to the row's button, so an inheritable colour on the button
+        // reaches every caption inside the submenu it opens and paints them white on white - the menu then
+        // renders empty. The foreground rule must therefore target the caption row, never the button.
+        foreach (var rule in Application.UserPriorityCss.Split('\n'))
+        {
+            if (rule.Contains("@theme_selected_fg_color"))
+            {
+                Assert.Contains(">box", rule);
+            }
+        }
+    }
+
     [Fact]
     public void MenuBarItem_DropsItsMenuDownwards()
     {
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs b/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs
index bd4a0406..2fc41917 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs
@@ -513,6 +513,28 @@ public sealed partial class Application
     /// </summary>
     /// <returns>
     /// </returns>
+    /// <summary>
+    /// Rules that have to beat the theme's own, so they are loaded through a separate provider at
+    /// <see cref="Gtk.StyleProviderPriority.User" /> rather than with the bulk stylesheet.
+    /// </summary>
+    /// <remarks>
+    /// The menu-row hover rules live here because the theme's own <c>button:hover</c> would otherwise win.
+    /// Note how the two halves are scoped: the background goes on the row's button, the foreground only on
+    /// <c>&gt;box</c>, its caption row. A drop-down popover is parented to the button, so an inheritable
+    /// colour on the button itself cascades into the submenu it opens and repaints every caption there in
+    /// the selected foreground - white on white, which reads as an empty menu.
+    /// </remarks>
+    internal static string UserPriorityCss =>
+        ".ToolStripButtonFlat,.ToolStripButtonFlat>button{border:none;border-width:0px;border-style:none;outline:none;background:none;background-image:none;box-shadow:none;border-radius:0px;padding:1px 4px;min-height:6px;min-width:6px;}\n"
+        + ".ToolStripButtonFlat:hover,.ToolStripButtonFlat>button:hover{background-color:shade(@theme_bg_color,0.9);}\n"
+        + ".ToolStripButtonFlat:active,.ToolStripButtonFlat:checked,.ToolStripButtonFlat>button:active,.ToolStripButtonFlat>button:checked{background-color:shade(@theme_bg_color,0.82);}\n"
+        // Gtk3 drew the hovered menu row in the theme's selection colours, courtesy of GtkMenuItem. Gtk4 has
+        // no menu-item widget, so a drop-down row was left with the theme's plain button hover and the menu
+        // gave no feedback about which entry the pointer was on. Menu-bar entries keep the strip's own
+        // hover, which is why the rules exclude them.
+        + ".MenuItemButton:not(.MenuBarItem):hover{background-color:@theme_selected_bg_color;}\n"
+        + ".MenuItemButton:not(.MenuBarItem):hover>box label{color:@theme_selected_fg_color;}";
+
     public static Gtk.Application Init()
     {
         if (App == null)
@@ -787,10 +809,7 @@ tooltip label {padding: 0px 10px; color: #555555;}
             // Application priority, so force the flat, borderless look via a dedicated User-priority provider
             // (the same priority the per-item style overrides use, which is proven to take effect here).
             var toolStripFlat = new Gtk.CssProvider();
-            toolStripFlat.LoadFromData(
-                ".ToolStripButtonFlat,.ToolStripButtonFlat>button{border:none;border-width:0px;border-style:none;outline:none;background:none;background-image:none;box-shadow:none;border-radius:0px;padding:1px 4px;min-height:6px;min-width:6px;}\n"
-                + ".ToolStripButtonFlat:hover,.ToolStripButtonFlat>button:hover{background-color:shade(@theme_bg_color,0.9);}\n"
-                + ".ToolStripButtonFlat:active,.ToolStripButtonFlat:checked,.ToolStripButtonFlat>button:active,.ToolStripButtonFlat>button:checked{background-color:shade(@theme_bg_color,0.82);}");
+            toolStripFlat.LoadFromData(UserPriorityCss);
             Gtk.StyleContext.AddProviderForDisplay(Gdk.Display.Default, toolStripFlat, (uint)StyleProviderPriority.User);
         }
 
