diff --git a/Gtk.Windows.Forms.Tests/System/Windows/Forms/ControlScalingFunctionalTests.cs b/Gtk.Windows.Forms.Tests/System/Windows/Forms/ControlScalingFunctionalTests.cs
new file mode 100644
index 00000000..d7277434
