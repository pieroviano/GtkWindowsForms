diff --git a/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/StripMenuItem.cs b/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/StripMenuItem.cs
index 41135c2e..cdc81d5d 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/StripMenuItem.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/StripMenuItem.cs
@@ -193,13 +193,22 @@ namespace System.Windows.Forms
 
         public Gtk.Widget MenuItem { get => this; }
 
+        private string _text = string.Empty;
+
+        /// <summary>
+        /// The caption as WinForms wrote it, <c>&amp;</c> mnemonic markers included. The label holds GTK's
+        /// spelling of it (see <see cref="Mnemonics" />), which reads back without the markers.
+        /// </summary>
         public string Text
         {
-            get => textLabel.Text;
+            get => _text;
             set
             {
-                textLabel.Text = value ?? string.Empty;
-                textLabel.Visible = !string.IsNullOrEmpty(value);
+                _text = value ?? string.Empty;
+                textLabel.Text = Mnemonics.ToGtk(_text);
+                textLabel.UseUnderline = true; // set_text clears the flag, so it goes on afterwards
+                textLabel.MnemonicWidget = checkButton; // Alt+<key> activates the item, as in WinForms
+                textLabel.Visible = _text.Length > 0;
             }
         }
 
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/StripMenuToolButton.cs b/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/StripMenuToolButton.cs
index be1e638c..de927a1b 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/StripMenuToolButton.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/StripMenuToolButton.cs
@@ -75,6 +75,15 @@ namespace System.Windows.Forms
         /// from the current image/text honouring <see cref="DisplayStyle"/>; falls back to whatever content
         /// is available when the style is unset (None). The dropdown arrow is kept via AlwaysShowArrow.
         /// </summary>
+        private Gtk.Label CreateCaption()
+        {
+            // The caption's '&' marks a mnemonic (see Mnemonics); Alt+<key> activates the button.
+            var caption = new Gtk.Label(Mnemonics.ToGtk(_text)) { Visible = true };
+            caption.UseUnderline = true; // the text setter clears the flag, so it goes on afterwards
+            caption.MnemonicWidget = this;
+            return caption;
+        }
+
         internal void RebuildContent()
         {
             bool wantImage = _displayStyle != ToolStripItemDisplayStyle.Text && _image != null;
@@ -84,7 +93,7 @@ namespace System.Windows.Forms
             {
                 var box = new Gtk.Box(Gtk.Orientation.Horizontal, 4) { Visible = true };
                 box.Append(new Gtk.Image(_image) { Visible = true });
-                box.Append(new Gtk.Label(_text) { Visible = true });
+                box.Append(CreateCaption());
                 this.Child = box;
             }
             else if (wantImage)
@@ -93,7 +102,7 @@ namespace System.Windows.Forms
             }
             else if (wantText)
             {
-                this.Child = new Gtk.Label(_text) { Visible = true };
+                this.Child = CreateCaption();
             }
         }
     }
