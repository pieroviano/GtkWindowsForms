From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 22 Jul 2026 00:00:00 +0000
Subject: [PATCH] Fix Net4x.Gtk.Drawing defects found by functional tests

Behavioural defects surfaced by the Net4x.Gtk.Drawing.Tests functional suite:

Bitmap/Image
 - the pixel buffer was never allocated, so a new Bitmap had no pixels
 - GetPixel/SetPixel addressed the wrong bytes and never invalidated the cache
 - scaling, cloning, MakeTransparent, LockBits/UnlockBits and RotateFlip were stubs
 - Save(Stream, ImageFormat) ignored the requested format
 - HorizontalResolution/VerticalResolution, PhysicalDimension and GetBounds were hard-coded

Graphics
 - Dispose did not flush, so drawing could be lost
 - SetClip(Region) was missing; SetClip(GraphicsPath), ExcludeClip and IntersectClip(Region) were no-ops
 - TranslateClip(int, int) called itself and overflowed the stack
 - ResetTransform only undid rotation; MultiplyTransform mutated a throwaway copy
 - the Transform property threw on get and ignored set
 - ConvertToMatrix applied the default zero scale (collapsing every matrix), passed degrees to Cairo as
   radians, and passed null to Cairo.Matrix.Multiply (a native abort)
 - clip bounds, DPI, TextRenderingHint, containers, TransformPoints, MeasureCharacterRanges,
   image blitting and curve drawing were stubs or wrong

GraphicsPath / Matrix / Region / Font / Icon
 - Reset did not clear the path; Transform ignored the stored primitives
 - IsOutlineVisible reported the filled interior as being on the outline
 - Matrix.TransformPoints/TransformVectors did not apply the transform; Translate did not move it;
   OffsetX/OffsetY did not track dx/dy
 - Region.Translate did not move the region, IsEmpty called an infinite region empty, and RegionData
   carried nothing so a Region could not be round-tripped
 - Font.Height/GetHeight and Icon.Size were stubs

---
diff --git a/Net4x.Gtk.Drawing/System/Drawing/Bitmap.cs b/Net4x.Gtk.Drawing/System/Drawing/Bitmap.cs
index b6ec9d3a..d4cbf94a 100644
--- a/Net4x.Gtk.Drawing/System/Drawing/Bitmap.cs
+++ b/Net4x.Gtk.Drawing/System/Drawing/Bitmap.cs
@@ -233,6 +233,16 @@ public class Bitmap : Image
         this.Width = width;
         this.Height = height;
         this.PixelFormat = format;
+
+        // Allocate a real, writable pixel buffer (fully transparent) so GetPixel/SetPixel and Save operate
+        // on actual pixels rather than an empty image. Invalid (non-positive) dimensions are left without a
+        // pixbuf so that consumers such as Graphics.FromImage still reject them.
+        if (width > 0 && height > 0)
+        {
+            var pixbuf = new Gdk.Pixbuf(Gdk.Colorspace.Rgb, true, 8, width, height);
+            pixbuf.Fill(0x00000000u);
+            this.Pixbuf = pixbuf;
+        }
     }
 
     /// <summary>
@@ -294,7 +304,16 @@ public class Bitmap : Image
     public Bitmap(Image original, int width, int height)
         : this(width, height, PixelFormat.Format32bppArgb)
     {
-        this.PixbufData = original.PixbufData;
+        // Actually scale the source to the requested size rather than copying its raw data unchanged.
+        var source = original.Pixbuf;
+        if (source != null)
+        {
+            this.Pixbuf = source.ScaleSimple(Math.Max(1, width), Math.Max(1, height), Gdk.InterpType.Bilinear);
+        }
+        else
+        {
+            this.PixbufData = original.PixbufData;
+        }
     }
 
     internal Bitmap(byte[]? pixbuf) : base(pixbuf)
@@ -384,8 +403,29 @@ public class Bitmap : Image
     /// </exception>
     public Bitmap Clone(Rectangle rect, PixelFormat format)
     {
+        // Previously this copied the WHOLE source buffer into the clone, which also reset the clone's
+        // size back to the source's - so the requested sub-rectangle was ignored entirely.
+        var clone = new Bitmap(rect.Width, rect.Height, format);
+        var source = this.Pixbuf;
+        var target = clone.Pixbuf;
+
+        if (source == null || target == null || rect.Width <= 0 || rect.Height <= 0)
+        {
+            clone.PixbufData = (byte[]?)this.PixbufData?.Clone();
+            return clone;
+        }
 
-        return new Bitmap(rect.Width, rect.Height, format) { PixbufData = (byte[]?)this.PixbufData?.Clone() };
+        var x = Math.Max(0, Math.Min(rect.X, source.Width));
+        var y = Math.Max(0, Math.Min(rect.Y, source.Height));
+        var width = Math.Min(rect.Width, source.Width - x);
+        var height = Math.Min(rect.Height, source.Height - y);
+        if (width > 0 && height > 0)
+        {
+            source.CopyArea(x, y, width, height, target, 0, 0);
+            clone.InvalidatePixbufDataCache();
+        }
+
+        return clone;
     }
 
     /// <summary>
@@ -502,8 +542,25 @@ public class Bitmap : Image
     /// </exception>
     public Color GetPixel(int x, int y)
     {
+        var pixbuf = this.Pixbuf;
+        if (pixbuf == null)
+        {
+            return Color.Empty;
+        }
 
-        return Color.FromArgb(x * y);
+        if (x < 0 || y < 0 || x >= pixbuf.Width || y >= pixbuf.Height)
+        {
+            throw new ArgumentOutOfRangeException(x < 0 || x >= pixbuf.Width ? nameof(x) : nameof(y));
+        }
+
+        var channels = pixbuf.NChannels;
+        var offset = (y * pixbuf.Rowstride) + (x * channels);
+        var pixels = pixbuf.Pixels;
+        byte r = Marshal.ReadByte(pixels, offset);
+        byte g = Marshal.ReadByte(pixels, offset + 1);
+        byte b = Marshal.ReadByte(pixels, offset + 2);
+        byte a = channels >= 4 ? Marshal.ReadByte(pixels, offset + 3) : (byte)255;
+        return Color.FromArgb(a, r, g, b);
     }
 
     /// <summary>
@@ -581,7 +638,26 @@ public class Bitmap : Image
     /// </exception>
     public BitmapData LockBits(Rectangle rect, ImageLockMode flags, PixelFormat format, BitmapData bitmapData)
     {
+        // Was returning an unpopulated BitmapData (all zeroes). Describe the real pixel buffer so callers
+        // can read/write it, pointing Scan0 at the requested rectangle's first pixel.
+        bitmapData ??= new BitmapData();
+
+        var pixbuf = this.Pixbuf;
+        if (pixbuf == null)
+        {
+            return bitmapData;
+        }
+
+        var x = Math.Max(0, Math.Min(rect.X, pixbuf.Width));
+        var y = Math.Max(0, Math.Min(rect.Y, pixbuf.Height));
+        var width = rect.Width <= 0 ? pixbuf.Width - x : Math.Min(rect.Width, pixbuf.Width - x);
+        var height = rect.Height <= 0 ? pixbuf.Height - y : Math.Min(rect.Height, pixbuf.Height - y);
 
+        bitmapData.Width = Math.Max(0, width);
+        bitmapData.Height = Math.Max(0, height);
+        bitmapData.Stride = pixbuf.Rowstride;
+        bitmapData.PixelFormat = format;
+        bitmapData.Scan0 = IntPtr.Add(pixbuf.Pixels, (y * pixbuf.Rowstride) + (x * pixbuf.NChannels));
         return bitmapData;
     }
 
@@ -626,7 +702,24 @@ public class Bitmap : Image
     /// </exception>
     public void MakeTransparent(Color transparentColor)
     {
+        // Was a no-op, so the requested colour never became transparent.
+        var pixbuf = this.Pixbuf;
+        if (pixbuf == null)
+        {
+            return;
+        }
 
+        for (var y = 0; y < pixbuf.Height; y++)
+        {
+            for (var x = 0; x < pixbuf.Width; x++)
+            {
+                var c = GetPixel(x, y);
+                if (c.R == transparentColor.R && c.G == transparentColor.G && c.B == transparentColor.B)
+                {
+                    SetPixel(x, y, Color.FromArgb(0, c.R, c.G, c.B));
+                }
+            }
+        }
     }
 
     /// <summary>
@@ -648,7 +741,31 @@ public class Bitmap : Image
     /// </exception>
     public void SetPixel(int x, int y, Color color)
     {
+        var pixbuf = this.Pixbuf;
+        if (pixbuf == null)
+        {
+            return;
+        }
 
+        if (x < 0 || y < 0 || x >= pixbuf.Width || y >= pixbuf.Height)
+        {
+            throw new ArgumentOutOfRangeException(x < 0 || x >= pixbuf.Width ? nameof(x) : nameof(y));
+        }
+
+        var channels = pixbuf.NChannels;
+        var offset = (y * pixbuf.Rowstride) + (x * channels);
+        var pixels = pixbuf.Pixels;
+        Marshal.WriteByte(pixels, offset, color.R);
+        Marshal.WriteByte(pixels, offset + 1, color.G);
+        Marshal.WriteByte(pixels, offset + 2, color.B);
+        if (channels >= 4)
+        {
+            Marshal.WriteByte(pixels, offset + 3, color.A);
+        }
+
+        // Pixels were mutated in place; drop only the cached encoding (not the live pixbuf) so
+        // PixbufData/Save re-encode from the current pixels.
+        InvalidatePixbufDataCache();
     }
 
     /// <summary>
@@ -668,7 +785,8 @@ public class Bitmap : Image
     /// </exception>
     public void SetResolution(float xDpi, float yDpi)
     {
-
+        // Was empty, so HorizontalResolution/VerticalResolution never reflected the requested DPI.
+        SetResolutionCore(xDpi, yDpi);
     }
 
     /// <summary>
@@ -684,7 +802,8 @@ public class Bitmap : Image
     /// </exception>
     public void UnlockBits(BitmapData bitmapdata)
     {
-
+        // The caller may have written through Scan0, so drop the cached encoding.
+        InvalidatePixbufDataCache();
     }
 
     private static Stream GetResourceStream(Type type, string resource)
diff --git a/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/GraphicsPath.cs b/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/GraphicsPath.cs
index 6d68f841..5ed28f50 100644
--- a/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/GraphicsPath.cs
+++ b/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/GraphicsPath.cs
@@ -1623,12 +1623,17 @@ public sealed class GraphicsPath : MarshalByRefObject, ICloneable, IDisposable
     /// /// </summary>
     public bool IsOutlineVisible(PointF point, Pen pen)
     {
-        // conservative: check whether point falls inside bounds inflated by pen width
+        // Approximated with the path bounds: the outline is the band of pen width straddling the bounds
+        // edge. Testing only the inflated bounds reported the whole filled interior as "on the outline".
         if (pen == null) throw new ArgumentNullException(nameof(pen));
         var b = GetBounds();
         if (b.IsEmpty) return false;
-        var inflated = RectangleF.Inflate(b, pen.Width / 2f, pen.Width / 2f);
-        return inflated.Contains(point);
+        var half = pen.Width / 2f;
+        var inflated = RectangleF.Inflate(b, half, half);
+        if (!inflated.Contains(point)) return false;
+        var deflated = RectangleF.Inflate(b, -half, -half);
+        if (deflated.Width <= 0f || deflated.Height <= 0f) return true;
+        return !deflated.Contains(point);
     }
 
     /// <summary>
@@ -1801,6 +1806,11 @@ public sealed class GraphicsPath : MarshalByRefObject, ICloneable, IDisposable
     {
         this.PathPoints = null;
         this.PathTypes = null;
+        this.PointCount = 0;
+        // Also clear the accumulated geometry the figure/bounds/hit-testing use, otherwise a "reset" path
+        // still reports the old bounds and segments.
+        this.SizePoints.Clear();
+        this.list.Clear();
         this.FillMode = FillMode.Alternate;
     }
 
@@ -1853,6 +1863,82 @@ public sealed class GraphicsPath : MarshalByRefObject, ICloneable, IDisposable
             matrix.TransformPoints(arr);
             SizePoints[i] = arr[0];
         }
+
+        // Also transform the stored primitives. Without this the shapes kept their original coordinates,
+        // so GetBounds/hit-testing ignored the transform entirely (and Region.Translate appeared to do
+        // nothing). Rect-based shapes are mapped through their corners, i.e. a rotation yields the
+        // bounding box of the rotated shape - exact for translation/scale.
+        foreach (var o in list)
+        {
+            switch (o)
+            {
+                case ArcMode am: am.rect = TransformRectangle(matrix, am.rect); break;
+                case EllipseMode em: em.rect = TransformRectangle(matrix, em.rect); break;
+                case PieMode pm: pm.rect = TransformRectangle(matrix, pm.rect); break;
+                case RectangleMode rm: rm.rect = TransformRectangle(matrix, rm.rect); break;
+                case StringMode sm: sm.layoutRect = TransformRectangle(matrix, sm.layoutRect); break;
+                case RectanglesMode rsm:
+                    if (rsm.rects != null)
+                    {
+                        for (var i = 0; i < rsm.rects.Length; i++)
+                        {
+                            rsm.rects[i] = TransformRectangle(matrix, rsm.rects[i]);
+                        }
+                    }
+
+                    break;
+                case LineMode lm:
+                    {
+                        var pts = new[] { lm.pt1, lm.pt2 };
+                        matrix.TransformPoints(pts);
+                        lm.pt1 = pts[0];
+                        lm.pt2 = pts[1];
+                    }
+
+                    break;
+                case BezierMode bm:
+                    {
+                        var pts = new[] { bm.pt1, bm.pt2, bm.pt3, bm.pt4 };
+                        matrix.TransformPoints(pts);
+                        bm.pt1 = pts[0];
+                        bm.pt2 = pts[1];
+                        bm.pt3 = pts[2];
+                        bm.pt4 = pts[3];
+                    }
+
+                    break;
+                case BeziersMode bzs: if (bzs.points != null) matrix.TransformPoints(bzs.points); break;
+                case LinesMode lsm: if (lsm.points != null) matrix.TransformPoints(lsm.points); break;
+                case PolygonMode pol: if (pol.points != null) matrix.TransformPoints(pol.points); break;
+                case ClosedCurveMode ccm: if (ccm.points != null) matrix.TransformPoints(ccm.points); break;
+                case CurveMode cm: if (cm.points != null) matrix.TransformPoints(cm.points); break;
+            }
+        }
+    }
+
+    /// <summary>Maps a rectangle through <paramref name="matrix"/> and returns the bounding box of the result.</summary>
+    private static RectangleF TransformRectangle(Matrix matrix, RectangleF rect)
+    {
+        var pts = new[]
+        {
+            new PointF(rect.Left, rect.Top),
+            new PointF(rect.Right, rect.Top),
+            new PointF(rect.Right, rect.Bottom),
+            new PointF(rect.Left, rect.Bottom)
+        };
+
+        matrix.TransformPoints(pts);
+
+        float left = pts[0].X, top = pts[0].Y, right = pts[0].X, bottom = pts[0].Y;
+        foreach (var p in pts)
+        {
+            if (p.X < left) left = p.X;
+            if (p.X > right) right = p.X;
+            if (p.Y < top) top = p.Y;
+            if (p.Y > bottom) bottom = p.Y;
+        }
+
+        return new RectangleF(left, top, right - left, bottom - top);
     }
 
