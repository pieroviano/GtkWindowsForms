@@ -0,0 +1,63 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+namespace System.Drawing;
+
+/// <summary>
+/// Specifies the fonts used to display text in Windows display elements.
+/// </summary>
+/// <remarks>
+/// This type was missing entirely, so layout code reading a system font did not compile. Each property
+/// returns a fresh <see cref="T:System.Drawing.Font" />, as the framework does, so the caller owns it and
+/// may dispose it.
+/// </remarks>
+public static class SystemFonts
+{
+    /// <summary>The family used for every system font on this platform.</summary>
+    private const string DefaultFamily = "Sans";
+
+    /// <summary>The point size of the standard UI fonts.</summary>
+    private const float DefaultSize = 9f;
+
+    /// <summary>Gets the font used for captions of active windows.</summary>
+    public static Font CaptionFont => new(DefaultFamily, DefaultSize, FontStyle.Bold);
+
+    /// <summary>Gets the default font used for dialog boxes and forms.</summary>
+    public static Font DefaultFont => new(DefaultFamily, DefaultSize);
+
+    /// <summary>Gets the font used for dialog box text.</summary>
+    public static Font DialogFont => new(DefaultFamily, DefaultSize);
+
+    /// <summary>Gets the font used for icon titles.</summary>
+    public static Font IconTitleFont => new(DefaultFamily, DefaultSize);
+
+    /// <summary>Gets the font used for menus.</summary>
+    public static Font MenuFont => new(DefaultFamily, DefaultSize);
+
+    /// <summary>Gets the font used for message boxes.</summary>
+    public static Font MessageBoxFont => new(DefaultFamily, DefaultSize);
+
+    /// <summary>Gets the font used for captions of small windows, such as tool windows.</summary>
+    public static Font SmallCaptionFont => new(DefaultFamily, DefaultSize - 1f, FontStyle.Bold);
+
+    /// <summary>Gets the font used to display text in the status bar.</summary>
+    public static Font StatusFont => new(DefaultFamily, DefaultSize);
+
+    /// <summary>
+    /// Returns the font associated with the specified Windows system font name.
+    /// </summary>
+    /// <param name="systemFontName">The name of a system font, such as <c>MenuFont</c>.</param>
+    /// <returns>The matching font, or <see langword="null" /> when the name is not recognised.</returns>
+    public static Font? GetFontByName(string? systemFontName) => systemFontName switch
+    {
+        nameof(CaptionFont) => CaptionFont,
+        nameof(DefaultFont) => DefaultFont,
+        nameof(DialogFont) => DialogFont,
+        nameof(IconTitleFont) => IconTitleFont,
+        nameof(MenuFont) => MenuFont,
+        nameof(MessageBoxFont) => MessageBoxFont,
+        nameof(SmallCaptionFont) => SmallCaptionFont,
+        nameof(StatusFont) => StatusFont,
+        _ => null
+    };
+}
diff --git a/Net4x.Gtk.Drawing/System/Drawing/SystemIcons.cs b/Net4x.Gtk.Drawing/System/Drawing/SystemIcons.cs
new file mode 100644
index 00000000..977ae8c4
--- /dev/null
+++ b/Net4x.Gtk.Drawing/System/Drawing/SystemIcons.cs
@@ -0,0 +1,137 @@
+namespace System.Drawing;
+
+/// <summary>
+/// Each property of the <see cref="T:System.Drawing.SystemIcons" /> class is an
+/// <see cref="T:System.Drawing.Icon" /> for a Windows system-wide icon.
+/// </summary>
+/// <remarks>
+/// This type was missing entirely, so custom message dialogs using <c>SystemIcons.Error</c> and friends did
+/// not compile. The icons are rendered from the GTK icon theme where it supplies a match, and drawn
+/// programmatically otherwise, so no icon assets need to be shipped with the library.
+/// </remarks>
+public static class SystemIcons
+{
+    /// <summary>The edge length of a generated icon, in pixels.</summary>
+    private const int IconSize = 32;
+
+    /// <summary>Gets an icon for the application.</summary>
+    public static Icon Application => FromTheme("application-x-executable", Color.FromArgb(255, 90, 90, 90), Shape.Square);
+
+    /// <summary>Gets an icon containing an asterisk, used for information messages.</summary>
+    public static Icon Asterisk => Information;
+
+    /// <summary>Gets an icon containing an exclamation mark.</summary>
+    public static Icon Exclamation => Warning;
+
+    /// <summary>Gets an icon containing a red circle with a white cross, used for error messages.</summary>
+    public static Icon Error => FromTheme("dialog-error", Color.FromArgb(255, 200, 40, 40), Shape.Circle);
+
+    /// <summary>Gets an icon containing a red circle with a white cross.</summary>
+    public static Icon Hand => Error;
+
+    /// <summary>Gets an icon containing a blue circle with an "i", used for information messages.</summary>
+    public static Icon Information => FromTheme("dialog-information", Color.FromArgb(255, 40, 110, 200), Shape.Circle);
+
+    /// <summary>Gets an icon containing a question mark.</summary>
+    public static Icon Question => FromTheme("dialog-question", Color.FromArgb(255, 40, 110, 200), Shape.Circle);
+
+    /// <summary>Gets an icon containing a yellow triangle with an exclamation mark.</summary>
+    public static Icon Warning => FromTheme("dialog-warning", Color.FromArgb(255, 220, 170, 20), Shape.Triangle);
+
+    /// <summary>Gets an icon containing a shield.</summary>
+    public static Icon Shield => FromTheme("security-high", Color.FromArgb(255, 60, 130, 190), Shape.Shield);
+
+    /// <summary>Gets an icon for a window.</summary>
+    public static Icon WinLogo => Application;
+
+    /// <summary>The fallback outline drawn when the icon theme has no match.</summary>
+    private enum Shape
+    {
+        Circle,
+        Triangle,
+        Square,
+        Shield
+    }
+
+    /// <summary>
+    /// Loads <paramref name="themeName" /> from the GTK icon theme, falling back to a drawn placeholder.
+    /// </summary>
+    /// <param name="themeName">The freedesktop icon name to look for.</param>
+    /// <param name="fallbackColor">The colour of the drawn placeholder.</param>
+    /// <param name="shape">The outline of the drawn placeholder.</param>
+    private static Icon FromTheme(string themeName, Color fallbackColor, Shape shape)
+    {
+        try
+        {
+            var theme = Gtk.IconTheme.Default;
+            if (theme != null && theme.HasIcon(themeName))
+            {
+                var pixbuf = theme.LoadIcon(themeName, IconSize, Gtk.IconLookupFlags.UseBuiltin);
+                if (pixbuf != null)
+                {
+                    return IconFromPixbuf(pixbuf);
+                }
+            }
+        }
+        catch (Exception ex)
+        {
+            Diagnostics.GtkLogger.Debug($"SystemIcons could not load '{themeName}' from the icon theme: {ex.Message}");
+        }
+
+        return Draw(fallbackColor, shape);
+    }
+
+    /// <summary>
+    /// Draws a simple placeholder icon in the given colour and shape.
+    /// </summary>
+    private static Icon Draw(Color color, Shape shape)
+    {
+        using var surface = new Cairo.ImageSurface(Cairo.Format.Argb32, IconSize, IconSize);
+        using (var context = new Cairo.Context(surface))
+        {
+            context.SetSourceRGBA(color.R / 255d, color.G / 255d, color.B / 255d, 1d);
+            switch (shape)
+            {
+                case Shape.Circle:
+                    context.Arc(IconSize / 2d, IconSize / 2d, (IconSize / 2d) - 2d, 0d, 2d * Math.PI);
+                    break;
+
+                case Shape.Triangle:
+                    context.MoveTo(IconSize / 2d, 2d);
+                    context.LineTo(IconSize - 2d, IconSize - 3d);
+                    context.LineTo(2d, IconSize - 3d);
+                    context.ClosePath();
+                    break;
+
+                case Shape.Shield:
+                    context.MoveTo(IconSize / 2d, 2d);
+                    context.LineTo(IconSize - 4d, 8d);
+                    context.LineTo(IconSize / 2d, IconSize - 2d);
+                    context.LineTo(4d, 8d);
+                    context.ClosePath();
+                    break;
+
+                default:
+                    context.Rectangle(3d, 3d, IconSize - 6d, IconSize - 6d);
+                    break;
+            }
+
+            context.Fill();
+        }
+
+        surface.Flush();
+
+        return IconFromPixbuf(new Gdk.Pixbuf(surface, 0, 0, IconSize, IconSize));
+    }
+
+    /// <summary>
+    /// Wraps a pixbuf in an <see cref="T:System.Drawing.Icon" />.
+    /// </summary>
+    private static Icon IconFromPixbuf(Gdk.Pixbuf pixbuf)
+    {
+        var bitmap = new Bitmap(pixbuf.Width, pixbuf.Height) { Pixbuf = pixbuf };
+        using var stream = new IO.MemoryStream(pixbuf.SaveToBuffer("png"));
+
+        return new Icon(stream);
+    }
+}
diff --git a/Net4x.Gtk.Drawing/System/Drawing/TextureBrush.cs b/Net4x.Gtk.Drawing/System/Drawing/TextureBrush.cs
new file mode 100644
index 00000000..f72da1a8
--- /dev/null
+++ b/Net4x.Gtk.Drawing/System/Drawing/TextureBrush.cs
@@ -0,0 +1,239 @@
+using System.Drawing.Drawing2D;
+using System.Drawing.Imaging;
+
+namespace System.Drawing;
+
+/// <summary>
+/// Each property of the <see cref="T:System.Drawing.TextureBrush" /> class is a
+/// <see cref="T:System.Drawing.Brush" /> object that uses an image to fill the interior of a shape.
+/// </summary>
+/// <remarks>
+/// This was the one core GDI+ brush type the shim did not have — <see cref="T:System.Drawing.SolidBrush" />,
+/// <see cref="T:System.Drawing.Drawing2D.HatchBrush" />,
+/// <see cref="T:System.Drawing.Drawing2D.LinearGradientBrush" /> and
+/// <see cref="T:System.Drawing.Drawing2D.PathGradientBrush" /> were all present. Cairo supports surface
+/// patterns with repeat modes natively, which is what backs this class.
+/// </remarks>
+public sealed class TextureBrush : Brush
+{
+    /// <summary>
+    /// Initializes a new <see cref="T:System.Drawing.TextureBrush" /> that uses the specified image.
+    /// </summary>
+    /// <param name="bitmap">The image to fill with.</param>
+    public TextureBrush(Image bitmap) : this(bitmap, WrapMode.Tile)
+    {
+    }
+
+    /// <summary>
+    /// Initializes a new <see cref="T:System.Drawing.TextureBrush" /> that uses the specified image and
+    /// wrap mode.
+    /// </summary>
+    /// <param name="image">The image to fill with.</param>
+    /// <param name="wrapMode">How the image is tiled when it is smaller than the area being filled.</param>
+    public TextureBrush(Image image, WrapMode wrapMode)
+    {
+        Image = image ?? throw new ArgumentNullException(nameof(image));
+        WrapMode = wrapMode;
+        ImageRectangle = new RectangleF(0f, 0f, image.Width, image.Height);
+        Transform = new Matrix();
+    }
+
+    /// <summary>
+    /// Initializes a new <see cref="T:System.Drawing.TextureBrush" /> that uses the specified region of the
+    /// specified image.
+    /// </summary>
+    /// <param name="image">The image to fill with.</param>
+    /// <param name="dstRect">The region of <paramref name="image" /> to use.</param>
+    public TextureBrush(Image image, Rectangle dstRect) : this(image, WrapMode.Tile)
+    {
+        ImageRectangle = new RectangleF(dstRect.X, dstRect.Y, dstRect.Width, dstRect.Height);
+    }
+
+    /// <summary>
+    /// Initializes a new <see cref="T:System.Drawing.TextureBrush" /> that uses the specified region of the
+    /// specified image.
+    /// </summary>
+    /// <param name="image">The image to fill with.</param>
+    /// <param name="dstRect">The region of <paramref name="image" /> to use.</param>
+    public TextureBrush(Image image, RectangleF dstRect) : this(image, WrapMode.Tile)
+    {
+        ImageRectangle = dstRect;
+    }
+
+    /// <summary>
+    /// Initializes a new <see cref="T:System.Drawing.TextureBrush" /> that uses the specified image, wrap
+    /// mode and region.
+    /// </summary>
+    /// <param name="image">The image to fill with.</param>
+    /// <param name="wrapMode">How the image is tiled.</param>
+    /// <param name="dstRect">The region of <paramref name="image" /> to use.</param>
+    public TextureBrush(Image image, WrapMode wrapMode, Rectangle dstRect) : this(image, wrapMode)
+    {
+        ImageRectangle = new RectangleF(dstRect.X, dstRect.Y, dstRect.Width, dstRect.Height);
+    }
+
+    /// <summary>
+    /// Initializes a new <see cref="T:System.Drawing.TextureBrush" /> that uses the specified image, wrap
+    /// mode and region.
+    /// </summary>
+    /// <param name="image">The image to fill with.</param>
+    /// <param name="wrapMode">How the image is tiled.</param>
+    /// <param name="dstRect">The region of <paramref name="image" /> to use.</param>
+    public TextureBrush(Image image, WrapMode wrapMode, RectangleF dstRect) : this(image, wrapMode)
+    {
+        ImageRectangle = dstRect;
+    }
+
+    /// <summary>
+    /// Initializes a new <see cref="T:System.Drawing.TextureBrush" /> that uses the specified image and
+    /// image attributes.
+    /// </summary>
+    /// <param name="image">The image to fill with.</param>
+    /// <param name="dstRect">The region of <paramref name="image" /> to use.</param>
+    /// <param name="imageAttr">Additional image attributes; kept for compatibility.</param>
+    public TextureBrush(Image image, RectangleF dstRect, ImageAttributes? imageAttr) : this(image, dstRect)
+    {
+        ImageAttributes = imageAttr;
+    }
+
+    /// <summary>
+    /// Initializes a new <see cref="T:System.Drawing.TextureBrush" /> that uses the specified image and
+    /// image attributes.
+    /// </summary>
+    /// <param name="image">The image to fill with.</param>
+    /// <param name="dstRect">The region of <paramref name="image" /> to use.</param>
+    /// <param name="imageAttr">Additional image attributes; kept for compatibility.</param>
+    public TextureBrush(Image image, Rectangle dstRect, ImageAttributes? imageAttr) : this(image, dstRect)
+    {
+        ImageAttributes = imageAttr;
+    }
+
+    /// <summary>
+    /// Gets the image this brush fills with.
+    /// </summary>
+    public Image Image { get; }
+
+    /// <summary>
+    /// Gets the region of <see cref="P:System.Drawing.TextureBrush.Image" /> this brush draws.
+    /// </summary>
+    public RectangleF ImageRectangle { get; private set; }
+
+    /// <summary>
+    /// Gets or sets the wrap mode used when the fill area is larger than the image.
+    /// </summary>
+    public WrapMode WrapMode { get; set; }
+
+    /// <summary>
+    /// Gets or sets the transform applied to the image before it is drawn.
+    /// </summary>
+    public Matrix Transform { get; set; }
+
+    /// <summary>
+    /// Gets the image attributes supplied when the brush was created, if any.
+    /// </summary>
+    public ImageAttributes? ImageAttributes { get; private set; }
+
+    /// <summary>
+    /// Creates an exact copy of this brush.
+    /// </summary>
+    /// <returns>The copy.</returns>
+    public override object Clone() => new TextureBrush(Image, WrapMode, ImageRectangle)
+    {
+        Transform = Transform,
+        ImageAttributes = ImageAttributes
+    };
+
+    /// <summary>
+    /// Resets the transform of this brush to the identity matrix.
+    /// </summary>
+    public void ResetTransform() => Transform = new Matrix();
+
+    /// <summary>
+    /// Multiplies the transform of this brush by the specified matrix.
+    /// </summary>
+    /// <param name="matrix">The matrix to multiply by.</param>
+    public void MultiplyTransform(Matrix matrix) => MultiplyTransform(matrix, MatrixOrder.Prepend);
+
+    /// <summary>
+    /// Multiplies the transform of this brush by the specified matrix in the specified order.
+    /// </summary>
+    /// <param name="matrix">The matrix to multiply by.</param>
+    /// <param name="order">The order in which to apply the multiplication.</param>
+    public void MultiplyTransform(Matrix matrix, MatrixOrder order)
+    {
+        if (matrix == null)
+        {
+            return;
+        }
+
+        Transform.Multiply(matrix, order);
+    }
+
+    /// <summary>
+    /// Translates the transform of this brush by the specified amounts.
+    /// </summary>
+    /// <param name="dx">The horizontal offset.</param>
+    /// <param name="dy">The vertical offset.</param>
+    public void TranslateTransform(float dx, float dy) => Transform.Translate(dx, dy);
+
+    /// <summary>
+    /// Translates the transform of this brush by the specified amounts in the specified order.
+    /// </summary>
+    /// <param name="dx">The horizontal offset.</param>
+    /// <param name="dy">The vertical offset.</param>
+    /// <param name="order">The order in which to apply the translation.</param>
+    public void TranslateTransform(float dx, float dy, MatrixOrder order) => Transform.Translate(dx, dy, order);
+
+    /// <summary>
+    /// Scales the transform of this brush by the specified amounts.
+    /// </summary>
+    /// <param name="sx">The horizontal scale factor.</param>
+    /// <param name="sy">The vertical scale factor.</param>
+    public void ScaleTransform(float sx, float sy) => Transform.Scale(sx, sy);
+
+    /// <summary>
+    /// Scales the transform of this brush by the specified amounts in the specified order.
+    /// </summary>
+    /// <param name="sx">The horizontal scale factor.</param>
+    /// <param name="sy">The vertical scale factor.</param>
+    /// <param name="order">The order in which to apply the scaling.</param>
+    public void ScaleTransform(float sx, float sy, MatrixOrder order) => Transform.Scale(sx, sy, order);
+
+    /// <summary>
+    /// Rotates the transform of this brush by the specified angle.
+    /// </summary>
+    /// <param name="angle">The angle of rotation, in degrees.</param>
+    public void RotateTransform(float angle) => Transform.Rotate(angle);
+
+    /// <summary>
+    /// Rotates the transform of this brush by the specified angle in the specified order.
+    /// </summary>
+    /// <param name="angle">The angle of rotation, in degrees.</param>
+    /// <param name="order">The order in which to apply the rotation.</param>
+    public void RotateTransform(float angle, MatrixOrder order) => Transform.Rotate(angle, order);
+
+    /// <summary>
+    /// Builds the Cairo pattern that paints this texture, honouring the wrap mode.
+    /// </summary>
+    /// <returns>The pattern, or <see langword="null" /> when the image has no pixels.</returns>
+    internal Cairo.Pattern? CreatePattern()
+    {
+        var pixbuf = Image.Pixbuf;
+        if (pixbuf == null)
+        {
+            return null;
+        }
+
+        var surface = new Cairo.ImageSurface(Cairo.Format.Argb32, pixbuf.Width, pixbuf.Height);
+        using (var context = new Cairo.Context(surface))
+        {
+            Gdk.CairoHelper.SetSourcePixbuf(context, pixbuf, 0, 0);
+            context.Paint();
+        }
+
+        return new Cairo.SurfacePattern(surface)
+        {
+            Extend = WrapMode == WrapMode.Clamp ? Cairo.Extend.None : Cairo.Extend.Repeat
+        };
+    }
+}
diff --git a/Net4x.Gtk.Drawing/System/Drawing/ToolboxBitmapAttribute.cs b/Net4x.Gtk.Drawing/System/Drawing/ToolboxBitmapAttribute.cs
new file mode 100644
index 00000000..4d3cd03f
--- /dev/null
+++ b/Net4x.Gtk.Drawing/System/Drawing/ToolboxBitmapAttribute.cs
@@ -0,0 +1,194 @@
+using System.IO;
+using System.Reflection;
+
+namespace System.Drawing;
+
+/// <summary>
+/// Specifies the image used to represent a component in the Visual Studio toolbox.
+/// </summary>
+/// <remarks>
+/// This attribute was missing, which made it a compile break on the *declaration* of any custom control —
+/// <c>[ToolboxBitmap(typeof(MyControl), "icon.bmp")]</c> — rather than at a call site, so an entire
+/// custom-control library failed to build. The image is resolved from the declaring type's assembly
+/// resources or from disk; a missing image yields <see langword="null" /> rather than an exception, which
+/// is what the framework does.
+/// </remarks>
+[AttributeUsage(AttributeTargets.Class)]
+public class ToolboxBitmapAttribute : Attribute
+{
+    /// <summary>The edge length of the small image the toolbox uses.</summary>
+    private const int SmallImageSize = 16;
+
+    private readonly string? _imageFile;
+
+    private readonly Type? _imageType;
+
+    private readonly string? _imageName;
+
+    private Image? _smallImage;
+
+    private Image? _largeImage;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="T:System.Drawing.ToolboxBitmapAttribute" /> class with
+    /// an image loaded from the given file.
+    /// </summary>
+    /// <param name="imageFile">The path of the image file.</param>
+    public ToolboxBitmapAttribute(string imageFile)
+    {
+        _imageFile = imageFile;
+    }
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="T:System.Drawing.ToolboxBitmapAttribute" /> class with
+    /// an image loaded from the assembly of the given type.
+    /// </summary>
+    /// <param name="t">A type whose assembly contains the image resource.</param>
+    public ToolboxBitmapAttribute(Type t)
+    {
+        _imageType = t;
+        _imageName = t?.Name;
+    }
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="T:System.Drawing.ToolboxBitmapAttribute" /> class with
+    /// the named image resource from the assembly of the given type.
+    /// </summary>
+    /// <param name="t">A type whose assembly contains the image resource.</param>
+    /// <param name="name">The name of the embedded resource.</param>
+    public ToolboxBitmapAttribute(Type t, string name)
+    {
+        _imageType = t;
+        _imageName = name;
+    }
+
+    /// <summary>
+    /// The default attribute, carrying no image.
+    /// </summary>
+    public static readonly ToolboxBitmapAttribute Default = new(string.Empty);
+
+    /// <summary>
+    /// Returns the small (16x16) image for the component, or <see langword="null" /> when there is none.
+    /// </summary>
+    /// <param name="component">The component whose image is wanted.</param>
+    public Image? GetImage(object? component) => GetImage(component, true);
+
+    /// <summary>
+    /// Returns the image for the component, or <see langword="null" /> when there is none.
+    /// </summary>
+    /// <param name="component">The component whose image is wanted.</param>
+    /// <param name="large">Whether the large image is wanted.</param>
+    public Image? GetImage(object? component, bool large) =>
+        GetImage(component?.GetType(), large);
+
+    /// <summary>
+    /// Returns the small (16x16) image for the type, or <see langword="null" /> when there is none.
+    /// </summary>
+    /// <param name="type">The type whose image is wanted.</param>
+    public Image? GetImage(Type? type) => GetImage(type, false);
+
+    /// <summary>
+    /// Returns the image for the type, or <see langword="null" /> when there is none.
+    /// </summary>
+    /// <param name="type">The type whose image is wanted.</param>
+    /// <param name="large">Whether the large image is wanted.</param>
+    public Image? GetImage(Type? type, bool large) => GetImage(type, null, large);
+
+    /// <summary>
+    /// Returns the named image from the type's assembly, or <see langword="null" /> when there is none.
+    /// </summary>
+    /// <param name="type">The type whose assembly holds the resource.</param>
+    /// <param name="imgName">The name of the resource, or <see langword="null" /> to use the attribute's.</param>
+    /// <param name="large">Whether the large image is wanted.</param>
+    public Image? GetImage(Type? type, string? imgName, bool large)
+    {
+        var cached = large ? _largeImage : _smallImage;
+        if (cached != null)
+        {
+            return cached;
+        }
+
+        var loaded = Load(type ?? _imageType, imgName ?? _imageName);
+        if (loaded == null)
+        {
+            return null;
+        }
+
+        if (large)
+        {
+            _largeImage = loaded;
+
+            return _largeImage;
+        }
+
+        _smallImage = loaded.Width == SmallImageSize && loaded.Height == SmallImageSize
+            ? loaded
+            : loaded.GetThumbnailImage(SmallImageSize, SmallImageSize, () => false, IntPtr.Zero);
+
+        return _smallImage;
+    }
+
+    /// <summary>
+    /// Returns the image a type's <see cref="T:System.Drawing.ToolboxBitmapAttribute" /> names, or
+    /// <see langword="null" /> when the type carries no such attribute.
+    /// </summary>
+    /// <param name="type">The type to inspect.</param>
+    /// <param name="imageName">The name of the resource, or <see langword="null" /> to use the type name.</param>
+    /// <param name="large">Whether the large image is wanted.</param>
+    public static Image? GetImageFromResource(Type type, string? imageName, bool large) =>
+        new ToolboxBitmapAttribute(type, imageName ?? type?.Name ?? string.Empty).GetImage(type, imageName, large);
+
+    /// <summary>
+    /// Loads the image from the type's assembly resources, then from disk, and gives up quietly.
+    /// </summary>
+    private Image? Load(Type? type, string? name)
+    {
+        try
+        {
+            if (!string.IsNullOrEmpty(_imageFile) && File.Exists(_imageFile))
+            {
+                return Image.FromFile(_imageFile!);
+            }
+
+            if (type == null || string.IsNullOrEmpty(name))
+            {
+                return null;
+            }
+
+            var assembly = type.GetTypeInfo().Assembly;
+            foreach (var candidate in new[] { name!, type.Namespace + "." + name, type.FullName + ".bmp" })
+            {
+                var stream = assembly.GetManifestResourceStream(candidate);
+                if (stream != null)
+                {
+                    return Image.FromStream(stream);
+                }
+            }
+
+            return File.Exists(name) ? Image.FromFile(name!) : null;
+        }
+        catch (Exception ex)
+        {
+            // A missing or unreadable toolbox image is not an error worth failing a build or a run over.
+            Diagnostics.GtkLogger.Debug("ToolboxBitmapAttribute could not load an image: " + ex.Message);
+
+            return null;
+        }
+    }
+
+    /// <summary>
+    /// Indicates whether the given object is an equivalent attribute.
+    /// </summary>
+    /// <param name="value">The object to compare with.</param>
+    public override bool Equals(object? value) =>
+        value is ToolboxBitmapAttribute other
+        && other._imageFile == _imageFile
+        && other._imageType == _imageType
+        && other._imageName == _imageName;
+
+    /// <summary>
+    /// Returns a hash code for this attribute.
+    /// </summary>
+    public override int GetHashCode() =>
+        (_imageFile?.GetHashCode() ?? 0) ^ (_imageType?.GetHashCode() ?? 0) ^ (_imageName?.GetHashCode() ?? 0);
+}
