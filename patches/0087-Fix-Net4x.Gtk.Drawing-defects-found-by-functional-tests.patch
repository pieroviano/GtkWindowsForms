         this.transformPoints = pts;
     }
 
@@ -742,7 +753,23 @@ public sealed class Matrix : MarshalByRefObject, IDisposable
     /// </param>
     public void TransformPoints(Point[] pts)
     {
-        this.transformPoints = Array.ConvertAll(pts, p => new PointF(p.X, p.Y));
+        if (pts == null)
+        {
