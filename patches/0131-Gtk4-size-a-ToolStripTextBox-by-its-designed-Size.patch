From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Subject: [PATCH] Gtk4: size a ToolStripTextBox by its designed Size

In the toolstrip the buttons, combo boxes and text box rendered taller than in
the Gtk3 build, and the text box was only a couple of characters wide.

Both came from one item. A ToolStripTextBox is a bare GtkEntry and nothing
passed the item's Size down to it, so it fell back to natural sizing: the char
hints set in the constructor keep its natural width tiny, and Adwaita's entry
metrics (34px minimum height plus padding) made it 42px tall. Being the tallest
item in the strip it inflated the whole toolstrip from its designed 33px to
42px, and the extra width pushed the trailing items past the right edge - which
is why the last button was missing from the strip entirely.

ToolStripComboBox has always applied its Size to its widget; the text box was
simply missing the counterpart. A size request alone is not enough, because a
request is a minimum and cannot pull the entry below the theme's own metrics,
so the entry also carries a class whose rule collapses them. That rule ships
through the existing User-priority provider, the same mechanism the flat
toolstrip buttons already needed to beat the theme.

Measured on the sample: strip 42px -> 34px, text box 18px -> 100px wide, and the
trailing "Test" button visible again.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs b/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs
index 2fc41917..61aad835 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/Application/Application.cs
@@ -533,7 +533,13 @@ public sealed partial class Application
         // gave no feedback about which entry the pointer was on. Menu-bar entries keep the strip's own
         // hover, which is why the rules exclude them.
         + ".MenuItemButton:not(.MenuBarItem):hover{background-color:@theme_selected_bg_color;}\n"
-        + ".MenuItemButton:not(.MenuBarItem):hover>box label{color:@theme_selected_fg_color;}";
+        + ".MenuItemButton:not(.MenuBarItem):hover>box label{color:@theme_selected_fg_color;}\n"
+        // A ToolStripTextBox is a bare GtkEntry, and Adwaita gives an entry a 34px minimum height plus
+        // padding. A size request cannot pull it below that - a request is a minimum - so the entry ended up
+        // 42px tall, taller than the strip it lives in, and being the tallest item it inflated the whole
+        // toolstrip past its designed height and pushed the trailing items off the right edge. Collapsing
+        // the theme's minimum lets the item's designed Size govern, as it does in WinForms.
+        + ".ToolStripEntry,.ToolStripEntry>text{min-height:0;padding-top:0;padding-bottom:0;}";
 
     public static Gtk.Application Init()
     {
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripTextBox.cs b/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripTextBox.cs
index 2ca6230f..23ceb5f6 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripTextBox.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripTextBox.cs
@@ -30,9 +30,37 @@ public class ToolStripTextBox : ToolStripItem
     {
         entry.MaxWidthChars = 1;
         entry.WidthChars = 0;
+        // A size request is only a minimum, so it cannot pull the entry below Adwaita's own entry metrics
+        // (34px min-height plus padding). This class carries the rule that collapses those, loaded at User
+        // priority where the theme cannot win - see Application.UserPriorityCss.
+        entry.StyleContext.AddClass("ToolStripEntry");
         self.AddChild(entry);
     }
 
+    /// <summary>
+    /// Gets or sets the size of this item.
+    /// </summary>
+    /// <value>The item's size, which is applied to the underlying entry.</value>
+    /// <remarks>
+    /// WinForms sizes a strip item by its <see cref="P:System.Windows.Forms.ToolStripItem.Size" />, and
+    /// without passing that on the bare <c>GtkEntry</c> falls back to natural sizing. That had two visible
+    /// effects: the box rendered only a couple of characters wide (the char hints in the constructor keep
+    /// its natural width tiny), and it demanded the full height of Adwaita's entry metrics - 42px against a
+    /// 33px designed strip - which, being the tallest item, inflated the whole toolstrip and pushed the
+    /// items past the right edge. <see cref="ToolStripComboBox" /> has always applied its size this way;
+    /// the text box was simply missing the counterpart.
+    /// </remarks>
+    public override Size Size
+    {
+        get => base.Size;
+        set
+        {
+            entry.WidthRequest = value.Width;
+            entry.HeightRequest = value.Height;
+            base.Size = value;
+        }
+    }
+
     /// <summary>
     /// Gets or sets the maximum length.
     /// </summary>
diff --git a/GtkWinFormsApp.UITests/Forms/MenuAndStripRenderingTests.cs b/GtkWinFormsApp.UITests/Forms/MenuAndStripRenderingTests.cs
index 66d0e7e4..1b22e42a 100644
--- a/GtkWinFormsApp.UITests/Forms/MenuAndStripRenderingTests.cs
+++ b/GtkWinFormsApp.UITests/Forms/MenuAndStripRenderingTests.cs
@@ -121,6 +121,48 @@ public class MenuAndStripRenderingTests
         });
     }
 
+    [Fact]
+    public void ToolStripTextBox_IsSizedByItsDesignedSize_NotTheThemesEntryMetrics()
+    {
+        // Regression: a ToolStripTextBox is a bare GtkEntry and nothing passed the item's Size down to it,
+        // so it fell back to natural sizing - a couple of characters wide - while Adwaita's entry metrics
+        // made it 42px tall. Being the tallest item it inflated the whole strip past its designed height
+        // and pushed the trailing items off the right edge. ToolStripComboBox had always applied its size;
+        // the text box was missing the counterpart.
+        const int width = 120;
+        const int height = 33;
+
+        ToolStripTextBox? box = null;
+        ToolStrip? strip = null;
+
+        UiDriver.Run(
+            () =>
+            {
+                var form = new Form { ClientSize = new Size(500, 200) };
+                strip = new ToolStrip { Dock = DockStyle.Top, AutoSize = false, Size = new Size(500, height) };
+                box = new ToolStripTextBox { Size = new Size(width, height) };
+                strip.Items.Add(box);
+                form.Controls.Add(strip);
+
+                return form;
+            },
+            ctx =>
+            {
+                UiDriver.Pump(40);
+
+                var widget = box!.Widget.ToolItem;
+                Assert.Equal(width, widget.AllocatedWidth);
+
+                widget.Measure(Gtk.Orientation.Vertical, -1, out var min, out _, out _, out _);
+                Assert.True(min <= height,
+                    $"the text box must not demand more than its designed {height}px height, got {min}px");
+
+                strip!.self.Measure(Gtk.Orientation.Vertical, -1, out var stripMin, out _, out _, out _);
+                Assert.True(stripMin <= height + 2,
+                    $"the strip must not be inflated past its designed {height}px height, got {stripMin}px");
+            });
+    }
+
     private static ToolStripMenuItem? FirstMenuItemWithIcon(MenuStrip strip)
     {
         foreach (var item in strip.Items)
