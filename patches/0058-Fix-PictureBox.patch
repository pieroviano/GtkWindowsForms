---
 .../Forms/GtkControls/ControlBase/MonthCalendarBase.cs    | 1 +
 .../System/Windows/Forms/PictureBox.cs                    | 8 ++++++++
 2 files changed, 9 insertions(+)

diff --git a/Net4x.Gtk.Windows.Forms/GtkSystem/Windows/Forms/GtkControls/ControlBase/MonthCalendarBase.cs b/Net4x.Gtk.Windows.Forms/GtkSystem/Windows/Forms/GtkControls/ControlBase/MonthCalendarBase.cs
index 2a6506e..aab2943 100644
--- a/Net4x.Gtk.Windows.Forms/GtkSystem/Windows/Forms/GtkControls/ControlBase/MonthCalendarBase.cs
+++ b/Net4x.Gtk.Windows.Forms/GtkSystem/Windows/Forms/GtkControls/ControlBase/MonthCalendarBase.cs
@@ -1,4 +1,5 @@
 ﻿using System.Windows.Forms;
+#pragma warning disable CS8618 // Non-nullable field must contain a non-null value when exiting constructor. Consider adding the 'required' modifier or declaring as nullable.
 
 namespace GtkSystem.Windows.Forms.GtkControls.ControlBase;
 
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/PictureBox.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/PictureBox.cs
index 8b93c82..302163c 100644
--- a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/PictureBox.cs
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/PictureBox.cs
@@ -157,6 +157,14 @@ public partial class PictureBox : Control
         }
         else
         {
+            if (!(url ?? string.Empty).Contains("://"))
+            {
+                url = Path.GetFullPath(url ?? string.Empty);
+                if (!File.Exists(url))
+                {
+                    return;
+                }
+            }
             var pixbuf = new Gdk.Pixbuf(url?.Replace("\\\\", "/").Replace("\\", "/"));
             _image = new Bitmap(0, 0)
             {
