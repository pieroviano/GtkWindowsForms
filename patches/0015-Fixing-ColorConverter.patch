From d4bac14e0222fd42ceb8026721c3e2546a5bd136 Mon Sep 17 00:00:00 2001
From: pviano-ria <pviano@riasolutionsgroup.ai>
Date: Thu, 26 Mar 2026 06:03:55 +0200
Subject: [PATCH] Fixing ColorConverter

---
 Net4x.Gtk.Drawing/System/Drawing/ColorConverter.cs |  3 +--
 Net4x.Gtk.Drawing/System/Drawing/ColorExtension.cs | 14 ++++++++++++--
 2 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/Net4x.Gtk.Drawing/System/Drawing/ColorConverter.cs b/Net4x.Gtk.Drawing/System/Drawing/ColorConverter.cs
index 4fbd6b12..3df9082f 100644
--- a/Net4x.Gtk.Drawing/System/Drawing/ColorConverter.cs
+++ b/Net4x.Gtk.Drawing/System/Drawing/ColorConverter.cs
@@ -1,5 +1,4 @@
-using System;
-using System.Collections;
+﻿using System.Collections;
 using System.ComponentModel;
 using System.ComponentModel.Design.Serialization;
 using System.Globalization;
diff --git a/Net4x.Gtk.Drawing/System/Drawing/ColorExtension.cs b/Net4x.Gtk.Drawing/System/Drawing/ColorExtension.cs
index ec2cb3b2..8bf8a7fc 100644
--- a/Net4x.Gtk.Drawing/System/Drawing/ColorExtension.cs
+++ b/Net4x.Gtk.Drawing/System/Drawing/ColorExtension.cs
@@ -2,11 +2,21 @@
 
 internal static class ColorExtension
 {
-    public static Color FromKnownColor(KnownColor color) =>
-        FromName(color.ToString());
+    public static Color FromKnownColor(KnownColor color)
+    {
+        // Construct the color directly from KnownColor to avoid recursion
+        return Color.FromName(color.ToString()); ;
+    }
 
     public static Color FromName(string name)
     {
+        // Recursion guard: if name matches a SystemColors property, return it directly
+        var sysColorsType = typeof(SystemColors);
+        var prop = sysColorsType.GetProperty(name);
+        if (prop != null && prop.PropertyType == typeof(Color))
+        {
+            return (Color)prop.GetValue(null);
+        }
         object namedColor = ColorConverter.GetNamedColor(name);
         if (namedColor != null)
         {
