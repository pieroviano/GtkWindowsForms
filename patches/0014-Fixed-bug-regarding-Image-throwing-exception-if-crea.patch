Subject: [PATCH] Fixed bug regarding Image throwing exception if created from
 scratch

---
 Net4x.Gtk.Drawing/System/Drawing/Drawing2D/Image.cs | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/Image.cs b/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/Image.cs
index d6ebf72e..e933e235 100644
--- a/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/Image.cs
+++ b/Net4x.Gtk.Drawing/System/Drawing/Drawing2D/Image.cs
@@ -2,6 +2,7 @@
 using System.Drawing.Imaging;
 using System.Runtime.InteropServices;
 using System.Runtime.Serialization;
+using Gtk;
 
 namespace System.Drawing;
 
@@ -34,6 +35,11 @@ public abstract class Image : Gtk.Widget, IDisposable, ICloneable, ISerializable
 
     private int _width;
 
+    static Image()
+    {
+        Application.Init();
+    }
+
     internal Image(byte[] pixbuf)
     {
         PixbufData = pixbuf;
