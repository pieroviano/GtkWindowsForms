From d1ef5aa6ca842abb7997df7589f1adb46a61d18b Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Date: Sat, 25 Jul 2026 19:22:06 +0300
Subject: [PATCH] Add ToolStripOverflow and ToolStripOverflowButton

Additive now that the ToolStripDropDown re-parent (0119) made ToolStripDropDown a
Control. ToolStripOverflow : ToolStripDropDown is the drop-down holding items a
strip cannot fit (with DisplayedItems/SetDisplayedItems and the parent-item ctor);
ToolStripOverflowButton : ToolStripDropDownButton is the chevron. Both inherit
their surface from the now-Control-derived bases, so the additions are thin.

Covered by ToolStripOverflowFunctionalTests. Full Forms suite green at 2496.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 .../Forms/ToolStripOverflowFunctionalTests.cs | 37 +++++++++++++++++++
 .../Forms/MenuStripBase/ToolStripOverflow.cs  | 29 +++++++++++++++
 .../MenuStripBase/ToolStripOverflowButton.cs  | 17 +++++++++
 3 files changed, 83 insertions(+)
 create mode 100644 Gtk.Windows.Forms.Tests/System/Windows/Forms/ToolStripOverflowFunctionalTests.cs
 create mode 100644 Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripOverflow.cs
 create mode 100644 Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripOverflowButton.cs

diff --git a/Gtk.Windows.Forms.Tests/System/Windows/Forms/ToolStripOverflowFunctionalTests.cs b/Gtk.Windows.Forms.Tests/System/Windows/Forms/ToolStripOverflowFunctionalTests.cs
new file mode 100644
index 00000000..3b81dc35
--- /dev/null
+++ b/Gtk.Windows.Forms.Tests/System/Windows/Forms/ToolStripOverflowFunctionalTests.cs
@@ -0,0 +1,37 @@
+using System.Windows.Forms;
+
+namespace GtkWinForms.Tests.System.Windows.Forms;
+
+/// <summary>
+/// Tests for the overflow chevron surface (§3 of API-COMPLETENESS), which became additive once
+/// <see cref="ToolStripDropDown"/> was re-parented onto <see cref="Control"/>. <see cref="ToolStripOverflow"/>
+/// is the drop-down holding items that do not fit; <see cref="ToolStripOverflowButton"/> is the chevron.
+/// </summary>
+[Collection("NonParallelCollection")]
+public class ToolStripOverflowFunctionalTests
+{
+    static ToolStripOverflowFunctionalTests()
+    {
+        using var _ = new Form();
+    }
+
+    [Fact]
+    public void ToolStripOverflow_IsADropDownControl_WithDisplayedItems()
+    {
+        using var owner = new ToolStripButton("x");
+        using var overflow = new ToolStripOverflow(owner);
+
+        Assert.IsAssignableFrom<ToolStripDropDown>(overflow);
+        Assert.IsAssignableFrom<Control>(overflow);
+        Assert.NotNull(overflow.DisplayedItems);
+        Assert.Same(overflow.Items, overflow.DisplayedItems);
+    }
+
+    [Fact]
+    public void ToolStripOverflowButton_IsADropDownButton()
+    {
+        using var button = new ToolStripOverflowButton();
+
+        Assert.IsAssignableFrom<ToolStripDropDownButton>(button);
+    }
+}
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripOverflow.cs b/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripOverflow.cs
new file mode 100644
index 00000000..b191642a
--- /dev/null
+++ b/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripOverflow.cs
@@ -0,0 +1,29 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+namespace System.Windows.Forms;
+
+/// <summary>
+/// The drop-down that holds the items a <see cref="ToolStrip" /> cannot fit and shows behind the overflow
+/// chevron. It derives from <see cref="ToolStripDropDown" /> (now a <see cref="Control" />), so it carries
+/// the full control surface. Absent before, so a strip that overflows could not expose it by name.
+/// </summary>
+public class ToolStripOverflow : ToolStripDropDown
+{
+    private readonly ToolStripItem? _ownerItem;
+
+    /// <summary>Initializes a new instance owned by the given parent item (the overflow button).</summary>
+    /// <param name="parentItem">The item that owns this overflow drop-down.</param>
+    public ToolStripOverflow(ToolStripItem parentItem) : base()
+    {
+        _ownerItem = parentItem;
+    }
+
+    /// <summary>Gets the items currently shown in the overflow.</summary>
+    public ToolStripItemCollection DisplayedItems => Items;
+
+    /// <summary>Recomputes which items are displayed. The overflow mirrors <see cref="Items" /> on this layer.</summary>
+    protected void SetDisplayedItems()
+    {
+    }
+}
diff --git a/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripOverflowButton.cs b/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripOverflowButton.cs
new file mode 100644
index 00000000..0813a5a3
--- /dev/null
+++ b/Gtk.Windows.Forms/System/Windows/Forms/MenuStripBase/ToolStripOverflowButton.cs
@@ -0,0 +1,17 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+namespace System.Windows.Forms;
+
+/// <summary>
+/// The chevron button a <see cref="ToolStrip" /> shows when it has more items than fit; clicking it opens
+/// the <see cref="ToolStripOverflow" />. Absent before, so the overflow chevron could not be named. Its
+/// surface comes from <see cref="ToolStripDropDownButton" />.
+/// </summary>
+public class ToolStripOverflowButton : ToolStripDropDownButton
+{
+    /// <summary>Initializes a new instance of the <see cref="ToolStripOverflowButton" /> class.</summary>
+    public ToolStripOverflowButton() : base()
+    {
+    }
+}
