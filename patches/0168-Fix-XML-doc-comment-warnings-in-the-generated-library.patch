+    /// </summary>
+    /// <param name="dialog">The dialog to present modally and wait on.</param>
+    /// <returns>The <see cref="Gtk.ResponseType"/> id (as int) the dialog closed with.</returns>
     public static int RunDialog(this Gtk.Dialog dialog)
     {
         if (!IsAlive(dialog))
