+// See the LICENSE file in the project root for more information.
+
+namespace System.Windows.Forms;
+
+/// <summary>Defines a filter interface to intercept Windows messages before they are dispatched to a control or form.</summary>
+public interface IMessageFilter
+{
+    /// <summary>Filters out a message before it is dispatched.</summary>
+    /// <param name="m">The message to be dispatched, passed by reference.</param>
+    /// <returns><see langword="true" /> to filter the message and stop it from being dispatched; otherwise <see langword="false" />.</returns>
+    bool PreFilterMessage(ref Message m);
+}
