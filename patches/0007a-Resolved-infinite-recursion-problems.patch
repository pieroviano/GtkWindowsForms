Date: Tue, 24 Mar 2026 01:15:29 +0200
Subject: [PATCH] Resolved infinite recursion problems

---
 .../System/Drawing/ColorExtension.cs          |  15 +-
 Net4x.Gtk.Drawing/System/Drawing/Font.cs      |  21 +-
 .../System/Drawing/FontFamily.cs              |  17 +-
 Net4x.Gtk.Drawing/System/Drawing/Graphics.cs  |   4 +-
 .../System/Windows/Forms/ComboBox.cs          |   4 +-
 .../System/Windows/Forms/Enum/Message.cs      |   4 +-
 .../System/Windows/Forms/ListBox.cs           |   2 +-
 .../Windows/Forms/TreeViewBase/TreeNode.cs    |  14 +-
 9 files changed, 420 insertions(+), 24 deletions(-)

diff --git a/Net4x.Gtk.Drawing/System/Drawing/ColorExtension.cs b/Net4x.Gtk.Drawing/System/Drawing/ColorExtension.cs
index 28d24829..ec2cb3b2 100644
--- a/Net4x.Gtk.Drawing/System/Drawing/ColorExtension.cs
+++ b/Net4x.Gtk.Drawing/System/Drawing/ColorExtension.cs
@@ -1,4 +1,4 @@
-namespace System.Drawing;
+﻿namespace System.Drawing;
 
 internal static class ColorExtension
 {
@@ -7,11 +7,12 @@ internal static class ColorExtension
 
     public static Color FromName(string name)
     {
-        // try to get a known color first
-        if (ColorTable.TryGetNamedColor(name, out var color))
-            return color;
-
-        // otherwise treat it as a named color
-        return FromName(name);
+        object namedColor = ColorConverter.GetNamedColor(name);
+        if (namedColor != null)
+        {
+            return (Color)namedColor;
+        }
+        return Color.Transparent;
     }
+
 }
\ No newline at end of file
diff --git a/Net4x.Gtk.Drawing/System/Drawing/Font.cs b/Net4x.Gtk.Drawing/System/Drawing/Font.cs
index 7b93aee0..abbb366c 100644
--- a/Net4x.Gtk.Drawing/System/Drawing/Font.cs
+++ b/Net4x.Gtk.Drawing/System/Drawing/Font.cs
@@ -1,4 +1,4 @@
-using System.ComponentModel;
+﻿using System.ComponentModel;
 using System.Runtime.Serialization;
 
 namespace System.Drawing;
@@ -443,8 +443,23 @@ public sealed class Font : MarshalByRefObject, ICloneable, IDisposable, ISeriali
     /// <returns>
     /// true if the obj parameter is a System.Drawing.Font and has the same System.Drawing.Font.FontFamily, System.Drawing.Font.GdiVerticalFont, System.Drawing.Font.GdiCharSet, System.Drawing.Font.Style, System.Drawing.Font.Size, and System.Drawing.Font.Unit property values as this System.Drawing.Font; otherwise, false.
     /// </returns>
-    public override bool Equals(object obj) { return Equals(obj as Font); }
-
+    public override bool Equals(object obj)
+    {
+        if (obj == this)
+        {
+            return true;
+        }
+        Font font = obj as Font;
+        if (font == null)
+        {
+            return false;
+        }
+        if (!font.FontFamily.Equals(this.FontFamily) || font.GdiVerticalFont != this.GdiVerticalFont || font.GdiCharSet != this.GdiCharSet || font.Style != this.Style || font.Size != this.Size)
+        {
+            return false;
+        }
+        return font.Unit == this.Unit;
+    }
     /// <summary>
     /// Creates a System.Drawing.Font from the specified Windows handle to a device context.
     /// </summary>
diff --git a/Net4x.Gtk.Drawing/System/Drawing/FontFamily.cs b/Net4x.Gtk.Drawing/System/Drawing/FontFamily.cs
index 9ebfe8ac..d7d5dbd0 100644
--- a/Net4x.Gtk.Drawing/System/Drawing/FontFamily.cs
+++ b/Net4x.Gtk.Drawing/System/Drawing/FontFamily.cs
@@ -1,4 +1,4 @@
-using System.Drawing.Text;
+﻿using System.Drawing.Text;
 using Gdk;
 
 namespace System.Drawing;
@@ -105,8 +105,19 @@ public sealed class FontFamily : MarshalByRefObject, IDisposable
     /// <returns>
     /// true if obj is a System.Drawing.FontFamily and is identical to this System.Drawing.FontFamily; otherwise, false.
     /// </returns>
-    public override bool Equals(object obj) { return Equals(obj as FontFamily); }
-
+    public override bool Equals(object obj)
+    {
+        if (obj == this)
+        {
+            return true;
+        }
+        FontFamily fontFamily = obj as FontFamily;
+        if (fontFamily == null)
+        {
+            return false;
+        }
+        return fontFamily.Name == this.Name;
+    }
     /// <summary>
     /// Returns the cell ascent, in design units, of the System.Drawing.FontFamily of
     /// the specified style.
