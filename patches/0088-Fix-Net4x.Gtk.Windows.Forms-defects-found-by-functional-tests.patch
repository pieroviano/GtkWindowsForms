+using System.ComponentModel;
+using System.Drawing;
+
+namespace System.Windows.Forms;
+
+/// <summary>
+/// Represents a splitter control that lets the user resize docked controls.
+/// </summary>
+/// <remarks>
+/// The legacy splitter, distinct from the <see cref="T:System.Windows.Forms.SplitContainer" /> that
+/// replaced it, was missing. An application old enough to be worth porting will very likely dock one of
+/// these against a panel, so its absence was a compile break.
+/// <para>
+/// It is a docked <see cref="T:System.Windows.Forms.Control" /> carrying the legacy surface — the
+/// <see cref="P:System.Windows.Forms.Splitter.MinSize" />/<see cref="P:System.Windows.Forms.Splitter.MinExtra" />
+/// limits, <see cref="P:System.Windows.Forms.Splitter.SplitPosition" /> and the
+/// <see cref="E:System.Windows.Forms.Splitter.SplitterMoving" />/<see cref="E:System.Windows.Forms.Splitter.SplitterMoved" />
+/// events — and resizes the control it is docked against when the position changes. Interactive dragging is
+/// not wired to GTK input; setting <see cref="P:System.Windows.Forms.Splitter.SplitPosition" /> from code
+/// performs the resize.
+/// </para>
+/// </remarks>
+public class Splitter : Control
+{
+    /// <summary>The width or height a splitter occupies by default.</summary>
+    private const int DefaultThickness = 3;
+
+    /// <summary>
+    /// Occurs while the splitter is being moved.
+    /// </summary>
+    public event SplitterEventHandler? SplitterMoving;
+
+    /// <summary>
+    /// Occurs after the splitter has been moved.
+    /// </summary>
+    public event SplitterEventHandler? SplitterMoved;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="T:System.Windows.Forms.Splitter" /> class.
+    /// </summary>
+    public Splitter()
+    {
+        Dock = DockStyle.Left;
+        Width = DefaultThickness;
+    }
+
+    /// <summary>
+    /// Gets or sets the minimum size, in pixels, of the control being resized.
+    /// </summary>
+    [DefaultValue(25)]
+    public int MinSize
+    {
+        get;
+        set;
+    } = 25;
+
+    /// <summary>
+    /// Gets or sets the minimum size, in pixels, left for the remaining area.
+    /// </summary>
+    [DefaultValue(25)]
+    public int MinExtra
+    {
+        get;
+        set;
+    } = 25;
+
+    /// <summary>
+    /// Gets or sets the position of the splitter, in pixels.
+    /// </summary>
+    /// <remarks>
+    /// Assigning this resizes the control the splitter is docked against, clamped by
+    /// <see cref="P:System.Windows.Forms.Splitter.MinSize" /> and
+    /// <see cref="P:System.Windows.Forms.Splitter.MinExtra" />.
+    /// </remarks>
+    [DefaultValue(-1)]
+    public int SplitPosition
+    {
+        get
+        {
+            var target = FindTarget();
+            if (target == null)
+            {
+                return -1;
+            }
+
+            return IsVertical ? target.Width : target.Height;
+        }
+        set
+        {
+            var target = FindTarget();
+            if (target == null)
+            {
+                return;
+            }
+
+            var limit = Parent == null
+                ? int.MaxValue
+                : (IsVertical ? Parent.Width : Parent.Height) - MinExtra - Width;
+            var position = Math.Max(MinSize, Math.Min(value, Math.Max(MinSize, limit)));
+
+            var args = new SplitterEventArgs(Left, Top, position, position);
+            OnSplitterMoving(args);
+
+            if (IsVertical)
+            {
+                target.Width = position;
+            }
+            else
+            {
+                target.Height = position;
+            }
+
+            OnSplitterMoved(args);
+        }
+    }
+
+    /// <summary>
+    /// Gets or sets which edge of its container the splitter is docked to.
+    /// </summary>
+    /// <remarks>
+    /// A splitter cannot fill its container; assigning <see cref="F:System.Windows.Forms.DockStyle.Fill" />
+    /// or <see cref="F:System.Windows.Forms.DockStyle.None" /> is rejected, as WinForms does.
+    /// </remarks>
+    [DefaultValue(DockStyle.Left)]
+    public override DockStyle Dock
+    {
+        get => base.Dock;
+        set
+        {
+            if (value is DockStyle.Fill or DockStyle.None)
+            {
+                throw new ArgumentException("A Splitter must be docked to an edge.", nameof(value));
+            }
+
+            base.Dock = value;
+        }
+    }
+
+    /// <summary>
+    /// Gets a value indicating whether the splitter runs vertically, resizing width rather than height.
+    /// </summary>
+    [Browsable(false)]
+    public bool IsVertical => Dock is DockStyle.Left or DockStyle.Right;
+
+    /// <summary>
+    /// Gets or sets the border style of the splitter.
+    /// </summary>
+    [DefaultValue(BorderStyle.None)]
+    public new BorderStyle BorderStyle
+    {
+        get => base.BorderStyle;
+        set => base.BorderStyle = value;
+    }
+
+    /// <summary>
+    /// Raises the <see cref="E:System.Windows.Forms.Splitter.SplitterMoving" /> event.
+    /// </summary>
+    /// <param name="e">The event data.</param>
+    protected virtual void OnSplitterMoving(SplitterEventArgs e) => SplitterMoving?.Invoke(this, e);
+
+    /// <summary>
+    /// Raises the <see cref="E:System.Windows.Forms.Splitter.SplitterMoved" /> event.
+    /// </summary>
+    /// <param name="e">The event data.</param>
+    protected virtual void OnSplitterMoved(SplitterEventArgs e) => SplitterMoved?.Invoke(this, e);
+
+    /// <summary>
+    /// The sibling the splitter resizes: the control docked to the same edge just before it.
+    /// </summary>
+    private Control? FindTarget()
+    {
+        var siblings = Parent?.Controls;
+        if (siblings == null)
+        {
+            return null;
+        }
+
+        Control? candidate = null;
+        for (var i = 0; i < siblings.Count; i++)
+        {
+            var sibling = siblings[i];
+            if (ReferenceEquals(sibling, this))
+            {
+                continue;
+            }
+
+            if (sibling.Dock == Dock)
+            {
+                candidate = sibling;
+            }
+        }
+
+        return candidate;
+    }
+}
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/StatusBar.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/StatusBar.cs
new file mode 100644
index 00000000..101b00de
--- /dev/null
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/StatusBar.cs
@@ -0,0 +1,273 @@
+using System.Collections;
+using System.ComponentModel;
+
+namespace System.Windows.Forms;
+
+/// <summary>
+/// Represents a status bar control.
+/// </summary>
+/// <remarks>
+/// The legacy status API was missing entirely. <see cref="T:System.Windows.Forms.StatusBar" /> derives from
+/// <see cref="T:System.Windows.Forms.StatusStrip" /> so that it is a real control which docks and renders,
+/// while exposing the <c>Panels</c> collection the old API uses.
+/// </remarks>
+public class StatusBar : StatusStrip
+{
+    private StatusBarPanelCollection? _panels;
+
+    /// <summary>
+    /// Occurs when a panel is clicked.
+    /// </summary>
+    public event StatusBarPanelClickEventHandler? PanelClick;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="T:System.Windows.Forms.StatusBar" /> class.
+    /// </summary>
+    public StatusBar()
+    {
+    }
+
+    /// <summary>
+    /// Gets the panels displayed on the status bar.
+    /// </summary>
+    public StatusBarPanelCollection Panels => _panels ??= new StatusBarPanelCollection(this);
+
+    /// <summary>
+    /// Gets or sets a value indicating whether panels are shown instead of a single caption.
+    /// </summary>
+    [DefaultValue(false)]
+    public bool ShowPanels
+    {
+        get;
+        set;
+    }
+
+    /// <summary>
+    /// Gets or sets a value indicating whether a sizing grip is shown.
+    /// </summary>
+    [DefaultValue(true)]
+    public new bool SizingGrip
+    {
+        get;
+        set;
+    } = true;
+
+    /// <summary>
+    /// Raises the <see cref="E:System.Windows.Forms.StatusBar.PanelClick" /> event.
+    /// </summary>
+    /// <param name="e">The event data.</param>
+    protected virtual void OnPanelClick(StatusBarPanelClickEventArgs e) => PanelClick?.Invoke(this, e);
+
+    /// <summary>
+    /// Represents the collection of panels on a <see cref="T:System.Windows.Forms.StatusBar" />.
+    /// </summary>
+    public class StatusBarPanelCollection : IList
+    {
+        private readonly List<StatusBarPanel> items = new();
+
+        private readonly StatusBar owner;
+
+        /// <summary>
+        /// Initializes a new instance of the
+        /// <see cref="T:System.Windows.Forms.StatusBar.StatusBarPanelCollection" /> class.
+        /// </summary>
+        /// <param name="owner">The status bar that owns the collection.</param>
+        public StatusBarPanelCollection(StatusBar owner)
+        {
+            this.owner = owner ?? throw new ArgumentNullException(nameof(owner));
+        }
+
+        /// <summary>Gets the number of panels.</summary>
+        public int Count => items.Count;
+
+        /// <summary>Gets a value indicating whether the collection is read-only.</summary>
+        public bool IsReadOnly => false;
+
+        /// <summary>Gets a value indicating whether the collection has a fixed size.</summary>
+        public bool IsFixedSize => false;
+
+        /// <summary>Gets a value indicating whether access to the collection is synchronised.</summary>
+        public bool IsSynchronized => false;
+
+        /// <summary>Gets an object that can be used to synchronise access to the collection.</summary>
+        public object SyncRoot => ((ICollection)items).SyncRoot;
+
+        /// <summary>Gets or sets the panel at the specified position.</summary>
+        /// <param name="index">The zero-based position of the panel.</param>
+        public virtual StatusBarPanel this[int index]
+        {
+            get => items[index];
+            set
+            {
+                RemoveAt(index);
+                Insert(index, value);
+            }
+        }
+
+        /// <summary>Gets the panel with the specified name, or <see langword="null" />.</summary>
+        /// <param name="key">The name to look for.</param>
+        public virtual StatusBarPanel? this[string key]
+        {
+            get
+            {
+                var index = IndexOfKey(key);
+
+                return index == -1 ? null : items[index];
+            }
+        }
+
+        object? IList.this[int index]
+        {
+            get => items[index];
+            set => this[index] = value as StatusBarPanel
+                                 ?? throw new ArgumentException("Value must be a StatusBarPanel.", nameof(value));
+        }
+
+        /// <summary>Adds a panel displaying the given text.</summary>
+        /// <param name="text">The text of the new panel.</param>
+        /// <returns>The panel that was added.</returns>
+        public virtual StatusBarPanel Add(string text) => Add(new StatusBarPanel { Text = text });
+
+        /// <summary>Adds the specified panel.</summary>
+        /// <param name="value">The panel to add.</param>
+        /// <returns>The panel that was added.</returns>
+        public virtual StatusBarPanel Add(StatusBarPanel value)
+        {
+            if (value == null)
+            {
+                throw new ArgumentNullException(nameof(value));
+            }
+
+            items.Add(value);
+            value.Parent = owner;
+            owner.Items.Add(value.Label);
+
+            return value;
+        }
+
+        int IList.Add(object? value)
+        {
+            Add(value as StatusBarPanel ?? throw new ArgumentException("Value must be a StatusBarPanel.", nameof(value)));
+
+            return items.Count - 1;
+        }
+
+        /// <summary>Adds every one of the given panels.</summary>
+        /// <param name="panels">The panels to add.</param>
+        public virtual void AddRange(StatusBarPanel[] panels)
+        {
+            if (panels == null)
+            {
+                throw new ArgumentNullException(nameof(panels));
+            }
+
+            foreach (var panel in panels)
+            {
+                Add(panel);
+            }
+        }
+
+        /// <summary>Removes every panel.</summary>
+        public virtual void Clear()
+        {
+            foreach (var panel in items)
+            {
+                panel.Parent = null;
+                owner.Items.Remove(panel.Label);
+            }
+
+            items.Clear();
+        }
+
+        /// <summary>Indicates whether the specified panel is in the collection.</summary>
+        /// <param name="panel">The panel to look for.</param>
+        public bool Contains(StatusBarPanel panel) => items.Contains(panel);
+
+        bool IList.Contains(object? value) => value is StatusBarPanel panel && items.Contains(panel);
+
+        /// <summary>Indicates whether a panel with the specified name is present.</summary>
+        /// <param name="key">The name to look for.</param>
+        public virtual bool ContainsKey(string? key) => IndexOfKey(key) != -1;
+
+        /// <summary>Copies the panels into the given array.</summary>
+        /// <param name="dest">The array to copy into.</param>
+        /// <param name="index">The position in the array to start at.</param>
+        public void CopyTo(Array dest, int index) => ((ICollection)items).CopyTo(dest, index);
+
+        /// <summary>Returns an enumerator over the panels.</summary>
+        public IEnumerator GetEnumerator() => items.GetEnumerator();
+
+        /// <summary>Returns the position of the specified panel, or -1.</summary>
+        /// <param name="panel">The panel to locate.</param>
+        public int IndexOf(StatusBarPanel panel) => items.IndexOf(panel);
+
+        int IList.IndexOf(object? value) => value is StatusBarPanel panel ? items.IndexOf(panel) : -1;
+
+        /// <summary>Returns the position of the panel with the specified name, or -1.</summary>
+        /// <param name="key">The name to look for.</param>
+        public virtual int IndexOfKey(string? key)
+        {
+            if (string.IsNullOrEmpty(key))
+            {
+                return -1;
+            }
+
+            return items.FindIndex(panel => string.Equals(panel.Name, key, StringComparison.OrdinalIgnoreCase));
+        }
+
+        /// <summary>Inserts a panel at the given position.</summary>
+        /// <param name="index">The position to insert at.</param>
+        /// <param name="value">The panel to insert.</param>
+        public virtual void Insert(int index, StatusBarPanel value)
+        {
+            if (value == null)
+            {
+                throw new ArgumentNullException(nameof(value));
+            }
+
+            items.Insert(index, value);
+            value.Parent = owner;
+            owner.Items.Insert(index, value.Label);
+        }
+
+        void IList.Insert(int index, object? value) =>
+            Insert(index, value as StatusBarPanel
+                          ?? throw new ArgumentException("Value must be a StatusBarPanel.", nameof(value)));
+
+        /// <summary>Removes the specified panel.</summary>
+        /// <param name="value">The panel to remove.</param>
+        public virtual void Remove(StatusBarPanel value)
+        {
+            if (value == null || !items.Remove(value))
+            {
+                return;
+            }
+
+            value.Parent = null;
+            owner.Items.Remove(value.Label);
+        }
+
+        void IList.Remove(object? value)
+        {
+            if (value is StatusBarPanel panel)
+            {
+                Remove(panel);
+            }
+        }
+
+        /// <summary>Removes the panel at the given position.</summary>
+        /// <param name="index">The position of the panel to remove.</param>
+        public virtual void RemoveAt(int index) => Remove(items[index]);
+
+        /// <summary>Removes the panel with the specified name, if there is one.</summary>
+        /// <param name="key">The name of the panel to remove.</param>
+        public virtual void RemoveByKey(string? key)
+        {
+            var index = IndexOfKey(key);
+            if (index != -1)
+            {
+                RemoveAt(index);
+            }
+        }
+    }
+}
diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/StatusBarPanel.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/StatusBarPanel.cs
new file mode 100644
index 00000000..d0f7effd
--- /dev/null
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/StatusBarPanel.cs
@@ -0,0 +1,162 @@
+using System.ComponentModel;
+using System.Drawing;
+
+namespace System.Windows.Forms;
+
+/// <summary>
+/// Represents a panel in a <see cref="T:System.Windows.Forms.StatusBar" />.
+/// </summary>
+/// <remarks>
+/// An adapter over <see cref="T:System.Windows.Forms.ToolStripStatusLabel" />, which is what actually
+/// renders inside the strip.
+/// </remarks>
+public class StatusBarPanel : Component
+{
+    /// <summary>
+    /// Initializes a new instance of the <see cref="T:System.Windows.Forms.StatusBarPanel" /> class.
+    /// </summary>
+    public StatusBarPanel()
+    {
+        Label = new ToolStripStatusLabel();
+    }
+
+    /// <summary>
+    /// The modern label this legacy panel drives.
+    /// </summary>
+    internal ToolStripStatusLabel Label { get; }
+
+    /// <summary>
+    /// Gets or sets the text of the panel.
+    /// </summary>
+    public string Text
+    {
+        get => Label.Text ?? string.Empty;
+        set => Label.Text = value;
+    }
+
+    /// <summary>
+    /// Gets or sets the name of the panel.
+    /// </summary>
+    public string Name
+    {
+        get => Label.Name ?? string.Empty;
+        set => Label.Name = value;
+    }
+
+    /// <summary>
+    /// Gets or sets the tooltip shown for the panel.
+    /// </summary>
+    public string ToolTipText
+    {
+        get => Label.ToolTipText ?? string.Empty;
+        set => Label.ToolTipText = value;
+    }
+
+    /// <summary>
+    /// Gets or sets the width of the panel.
+    /// </summary>
+    [DefaultValue(100)]
+    public int Width
+    {
+        get => Label.Width;
+        set => Label.Width = value;
+    }
+
+    /// <summary>
+    /// Gets or sets the minimum width of the panel.
+    /// </summary>
+    [DefaultValue(10)]
+    public int MinWidth
+    {
+        get;
+        set;
+    } = 10;
+
+    /// <summary>
+    /// Gets or sets how the text is aligned within the panel.
+    /// </summary>
+    [DefaultValue(HorizontalAlignment.Left)]
+    public HorizontalAlignment Alignment
+    {
+        get;
+        set;
+    } = HorizontalAlignment.Left;
+
+    /// <summary>
+    /// Gets or sets the border style of the panel.
+    /// </summary>
+    [DefaultValue(StatusBarPanelBorderStyle.Sunken)]
+    public StatusBarPanelBorderStyle BorderStyle
+    {
+        get;
+        set;
+    } = StatusBarPanelBorderStyle.Sunken;
+
+    /// <summary>
+    /// Gets or sets how the panel is sized within the status bar.
+    /// </summary>
+    [DefaultValue(StatusBarPanelAutoSize.None)]
+    public StatusBarPanelAutoSize AutoSize
+    {
+        get;
+        set;
+    } = StatusBarPanelAutoSize.None;
+
+    /// <summary>
+    /// Gets or sets the style of the panel.
+    /// </summary>
+    [DefaultValue(StatusBarPanelStyle.Text)]
+    public StatusBarPanelStyle Style
+    {
+        get;
+        set;
+    } = StatusBarPanelStyle.Text;
+
+    /// <summary>
+    /// Gets or sets the icon displayed in the panel.
+    /// </summary>
+    public Icon? Icon
+    {
+        get;
+        set;
+    }
+
+    /// <summary>
+    /// Gets or sets user-defined data associated with the panel.
+    /// </summary>
+    [DefaultValue(null)]
+    public object? Tag
+    {
+        get;
+        set;
+    }
+
+    /// <summary>
+    /// Gets the status bar that contains this panel.
+    /// </summary>
+    [Browsable(false)]
+    public StatusBar? Parent
+    {
+        get;
+        internal set;
+    }
+
+    /// <summary>
+    /// Begins initialisation of the panel.
+    /// </summary>
+    public void BeginInit()
+    {
+    }
+
+    /// <summary>
+    /// Ends initialisation of the panel.
+    /// </summary>
+    public void EndInit()
+    {
+    }
+
+    /// <summary>
+    /// Returns a string that represents this panel.
+    /// </summary>
+    public override string ToString() => $"{GetType().Name}: {{{Text}}}";
+}
