         internal virtual void SetChildIndexInternal(Control child, int newIndex)
         {
+            // This was empty, so SetChildIndex never reordered anything.
+            if (child is null)
+            {
+                return;
+            }
+
+            var current = InnerList.IndexOf(child);
+            if (current < 0)
+            {
