From: pviano-ria <pviano@riasolutionsgroup.ai>
Date: Mon, 23 Mar 2026 07:55:55 +0200
Subject: [PATCH] Fix trackbar

---
 Gtk.Windows.Forms/System/Windows/Forms/TrackBar.cs | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Gtk.Windows.Forms/System/Windows/Forms/TrackBar.cs b/Gtk.Windows.Forms/System/Windows/Forms/TrackBar.cs
index 3eb7d275..9f53a647 100644
--- a/Gtk.Windows.Forms/System/Windows/Forms/TrackBar.cs
+++ b/Gtk.Windows.Forms/System/Windows/Forms/TrackBar.cs
@@ -1,4 +1,4 @@
-/*
+﻿/*
  * Based on GTK components, it is a cross-platform interface component that is compatible with the native C# control winform interface.
  * Use this component GtkSystem.Windows.Forms instead of Microsoft.WindowsDesktop.App.WindowsForms, compile once, and run across Windows, Linux, and macOS
  * Technical support 438865652@qq.com，https://www.gtkapp.com, https://gitee.com/easywebfactory, https://github.com/easywebfactory438865652@qq.com，https://www.gtkapp.com, https://gitee.com/easywebfactory, https://github.com/easywebfactory
@@ -135,7 +135,7 @@ public class TrackBar : Control
     /// </summary>
     protected virtual void OnScroll(System.EventArgs e)
     {
-        Scroll?.Invoke(this, e);
+        Scroll?.Invoke(this, e);              
     }
 
     private void Control_Realized(object sender, EventArgs e)
@@ -158,6 +158,6 @@ public class TrackBar : Control
     private void Control_ValueChanged(object sender, EventArgs e)
     {
         Value = (int)adjustment.Value;
-        Scroll?.Invoke(this, e);
+        OnScroll(EventArgs.Empty);
     }
 }
\ No newline at end of file
