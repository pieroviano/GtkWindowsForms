From 6d001422586099170aba2a05a5800843b16a0e8a Mon Sep 17 00:00:00 2001
From: pieroviano <piero.viano@gmail.com>
Date: Fri, 3 Apr 2026 04:14:17 +0300
Subject: [PATCH] Fix SecurityUtils

---
 .../Windows/Forms/Collection/SecurityUtils.cs | 22 ++++++++++++++-----
 1 file changed, 16 insertions(+), 6 deletions(-)

diff --git a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Collection/SecurityUtils.cs b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Collection/SecurityUtils.cs
index 2da8a29..8fc1bd3 100644
--- a/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Collection/SecurityUtils.cs
+++ b/Net4x.Gtk.Windows.Forms/System/Windows/Forms/Collection/SecurityUtils.cs
@@ -1,4 +1,4 @@
-using System.Reflection;
+﻿using System.Reflection;
 using System.Security;
 
 namespace System.Windows.Forms;
@@ -8,7 +8,16 @@ internal static class SecurityUtils
 
     internal static object? SecureCreateInstance(Type? type)
     {
-        return SecureCreateInstance(type, null, false);
+        if (type == null)
+        {
+            throw new ArgumentNullException(nameof(type));
+        }
+
+        // When caller used the simple overload, allow creating instances of non-visible types
+        // by trying non-public constructors. If the caller explicitly passes allowNonPublic=false
+        // (via the other overload) we honor that decision.
+        var allowNonPublicForDefault = !type.IsVisible;
+        return SecureCreateInstance(type, null, allowNonPublicForDefault);
     }
 
     internal static object? SecureCreateInstance(Type? type, object[]? args, bool allowNonPublic)
@@ -17,14 +26,15 @@ internal static class SecurityUtils
         {
             throw new ArgumentNullException(nameof(type));
         }
+
         var bindingFlag = BindingFlags.Instance | BindingFlags.Public | BindingFlags.CreateInstance;
-        if (!type.IsVisible)
-        {
-        }
-        else if (allowNonPublic && !HasReflectionPermission(type))
+
+        // If caller requested non-public creation but reflection permission is absent, respect that.
+        if (allowNonPublic && !HasReflectionPermission(type))
         {
             allowNonPublic = false;
         }
+
         if (allowNonPublic)
         {
             bindingFlag |= BindingFlags.NonPublic;
-- 
2.51.1.windows.1

