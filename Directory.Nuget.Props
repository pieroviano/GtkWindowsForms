<Project>
    <PropertyGroup>
        <NuGetPackageRoot Condition="'$(NuGetPackageRoot)'=='' and '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">$(USERPROFILE)\.nuget\packages\</NuGetPackageRoot>
        <NuGetPackageRoot Condition="'$(NuGetPackageRoot)'=='' and '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' != 'true'">~/.nuget/packages/</NuGetPackageRoot>
        <VersionBuildSuffix Condition="'$(Configuration)'!='Release'">*</VersionBuildSuffix>
        <VersionBuildSuffix Condition="'$(Configuration)'=='Release'">*</VersionBuildSuffix>
        <NuGetUtilityVersion Condition="'$(NuGetUtilityVersion)' == ''">1.0.13</NuGetUtilityVersion>
        <DirectoryNuGet>true</DirectoryNuGet>
        <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">$(USERPROFILE)\.nuget\packages\</NuGetPackageRoot>
        <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' != 'true'">~/.nuget/packages/</NuGetPackageRoot>
        <VersionBuildSuffix Condition="'$(Configuration)' != 'Release'">*</VersionBuildSuffix>
        <VersionBuildSuffix Condition="'$(Configuration)' == 'Release'">*</VersionBuildSuffix>
        <GtkSharpLatestVersion>3.24.24</GtkSharpLatestVersion>
        <GtkWindowsFormsVersion>1.3.2464</GtkWindowsFormsVersion>
        <Net4xBaseTypesVersion>1.3.1</Net4xBaseTypesVersion>
        <NuGetUtilityVersion>1.0.9</NuGetUtilityVersion>
        <ObfuscarVersion>2.2.37</ObfuscarVersion>
        <SystemTextJson10Version>10.0.3</SystemTextJson10Version>
    </PropertyGroup>
</Project>