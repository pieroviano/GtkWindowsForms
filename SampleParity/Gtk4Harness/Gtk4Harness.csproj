<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SampleParity</RootNamespace>
    <AssemblyName>SampleParity.Gtk4Harness</AssemblyName>
    <IsPackable>false</IsPackable>
    <UseWindowsForms>False</UseWindowsForms>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS8002;CS0436;CS0612;CS0618;NU1603</NoWarn>
  </PropertyGroup>

  <!-- Same shared source as the Gtk3 harness. It cannot be a shared assembly: this side binds this repo's
       Gtk4 System.Windows.Forms and the other binds upstream's Gtk3 one. -->
  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\GtkWinFormsApp\GtkWinFormsApp.csproj" />
    <ProjectReference Include="..\..\Gtk.Windows.Extensions\Gtk.Windows.Extensions.csproj" />
  </ItemGroup>

</Project>
