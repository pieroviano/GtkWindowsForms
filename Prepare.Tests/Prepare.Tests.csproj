<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows so the tests can reference PrepareProjects (the transform f/fs under test). -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Resources\*.cs" />
    <Compile Remove="Roslyn\*.cs" />
    <Compile Remove="UnusedUsings\*.cs" />
    <Compile Remove="XmlDocDuplicateClean\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\*.cs" />
    <Content Include="Roslyn\*.cs" />
    <Content Include="UnusedUsings\*.cs" />
    <Content Include="XmlDocDuplicateClean\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Align.Common\Align.Common.csproj" />
    <ProjectReference Include="..\PrepareProjects\PrepareProjects.csproj" />
    <ProjectReference Include="..\Prepare.Common\Prepare.Common.csproj" />
    <ProjectReference Include="..\UpdatePostProcessing\UpdatePostProcessing.csproj" />
    <ProjectReference Include="..\XmlDocSync\XmlDocSync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
