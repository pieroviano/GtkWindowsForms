<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Resources\Binding.cs" />
    <Compile Remove="Roslyn\Bitmap.cs" />
    <Compile Remove="Roslyn\ColumnWidthChangingEventHandler.cs" />
    <Compile Remove="Roslyn\GraphicsPath.cs" />
    <Compile Remove="Roslyn\RichTextBoxBase.cs" />
    <Compile Remove="Roslyn\TableLayoutPanel.cs" />
    <Compile Remove="Roslyn\ToolboxItem.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Binding.cs" />
    <Content Include="Roslyn\Bitmap.cs" />
    <Content Include="Roslyn\ColumnWidthChangingEventHandler.cs" />
    <Content Include="Roslyn\GraphicsPath.cs" />
    <Content Include="Roslyn\RichTextBoxBase.cs" />
    <Content Include="Roslyn\TableLayoutPanel.cs" />
    <Content Include="Roslyn\ToolboxItem.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prepare.Common\Prepare.Common.csproj" />
    <ProjectReference Include="..\UpdatePostProcessing\UpdatePostProcessing.csproj" />
    <ProjectReference Include="..\XmlDocSync\XmlDocSync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
