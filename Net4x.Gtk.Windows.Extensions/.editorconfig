[*.cs]

# Indentation
indent_style = space     # or: tab
indent_size = 4          # ignored if tab
tab_width = 4
csharp_new_line_between_members = true

# Enforce a blank line between different types of members
dotnet_diagnostic.IDE0055.severity = warning

# Spacing rules
csharp_style_allow_blank_lines_between_consecutive_methods = true
csharp_style_allow_blank_line_after_colon_in_constructor_initializer_experimental = true

# General whitespace 
# (While .editorconfig is limited for complex logic, 
# these ensure basic spacing is respected)
insert_final_newline = true