<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<NoWarn>CA1416;IDE0055</NoWarn>
		<SkipPush>true</SkipPush>
	</PropertyGroup>

	<ItemGroup>
	  <Content Include="Resources\ControlExtension.cs" Condition="Exists('Resources\ControlExtension.cs')" />
	  <Content Include="Resources\DeserializingResourceReader.cs" Condition="Exists('Resources\DeserializingResourceReader.cs')" />
	  <Content Include="Resources\TreeView.cs" Condition="Exists('Resources\TreeView.cs')" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Prepare.Common\Prepare.Common.csproj" />
	  <ProjectReference Include="..\XmlDocSync\XmlDocSync.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Properties\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Net4x.PublishNuget" Version="1.0.0.2" />
	</ItemGroup>

</Project>
