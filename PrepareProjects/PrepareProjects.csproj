<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Resources\**" />
	  <EmbeddedResource Remove="Resources\**" />
	  <None Remove="Resources\**" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Resources\ControlExtension.cs" Condition="Exists('Resources\ControlExtension.cs')" />
	  <Content Include="Resources\DeserializingResourceReader.cs" Condition="Exists('Resources\DeserializingResourceReader.cs')" />
	  <Content Include="Resources\TreeView.cs" Condition="Exists('Resources\TreeView.cs')" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Prepare.Common\Prepare.Common.csproj" />
	  <ProjectReference Include="..\XmlDocSync\XmlDocSync.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Properties\" />
	</ItemGroup>

</Project>
