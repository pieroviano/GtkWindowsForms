<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">
  <!-- Externs provide access to built-in Visual Studio menus and IDs -->
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands>
    <!-- Command set GUID must match the one in GTKCommand.cs -->
    <GuidSymbol name="guidGTKCommandSet" value="{93334a89-b8cb-4fcb-a75c-64661180b671}">
      <IDSymbol name="cmdidOpenToCreateForm" value="768" />
      <IDSymbol name="cmdidFixFormDesigner" value="816" />
      <IDSymbol name="cmdidLinkToRepository" value="912" />
      <IDSymbol name="cmdidLinkToSite" value="913" />

      <!-- local menu/group ids -->
      <IDSymbol name="idGTKMainMenu" value="0x0100" />
      <IDSymbol name="idGTKMainGroup" value="0x0101" />
    </GuidSymbol>

    <Menus>
      <!-- A single menu that will be placed in multiple parents (Tools and context menus) -->
      <Menu guid="guidGTKCommandSet" id="idGTKMainMenu" type="Menu">
        <!-- Place under Tools menu -->
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
        <!-- Also place into Project and Item context menus (right-click) -->
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_PROJECT" />
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ITEMNODE" />
        <Strings>
          <ButtonText>Net4xGtk Windows Forms</ButtonText>
          <CommandName>GtkWinFormsMenu</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <!-- Group contained in our menu where the four commands will sit -->
      <Group guid="guidGTKCommandSet" id="idGTKMainGroup" priority="0x0100">
        <Parent guid="guidGTKCommandSet" id="idGTKMainMenu" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidGTKCommandSet" id="cmdidOpenToCreateForm" priority="0x0100" type="Button">
        <Parent guid="guidGTKCommandSet" id="idGTKMainGroup" />
        <Strings>
          <ButtonText>New Items (Open Add New Item)</ButtonText>
          <CommandName>OpenToCreateForm</CommandName>
        </Strings>
      </Button>

      <Button guid="guidGTKCommandSet" id="cmdidFixFormDesigner" priority="0x0200" type="Button">
        <Parent guid="guidGTKCommandSet" id="idGTKMainGroup" />
        <Strings>
          <ButtonText>Fix Form Designer</ButtonText>
          <CommandName>FixFormDesignerConfig</CommandName>
        </Strings>
      </Button>

      <Button guid="guidGTKCommandSet" id="cmdidLinkToRepository" priority="0x0300" type="Button">
        <Parent guid="guidGTKCommandSet" id="idGTKMainGroup" />
        <Strings>
          <ButtonText>Open Repository</ButtonText>
          <CommandName>LinkToGitee</CommandName>
        </Strings>
      </Button>

      <Button guid="guidGTKCommandSet" id="cmdidLinkToSite" priority="0x0400" type="Button">
        <Parent guid="guidGTKCommandSet" id="idGTKMainGroup" />
        <Strings>
          <ButtonText>Open Project Website</ButtonText>
          <CommandName>LinkToGTKAPP</CommandName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <!-- localized strings can go here if needed -->
  <Strings />
</CommandTable>