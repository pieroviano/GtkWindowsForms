<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>false</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\GtkForms.snk</AssemblyOriginatorKeyFile>
    <NoWarn>$(NoWarn);CS8002;CS0067;CS0169;CS0419;CS0436;CS0162;CS0168;CS0414;CS0612;CS0618;CS0649;CS1574;CS3021;CS8002;CS8625;NETSDK1106;NETSDK1137;IDE0161;NU1603</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="FormWeb.cs" />
    <Compile Remove="FormWeb.Designer.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="FormWeb.resx" />
  </ItemGroup>
  <ItemGroup>
    <!-- Version stays centrally pinned (fork state); upstream hardcodes it. -->
    <PackageReference Include="GtkSharp4" Version="$(GtkSharp4LatestVersion).*" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="**\*.resx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Resources\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Gtk.Windows.Forms\Content\System.ComponentModel.cs" Link="System.ComponentModel.cs" />
    <Compile Include="..\Gtk.Windows.Forms\Content\System.Resources.ResourceManager.cs" Link="System.Resources.ResourceManager.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gtk.Windows.Forms\Gtk.Windows.Forms.csproj" />
    <ProjectReference Include="..\Gtk.Resources.Extensions\Gtk.Resources.Extensions.csproj" />
    <!-- Build-order only: the PrepareBuild target below execs ResxProcessor.exe, so ResxProcessor
         must build first. Not referenced at runtime (ReferenceOutputAssembly/Private false). -->
    <ProjectReference Include="..\ResxProcessor\ResxProcessor.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <!-- Run after ResolveProjectReferences, which builds the ResxProcessor ProjectReference above.
       The original BeforeBuild hook fired before that reference was built, so a parallel solution
       build had not produced ResxProcessor yet and the no-build 'dotnet run' found no apphost (the
       CI-only MSB3073). Keep 'dotnet run', which launches the ResxProcessor apphost: invoking the DLL
       as 'dotnet <dll>' names the process 'dotnet', and ResxProcessor's own instance guard then waits
       on every older dotnet process (including this build's MSBuild nodes) and deadlocks. -->
  <Target Name="PrepareBuild" AfterTargets="ResolveProjectReferences" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet run --no-build --project &quot;$(MSBuildThisFileDirectory)../ResxProcessor/ResxProcessor.csproj&quot; &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>
  <ItemGroup>
    <Compile Update="Properties\GtkWinFormsAppResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>GtkWinFormsAppResources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\GtkWinFormsAppResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>GtkWinFormsAppResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\GtkWinFormsAppResources.zh-Hans.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <DependentUpon>GtkWinFormsAppResources.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\TestData1.en.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\TestData1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>