<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Signed with the same key as the sample so its InternalsVisibleTo(PublicKey=...) grant matches. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\GtkForms.snk</AssemblyOriginatorKeyFile>
    <RootNamespace>GtkWinFormsApp.UITests</RootNamespace>
    <!-- CS0436: sample/library both ship some System.* shims; CS8002: referenced assemblies not all signed. -->
    <NoWarn>$(NoWarn);CS8002;CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.6" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Drives the real sample forms end-to-end. net10 test consumes the net8 sample assembly. -->
    <ProjectReference Include="..\GtkWinFormsApp\GtkWinFormsApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The sample loads images/theme by RELATIVE path at runtime; copy them next to the test binaries so the
       forms render the same as when the app runs. -->
  <ItemGroup>
    <Content Include="..\GtkWinFormsApp\theme\**\*" LinkBase="theme">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\GtkWinFormsApp\Resources\**\*" LinkBase="Resources">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
