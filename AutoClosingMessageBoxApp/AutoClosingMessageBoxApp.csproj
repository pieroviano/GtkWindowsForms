<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>false</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<NoWarn>$(NoWarn);CS0067;CS0169;CS0419;CS0436;NU1603</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Gtk.Windows.Extensions\Gtk.Windows.Extensions.csproj" />
		<ProjectReference Include="..\Gtk.Windows.Forms\Gtk.Windows.Forms.csproj" />
		<ProjectReference Include="..\Gtk.Resources.Extensions\Gtk.Resources.Extensions.csproj" />
		<!-- Build-order only: the PrepareBuild target below execs the ResxProcessor tool, so ResxProcessor
		     must build first. Not referenced at runtime (ReferenceOutputAssembly/Private false). -->
		<ProjectReference Include="..\ResxProcessor\ResxProcessor.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
	</ItemGroup>
	<!-- Run after ResolveProjectReferences, which builds the ResxProcessor ProjectReference above.
	     The original BeforeBuild hook fired before that reference was built, so a parallel solution
	     build had not produced ResxProcessor yet and the no-build 'dotnet run' found no apphost (the
	     CI-only MSB3073). Keep 'dotnet run', which launches the ResxProcessor apphost: invoking the DLL
	     as 'dotnet <dll>' names the process 'dotnet', and ResxProcessor's own instance guard then waits
	     on every older dotnet process (including this build's MSBuild nodes) and deadlocks. -->
	<Target Name="PrepareBuild" AfterTargets="ResolveProjectReferences" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
		<Exec Command="dotnet run --no-build --project &quot;$(MSBuildThisFileDirectory)../ResxProcessor/ResxProcessor.csproj&quot; &quot;$(MSBuildProjectDirectory)&quot;" />
	</Target>

</Project>