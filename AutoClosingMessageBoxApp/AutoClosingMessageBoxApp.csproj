<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>false</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<NoWarn>$(NoWarn);CS0067;CS0169;CS0419;CS0436;NU1603</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Gtk.Windows.Extensions\Gtk.Windows.Extensions.csproj" />
		<ProjectReference Include="..\Gtk.Windows.Forms\Gtk.Windows.Forms.csproj" />
		<ProjectReference Include="..\Gtk.Resources.Extensions\Gtk.Resources.Extensions.csproj" />
		<!-- Build-order only: the PrepareBuild target below execs the ResxProcessor tool, so ResxProcessor
		     must build first. Not referenced at runtime (ReferenceOutputAssembly/Private false). -->
		<ProjectReference Include="..\ResxProcessor\ResxProcessor.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
	</ItemGroup>
	<!-- Run after ResolveProjectReferences, which builds the ResxProcessor ProjectReference above.
	     BeforeBuild fired too early, before that reference was built, so a parallel solution build had
	     not produced ResxProcessor yet and 'dotnet run' crashed on the missing apphost. Invoke the
	     framework-dependent DLL through the shared 'dotnet' host - not 'dotnet run', which needs the
	     per-RID apphost (ResxProcessor.exe on Windows, no extension elsewhere). Skip design-time builds. -->
	<Target Name="PrepareBuild" AfterTargets="ResolveProjectReferences" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
		<Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)../ResxProcessor/bin/$(Configuration)/net8.0/ResxProcessor.dll&quot; &quot;$(MSBuildProjectDirectory)&quot;" />
	</Target>

</Project>